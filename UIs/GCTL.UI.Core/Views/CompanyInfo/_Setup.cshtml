@model GCTL.Core.ViewModels.CompanyInfo.CompanyInfoSetupViewModel

<div style="padding-top: 10px;">
    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>
    <div class="form-group row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" id="lastCode" />
        <input type="hidden" asp-for="Tc" />
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Ldate" />
        <input type="hidden" asp-for="ModifyDate" />
        <div class="col-lg-6">
            <label asp-for="CompanyId">Company ID </label>
            <div class="input-group input-group-sm">
                <input asp-for="CompanyId" type="text" class="form-control form-control-sm js-CompanyId-code" readonly="readonly" />
            </div>
        </div>
        <div class="col-lg-6">
            <label asp-for="CompanyForId">Company For<span style="color:red">*</span></label>
            <div class="input-group">
                <select asp-for="CompanyForId" class="form-control form-control-sm selectpickersCom js-Type" tabindex="1" data-placeholder="-- Select Company For --" asp-items="@ViewBag.CompanyForDD as SelectList">
                    <option></option>
                </select>
            </div>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="CompanyName">Company Name<span style="color:red">*</span> </label>
            <input type="text" asp-for="CompanyName" class="form-control form-control-sm js-CompanyName-check-duplicateName" autofocus required placeholder="Enter Company Name" tabindex="2" />
        </div>
        <div class="col-lg-6">
            <label asp-for="ShortName">Short Name</label>
            <input type="text" asp-for="ShortName" class="form-control form-control-sm" placeholder="Enter Short Name" tabindex="3" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-12">
            <label asp-for="CompanyAddress"> Address<span style="color:red">*</span></label>
            <textarea asp-for="CompanyAddress" class="form-control form-control-sm" rows="1" placeholder="Enter Address" tabindex="4"></textarea>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-12">
            <label asp-for="LocalOfficeAddress"> Local Office Address</label>
            <textarea asp-for="LocalOfficeAddress" class="form-control form-control-sm" rows="1" placeholder="Enter Local Office Address" tabindex="5"></textarea>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="ZipCode">Zip/Postal Code</label>
            <input type="text" asp-for="ZipCode" class="form-control form-control-sm" placeholder="Enter Zip/Postal Code" tabindex="6" />
        </div>
        <div class="col-lg-6">
            <label asp-for="City">City</label>
            <input type="text" asp-for="City" class="form-control form-control-sm" placeholder="Enter City" tabindex="7" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="State">State</label>
            <input type="text" asp-for="State" class="form-control form-control-sm" placeholder="Enter State" tabindex="8" />
        </div>
        <div class="col-lg-6">
            <label asp-for="CountryId">Country</label>
            <div class="input-group">
                <select asp-for="CountryId" class="form-control form-control-sm selectpickersCom js-Type" tabindex="9" data-placeholder="-- Select Country --" asp-items="@ViewBag.CountryDD as SelectList">
                    <option></option>
                </select>
            </div>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="Phone">Phone</label>
            <input type="text" asp-for="Phone" class="form-control form-control-sm" placeholder="Enter Phone" tabindex="10" />
        </div>
        <div class="col-lg-6">
            <label asp-for="Fax">Fax</label>
            <input type="text" asp-for="Fax" class="form-control form-control-sm" placeholder="Enter Fax" tabindex="11" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="Email">Email</label>
            <input type="text" asp-for="Email" class="form-control form-control-sm" placeholder="Enter Email" tabindex="12" />
        </div>
        <div class="col-lg-6">
            <label asp-for="Url">Url</label>
            <input type="text" asp-for="Url" class="form-control form-control-sm" placeholder="Enter Url" tabindex="13" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-12">
            <label asp-for="Remarks"> Remarks</label>
            <textarea asp-for="Remarks" class="form-control form-control-sm" rows="1" placeholder="Enter Remarks" tabindex="14"></textarea>
        </div>
    </div>

    @if (Model.Tc > 0)
    {

        <hr />
        <div class="form-group row" id="LdateModifyHide">
            <div class="col-lg-6">
                @if (Model.Ldate.HasValue)
                {
                    <label>Creation Date: </label>

                    <label>@Model.Ldate?.ToString("dd/MM/yyyy")</label>
                }
            </div>
            <div class="col-lg-6">
                @if (Model.ModifyDate.HasValue)
                {
                    <label>Last Update Date: </label>

                    <label>@Model.ModifyDate?.ToString("dd/MM/yyyy")</label>
                }
            </div>
        </div>

    }

</div>
<div class="row no-print" style="margin-top: 9px;">
    <div class="col-12">
        <button type="button" class="btn btn-default success-btn btn btn-outline-success btn-common btn-circle float-right js-PaymentTerms-save" data-id="@Model.CompanyId">
            <i class="fas fa-save"></i> Save
        </button>
    </div>
</div>