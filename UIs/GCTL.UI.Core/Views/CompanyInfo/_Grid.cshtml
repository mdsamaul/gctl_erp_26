@model List<GCTL.Core.ViewModels.CompanyInfo.CompanyInfoSetupViewModel>

<table id="CompanyInfo-grid" class="table table-striped  table-bordered table-sm table-hover table-common">
    <thead class="row-border">
        <tr class="table row-border">
            <th class="text-center text-middle" style="width: 6%;">
                Select <br /> <input type="checkbox" id="CompanyInfo-check-all" />
            </th>
            <th class="text-center text-middle" style="width: 7%;">ID</th>
            <th class="text-center text-middle" style="width: 20%;"> Company Name</th>
            <th class="text-center text-middle" style="width: 12%;"> Short Name</th>
            <th class="text-center text-middle" style="width: 40%;"> Address</th>
            <th class="text-center text-middle" style="width: 15%;"> Company For</th>

        </tr>
    </thead>
    <tbody>

        @if (Model == null || !Model.Any())
        {
            <tr class="text-center text-middle">
                <td colspan="8">No Data Available.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model.OrderByDescending(x => x.Tc))
            {
                <tr>
                    <td class="text-center">
                        <input type="checkbox" class="text-center text-middle checkBox" data-id="@item.Tc" value="@item.CompanyId" />
                    </td>
                    <td>
                        <a href="#" class='btn js-CompanyInfo-edit'
                           style="text-decoration: underline; color: rebeccapurple;"
                           data-id="@item.Tc" title="Edit">
                            @item.CompanyId
                        </a>
                    </td>

                    <td class="text-center text-middle">@item.CompanyName</td>
                    <td class="text-center text-middle">@item.ShortName</td>
                    <td class="text-center text-middle">@item.CompanyAddress</td>
                    <td class="text-center text-middle">@item.CompanyForName</td>

                </tr>
            }
        }

    </tbody>
</table>