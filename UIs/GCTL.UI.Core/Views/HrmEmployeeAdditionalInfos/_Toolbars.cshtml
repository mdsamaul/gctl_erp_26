
@model ToobarModel
<div class="row">
    <div class="col-md-10">
        <h6 class="page-title">@Model.Title</h6>
    </div>
    <div class="col-md-2 d-flex justify-content-end">
        <div class="btn-group" role="group" aria-label="Toolbar Actions">
            <button type="button" class="btn btn-default btn-common js-HrmEmployeeAdditionalInfos-save btn-circle" data-toggle="tooltip" data-placement="bottom" title="Save">
                <i class="fas fa-save"></i> Save
            </button>
            <button type="button" class="btn btn-default primary-btn js-HrmEmployeeAdditionalInfos-clear btn-circle btn-sm" data-toggle="tooltip" data-placement="bottom" title="Clear">
                <i class="fas fa-sync"></i> Clear
            </button>
        </div>
    </div>
</div>
