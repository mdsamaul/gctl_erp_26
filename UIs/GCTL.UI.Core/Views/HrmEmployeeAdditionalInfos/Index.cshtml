@model GCTL.UI.Core.ViewModels.HrmEmployeeAdditionalInfos.HrmEmployeeAdditionalInfoPageViewModel
@{
    ViewBag.Title = "Additional Info Entry";
    Model.PageTitle = ViewBag.Title;
    Model.Breadcrumb = "Additional Info Entry";
}

<style>
    .dataTables_filter {
        margin-right: 0px;
    }
</style>

<!-- Content Header (Page header) -->
<section class="content-header" style="padding-bottom: 0;">
    <div class="container-fluid">
        <div class="calloutx callout-info" style="height: 35px;">
            <div class="row mb-2">
                <div class="col-md-8 row">
                    <ol class="breadcrumb float-sm-right">
                        <li class=""><a href="@Url.Action("Setup", "HrmEmployeeAdditionalInfos")" class="linkbutton1 btn btn-sm btn-success" style="font-size:13px; text-decoration: none;"> <i class="fa fa-plus"></i> Create</a></li>
                    </ol>
                </div>
                <div class="col-md-4">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Dashboard">Home</a></li>
                        @* <li class="breadcrumb-item active">Additional Employee Info</li> *@
                        <li class="breadcrumb-item"><a href="/HrmEmployeeAdditionalInfos/Setup">Additional Employee Info</a></li>
                    </ol>
                </div>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header border-transparent">
                        <h3 class="card-title">@ViewBag.Title</h3>
                    </div>
                    <!-- /.card-header -->
                    <div class="card-body p-2 pt-3">

                        <div class="js-HrmEmployeeAdditionalInfos-grid-container">

                            @await Html.PartialAsync("_Grid", Model.TableList)

                        </div>

                    </div>
                </div>
            </div>
        </div>
        <partial name="_BottomNavigation" />
    </div>
</section>
<partial name="DeleteModal" />


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/pages/hrmEmployeeAdditionalInfos.js"></script>
    <script type="text/javascript">
        var options = {
            baseUrl: '@Url.Action("", "HrmEmployeeAdditionalInfos")'
        };
        options.load = () => 
        {
        };

        $.hrmEmployeeAdditionalInfos(options);
    </script>
}




