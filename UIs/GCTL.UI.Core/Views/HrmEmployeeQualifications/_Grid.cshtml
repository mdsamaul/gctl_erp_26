@model List<GCTL.Core.ViewModels.HrmEmployeeQualifications.HrmEmployeeQualificationsSetupViewModel>

<div class="card">
    <div class="card-body">
        <table id="HrmEmployeeQualifications-gridTT" class="table table-striped  table-bordered table-sm table-hover table-common">

            <thead class="row-border">
                <tr class="table row-border">
                    <th class="text-center text-middle" style="width:5%">
                        Select <br /> <input type="checkbox" id="HrmEmployeeQualifications-check-all" />
                    </th>
                    <th class="text-center text-middle" style="width:6%"> Id</th>
                    <th class="text-center text-middle" style="width:16%">Course Type</th>
                    <th class="text-center text-middle" style="width:17%">Course Tittle</th>
                    <th class="text-center text-middle" style="width:18%">Institute</th>
                    <th class="text-center text-middle" style="width:18%">Address</th>
                    <th class="text-center text-middle" style="width:4%">Result</th>
                    <th class="text-center text-middle" style="width:6%">Passing Year</th>
                    <th class="text-center text-middle" style="width:4%">Duration</th>
                    <th class="text-center text-middle" style="width:5%">Type</th>
                </tr>
            </thead>
            <tbody>

                @if (Model == null || !Model.Any())
                {
                    <tr class="text-center text-middle">
                        <td colspan="13">No Data Available.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.OrderByDescending(x => x.EmpQualificationId))
                    {
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" class="text-center text-middle checkBox"  data-id="@item.EmpQualificationId" value="@item.EmpQualificationId" />
                            </td>
                            <td>
                                <a href="#" class='btn js-HrmEmployeeQualifications-edit'
                                   style="text-decoration: underline; color: rebeccapurple;"
                                   data-id="@item.EmpQualificationId" data-id2="@item.EmployeeId" title="Edit">
                                    @item.EmpQualificationId
                                </a>
                            </td>
                            <td class="text-center text-middle">@item.CourseCode</td>
                            <td class="text-center text-middle">@item.CourseTittleName</td>
                            <td class="text-center text-middle">@item.InstituteName</td>
                            <td class="text-center text-middle">@item.Instituteaddress</td>
                            <td class="text-center text-middle">@item.ResultDivision</td>
                            <td class="text-center text-middle">@item.YearofPasssing</td>
                            <td class="text-center text-middle">@item.Dueration</td>
                            <td class="text-center text-middle">@item.DuratioinType</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>