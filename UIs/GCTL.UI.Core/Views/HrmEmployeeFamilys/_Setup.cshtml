@using GCTL.Core.ViewModels.HrmEmployeeFamilys

@model GCTL.Core.ViewModels.HrmEmployeeFamilys.HrmEmployeeFamilysSetViewModel
@{

    var list = ViewData["List"] as List<HrmEmployeeFamilysSetViewModel>;

}


<div id="customLoadingOverlay" style="
        display: flex;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 9999;
        justify-content: center;
        align-items: center;">
    <div style="
            background-color: white;
            padding: 20px;
            border-radius: 5px;
            box-shadow: 0 0 10px rgba(0,0,0,0.3);
            text-align: center;">
        <div class="spinner-border text-primary" role="status">
            <span class="sr-only"></span>
        </div>
        <p style="margin-top: 10px; margin-bottom: 0;"></p>
    </div>
</div>

<div style="padding-top:1px;">

    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>

    <div style="padding-top: 1px;">
        <div class="row">
            <div class="col-lg-12">

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Ldate" />
                <input type="hidden" asp-for="ModifyDate" />
                <input type="hidden" asp-for="AutoId" />
                <input asp-for="EmpFamilyId" type="hidden" />

                <div class="card">
                    <div class="card-body">
                        <div class="row">

                            <div class="col-lg-6">
                                <div class="form-group d-flex align-items-center justify-content-between">
                                    <label class="d-flex justify-content-end form-label col-form-label-sm required" asp-for="CompanyCode">Comapny</label>
                                    <div class="input-wrapper">
                                        <select asp-for="CompanyCode" tabindex="1" data-placeholder="Select Company" required class="form-control form-control-sm selectpickerEmpFamily js-" asp-items="@ViewBag.CoreCompanyDD as SelectList">
                                            <option value=""></option>
                                        </select>

                                    </div>
                                </div>

                            </div>


                        </div>
                        <div class="row">
                            <div class="col-6">
                                <div class="form-group d-flex align-items-center justify-content-between">
                                    <label class="d-flex justify-content-end form-label col-form-label-sm required" asp-for="EmployeeId">Employee Id </label>
                                    <div class="input-wrapper">
                                        <select asp-for="EmployeeId" tabindex="2" data-placeholder="Select Employee" required class="form-control form-control-sm selectpickerEmpFamily" asp-items="@ViewBag.EmployeeDD as SelectList">
                                            <option value=""></option>
                                        </select>

                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-group d-flex align-items-center justify-content-between">
                                    <label class="d-flex justify-content-end form-label col-form-label-sm" asp-for="EmployeeName">Employee Name:</label>
                                    <div class="input-wrapper">
                                        <span id="FullName" style="text-align: left; display: block;">@Model.EmployeeName</span>

                                    </div>
                                </div>
                            </div>


                        </div>
                        <div class="row">
                            <div class="col-6">
                                <div class="form-group d-flex align-items-center justify-content-between">
                                    <label class="d-flex justify-content-end form-label col-form-label-sm" asp-for="DesignationName">Designation:</label>
                                    <div class="input-wrapper">

                                        <span id="DesignationName" style="text-align: left; display: block;">@Model.DesignationName</span> <!-- Right aligned -->
                                    </div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="form-group d-flex align-items-center justify-content-between">
                                    <label class="d-flex justify-content-end form-label col-form-label-sm" asp-for="DepartmentName">Department:</label>
                                    <div class="input-wrapper">
                                        <span id="DepartmentName" style="text-align: left; display: block;">@Model.DepartmentName</span>
                                    </div>
                                </div>
                            </div>


                        </div>
                    </div>
                </div>
                <div style="display:none">Table List</div>
                <div class="js-HrmEmployeeFamilys-grid-container">
                    @*  <partial name="_Grid" /> *@
                    @await Html.PartialAsync("_Grid", list)
                </div>



                <div class="card">
                    <div class="card-body">
                        <div class="row">

                            <div class="col-lg-4 ">
                                <label asp-for="Name" class="required">Name</label>
                                <div class="input-group">
                                    <input asp-for="Name" required class="form-control form-control-sm" placeholder="Enter Name"  tabindex="3"/>
                                </div>
                            </div>
                            <div class="col-lg-4">
                                <label asp-for="RelationshipId" class="required">Relationship</label>
                                <div class="input-group">
                                    <select asp-for="RelationshipId" tabindex="4" data-placeholder="Select Relationship" class="form-control form-control-sm selectpickerEmpFamily" asp-items="@ViewBag.ShipDD as SelectList">
                                        <option value=""></option>
                                    </select>
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-sm btn-default js-quick-add input-group-textc"
                                                data-url="@Url.Action("Index", "Relationships")"
                                                data-target="#RelationshipId"
                                                data-reload-url="@Url.Action("GetRelationship", "Cascading")"
                                                data-title="Relationship">
                                            +
                                        </button>
                                    </div>
                                </div>
                            </div>


                            <div class="col-lg-4">
                                <label asp-for="OccupationId" class="required">Occupation</label>
                                <div class="input-group">
                                    <select asp-for="OccupationId" tabindex="5" data-placeholder="Select  Occupation" class="form-control form-control-sm selectpickerEmpFamily required" asp-items="@ViewBag.OccupationDD as SelectList">
                                        <option value=""></option>
                                    </select>
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-sm btn-default js-quick-add input-group-textc"
                                                data-url="@Url.Action("Index", "HrmDefOccupations")"
                                                data-target="#OccupationId"
                                                data-reload-url="@Url.Action("GetOccupation", "Cascading")"
                                                data-title="Occupation">
                                            +
                                        </button>
                                    </div>
                                </div>
                            </div>


                        </div>


                        <div class="row">
                            <div class="col-lg-4 ">
                                <label asp-for="AddressDetails">Address</label>
                                <input asp-for="AddressDetails" class="form-control form-control-sm " placeholder="Enter Address" tabindex="6" />
                            </div>
                            <div class="col-lg-4">
                                <label asp-for="Phone">Phone</label>
                                <input asp-for="Phone" class="form-control form-control-sm " placeholder="Enter Phone No" tabindex="7" />
                            </div>
                            <div class="col-lg-4">
                                <label asp-for="Email">Email</label>
                                <input asp-for="Email" class="form-control form-control-sm" placeholder="Enter E-Mail" tabindex="8" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-4">
                                <label asp-for="DateOfBirth">Date Of Birth</label>
                                <input asp-for="DateOfBirth" type="text" tabindex="9" class="form-control form-control-sm employeeFamilyDatepicker" placeholder="Enter Birth Date" />
                            </div>

                            <div class="col-lg-4">
                                <label asp-for="BloodGroupId">Blood Group</label>
                                <select asp-for="BloodGroupId" tabindex="10" class="form-control form-control-sm selectpickerEmpFamily" asp-items="@ViewBag.BloodGroupDD as SelectList">
                                    <option value="">Select Blood Group</option>

                                </select>
                            </div>

                        </div>

                        @if (Model.AutoId > 0)
                        {
                            <hr />
                            <div class="form-group row" id="LdateModifyHide">


                                <div class="col-6">
                                    <div class="form-group d-flex align-items-center justify-content-between">
                                        @if (Model.Ldate.HasValue)
                                        {
                                            <label class="d-flex justify-content-end form-label col-form-label-sm" asp-for="Ldate">Creation Date:</label>
                                            <div class="input-wrapper">
                                                <span style="text-align: left; display: block;">@Model.Ldate?.ToString("dd/MM/yyyy hh:mm tt")</span>
                                            </div>
                                        }

                                    </div>
                                </div>


                                <div class="col-6">
                                    <div class="form-group d-flex align-items-center justify-content-between">
                                        @if (Model.ModifyDate.HasValue)
                                        {
                                            <label class="d-flex justify-content-end form-label col-form-label-sm" asp-for="ModifyDate">Last Update Date:</label>
                                            <div class="input-wrapper">
                                                <span style="text-align: left; display: block;">@Model.ModifyDate?.ToString("dd/MM/yyyy hh:mm tt")</span>
                                            </div>
                                        }

                                    </div>
                                </div>


                            </div>
                        }



                        <div class="row no-print" style="margin-top: 9px;">

                            <div class="col-12">
                                @*  <a href='@Url.Action("Index")' class="btn btn-default btn-common btn-circle"><i class="fas fa-arrow-alt-circle-left">&nbsp;</i>Back To List</a> *@
                                <button type="button" class="btn btn-default success-btn btn btn-outline-success btn-common btn-circle float-right js-HrmEmployeeFamilys-save" data-id="@Model.EmpFamilyId">
                                    <i class="fas fa-save"></i> Save
                                </button>
                            </div>

                        </div>

                    </div>
                </div>


            </div>

        </div>
    </div>
    <partial name="_BottomNavigation" />
</div>



<style>

    .required::after {
        content: '*';
        color: red;
        margin-left: 5px;
    }



    .form-group label {
        margin-right: .5rem;
        min-width: 150px;
    }

    .form-group input {
        flex: 1;
        max-width: 100%;
    }

    .input-wrapper {
        position: relative;
        width: 100%;
    }

        .input-wrapper span {
            width: 100%;
        }

</style>
