    /* 1. Create a reusable class for 5 equal columns */
    .col-5-equal {
        flex: 0 0 20%;
        max-width: 20%;
        padding-right: 15px;
        padding-left: 15px;
        position: relative;
        width: 100%;
    }

    /* 2. Style the container for each label/input pair */
    .form-field-pair {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

        .form-field-pair label {
            margin-bottom: 0.25rem;
            font-weight: 500;
        }

    /* 3. Media query for screens 1300px and up */
    @@media (min-width: 1600px) {
        .form-field-pair {
            flex-direction: row;
            align-items: center;
        }

            .form-field-pair label {
                /* Give the label a fixed width and prevent it from shrinking */
                flex: 0 0 120px;
                text-align: right;
                padding-right: 10px;
                margin-bottom: 0;
                white-space: nowrap;
            }

            .form-field-pair .form-field-input {
                /* The select input takes up the remaining space */
                flex: 1;
            }
    }

