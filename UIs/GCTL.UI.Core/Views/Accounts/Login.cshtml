@model GCTL.UI.Core.ViewModels.LoginPageViewModel

@{
    ViewData["Title"] = "Login Page";
    Layout = null;
}

<!doctype html>
<html lang="en">
<head>
    <link rel="shortcut icon" href="~/images/CoIcon.ico" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>HRM &amp; Payroll Management System - Login</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;
        }

        body{
            height:100vh;
            background:#f4f7fb;
            display:flex;
            justify-content:center;
            align-items:center;
            overflow:hidden;
        }

        .container{
            width:60vw;
            height:70vh;
            background:#fff;
            border-radius:12px;
            overflow:hidden;
            display:flex;
            box-shadow:0 20px 50px rgba(0,0,0,.35);
        }

        .left-panel{
            width:58%;
            position:relative;
            /* background:linear-gradient(rgba(11,52,112,.82),rgba(20,87,190,.82)), url('https://images.unsplash.com/photo-1521737604893-d14cc237f11d?auto=format&fit=crop&w=800&q=60') center center; */
            background: linear-gradient(rgba(11,52,112,.82),rgba(20,87,190,.82)), url('/images/lbg.jpg') center center;
            background-size:contain;
            background-repeat:no-repeat;
        }

        .overlay{
            position:absolute;
            top:0;
            left:0;
            width:100%;
            height:100%;
            padding:60px;
            color:white;
            display:flex;
            flex-direction:column;
            justify-content:center;
        }

        .logo{
            font-size:36px;
            font-weight:700;
            margin-bottom:20px;
        }

        .logo i{
            color:#38bdf8;
            margin-right:10px;
        }

        .hero-title{
            font-size:28px;
            font-weight:700;
            line-height:1.3;
            margin-bottom:20px;
        }

        .hero-title span{
            color:#38bdf8;
        }

        .hero-text{
            font-size:14px;
            line-height:1.8;
            opacity:.95;
            margin-bottom:30px;
        }

        .features{
            display:grid;
            grid-template-columns:1fr 1fr;
            gap:20px;
        }

        .feature{
            display:flex;
            align-items:center;
            gap:15px;
            font-size:15px;
        }

        .feature i{
            width:45px;
            height:45px;
            background:#38bdf8;
            border-radius:50%;
            display:flex;
            align-items:center;
            justify-content:center;
            font-size:18px;
        }

        .right-panel{
            position:relative;
            width:42%;
            background:white;
            display:flex;
            justify-content:center;
            align-items:center;
            padding:40px;
        }

        .login-box{
            width:100%;
            max-width:90%;
        }

        .login-header{
            text-align:left;
            margin-bottom:35px;
        }

        .login-header h2{
            font-size:32px;
            color:#0f172a;
            margin-bottom:10px;
        }

        .login-header p{
            color:#64748b;
        }

        .input-group{
            margin-bottom:20px;
            position:relative;
        }

        .input-group i{
            position:absolute;
            left:15px;
            top:16px;
            color:#64748b;
        }

        .input-group input{
            width:100%;
            padding:14px 15px 14px 45px;
            border:1px solid #dbe4ee;
            border-radius:10px;
            font-size:15px;
            outline:none;
            transition:.3s;
        }

        .input-group input:focus{
            border-color:#0ea5e9;
            box-shadow:0 0 10px rgba(14,165,233,.2);
        }

        .field-validation-error {
            color:#d9534f;
            font-size:0.9rem;
            margin-top:6px;
        }

        .validation-summary-errors {
            color:#d9534f;
            margin-bottom:12px;
        }

        .options{
            display:flex;
            justify-content:space-between;
            align-items:center;
            margin-bottom:25px;
            font-size:14px;
        }

        .options a{
            text-decoration:none;
            color:#0284c7;
            font-weight:600;
        }

        .login-btn{
            width:100%;
            padding:15px;
            background:linear-gradient(135deg,#0284c7,#0ea5e9);
            border:none;
            color:white;
            font-size:16px;
            font-weight:600;
            border-radius:10px;
            cursor:pointer;
            transition:.3s;
        }

        .login-btn:hover{
            transform:translateY(-2px);
            box-shadow:0 10px 20px rgba(14,165,233,.3);
        }

        .footer-text{
            text-align:center;
            margin-top:25px;
            font-size:13px;
            color:#64748b;
        }

        .version{
            margin-top:20px;
            text-align:center;
            font-size:12px;
            color:#94a3b8;
        }

        @@media(max-width:992px){
            .container{
                width:95%;
                height:auto;
                flex-direction:column;
            }

            .left-panel,
            .right-panel{
                width:100%;
            }

            .left-panel{
                height:450px;
            }

            .hero-title{
                font-size:30px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="left-panel">
            <div class="overlay">
                <div class="logo">                   
                    <img src="/images/GCTL_Infosys_t.png" alt="GCTL Infosys" height="80" style="object-fit:cover;display:inline-block;vertical-align:middle;margin-bottom:8px;" />
                    @* <img src="/images/GCTL_Infosys_lg.png" alt="GCTL Infosys" height="80" style="object-fit:cover;display:inline-block;vertical-align:middle;margin-bottom:8px;" /> *@
                </div>

                <div class="hero-title">
                    ERP Based HRM &amp; Finance Solution for Modern Businesses.
                </div>

                <div class="hero-text">
                    Manage employee attendance from biometric devices, mobile apps,
                    GPS attendance tracking, shift scheduling, leave management,
                    salary processing, tax calculation, payroll workflow approval,
                    employee self-service and management reporting from a single platform.
                </div>

                <div class="features">
                    <div class="feature">
                        <i class="fas fa-fingerprint"></i>
                        <div>
                            <b>Attendance Device</b><br />
                            Biometric Integration
                        </div>
                    </div>

                    <div class="feature">
                        <i class="fas fa-mobile-screen"></i>
                        <div>
                            <b>Mobile Attendance</b><br />
                            GPS &amp; Self Service App
                        </div>
                    </div>

                    <div class="feature">
                        <i class="fas fa-file-invoice-dollar"></i>
                        <div>
                            <b>Payroll Workflow</b><br />
                            Salary &amp; Tax Automation
                        </div>
                    </div>

                    <div class="feature">
                        <i class="fas fa-laptop"></i>
                        <div>
                            <b>Management Dashboard</b><br />
                            Real-Time Analytics
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="right-panel">
            <img src="~/images/dp_logo.png"
                 style="position:absolute; top:10px; right:15px; height:50px; object-fit:fill;" />

            <div class="login-box">
                <div class="login-header">
                    <div class="logo">
                        <i class="fas fa-users-cog"></i> 
                    </div>
                    <h2>Welcome Back</h2>
                    <p>Sign in to access your HRM &amp; Payroll System</p>
                </div>

                <form asp-action="Login" asp-controller="Accounts" method="post">
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

                    <div class="input-group">
                        <i class="fas fa-user"></i>
                        @Html.TextBoxFor(m => m.Username, new { @class = "form-control", placeholder = "Username", @id = "txtusername", autocomplete = "username" })
                        @Html.ValidationMessageFor(m => m.Username, "", new { @class = "field-validation-error" })
                    </div>

                    <div class="input-group">
                        <i class="fas fa-lock"></i>
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Password", @id = "txtUserPassword", autocomplete = "current-password" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
                    </div>

                    <div class="options">
                        <label>
                            <input type="checkbox" name="RememberMe" /> Remember Me
                        </label>

                        <a href="#">Forgot Password?</a>
                    </div>

                    <button type="submit" class="login-btn">
                        <i class="fas fa-right-to-bracket"></i>&nbsp; Sign In
                    </button>
                </form>

                <div class="footer-text">
                    Attendance • Leave • Payroll • Employee Self-Service
                </div>

                <div class="version">
                    HRM &amp; Payroll Management System Version 2026
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</body>
</html>
