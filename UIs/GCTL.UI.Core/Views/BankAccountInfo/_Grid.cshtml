@model List<GCTL.Core.ViewModels.CoreBankAccountInformations.CoreBankAccountInformationSetupViewModel>
<table id="BankAccountInfo-grid" class="table table-striped  table-bordered table-sm table-hover table-common">

        <thead class="row-border">
            <tr class="table row-border">
            <th class="text-center text-middle" style="width:10%;">
                    Select <br /> <input type="checkbox" id="BankAccountInfo-check-all" />
                </th>
            <th class="text-center text-middle" style="width:10%;">ID</th>
            <th class="text-center text-middle" style="width:16%;">A/C Name</th>
            <th class="text-center text-middle" style="width:20%;"> A/C No</th>
            <th class="text-center text-middlestyle=" width:28%;"">Bank</th>
            <th class="text-center text-middlestyle=" width:16%;"">Branch</th>

            </tr>
        </thead>
        <tbody>

            @if (Model == null || !Model.Any())
            {
                <tr class="text-center text-middle">
                    <td colspan="8">No   Bank Account Information Available.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.OrderByDescending(x => x.AccInfoId))
                {
                    <tr>
                        <td class="text-center">
                            <input type="checkbox" class="text-center text-middle checkBox" data-id="@item.AccInfoId" value="@item.AccInfoId" />
                        </td>
                        <td>
                            <a href="#" class='btn js-BankAccountInfo-edit'
                               style="text-decoration: underline; color: rebeccapurple;"
                               data-id="@item.AccInfoId" title="Edit">
                                @item.AccInfoId
                            </a>
                        </td>
                        <td class="text-center text-middle">@item.AccountName</td>
                        <td class="text-center text-middle">@item.AccountNo</td>
                        <td class="text-center text-middle">@item.BankName</td>
                        <td class="text-center text-middle">@item.BranchName</td>

                    </tr>
                }
            }


        </tbody>
</table>