    if (sel) sel.value = strVal;
    if (!el) return;

    const opts = [...el.querySelectorAll('.ms-single-opt')];
    let activeText = 'Not Applicable';
    opts.forEach(o => {
        const isMatch = String(o.dataset.val || '').trim() === strVal;
        o.classList.toggle('active', isMatch);
        if (isMatch) activeText = o.textContent;
    });

    const textSpan = el.querySelector('.msb .ms-selected-text');
    const rightClear = el.querySelector('.msb .ms-right-clear');
    if (textSpan) {
        textSpan.textContent = activeText;
        textSpan.classList.toggle('ph', !strVal);
    }
    if (rightClear) {
        rightClear.style.display = strVal ? 'inline-block' : 'none';
    }
}

function getNameById(key, id) {
    if (!id) return '';
    const items = ALL_OPT[key] || OPT[key] || [];
    const found = items.find(x => String(x.id).trim() == String(id).trim() || String(x.name).trim() == String(id).trim());
    return found ? found.name : id;
}

function getNamesList(key, arr) {
    if (!arr) return [];
    const list = Array.isArray(arr) ? arr : String(arr).split(',').filter(Boolean);
    return list.map(id => getNameById(key, id)).filter(Boolean);
}

