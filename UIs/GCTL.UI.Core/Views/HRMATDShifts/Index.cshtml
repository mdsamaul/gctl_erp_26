const updateTopFilterCascade = applyTopFilterCascade;

function detailMatchesTopFilter(d) {
    const selCo = (F_MS['fCo'] || []).map(x => String(x).trim()).filter(Boolean);
    const selBr = (F_MS['fBr'] || []).map(x => String(x).trim()).filter(Boolean);
    const selDp = (F_MS['fDp'] || []).map(x => String(x).trim()).filter(Boolean);
    const selEmp = (F_MS['fEmp'] || []).map(x => String(x).trim()).filter(Boolean);

    if (selCo.length > 0) {
        const dCo = (d.company || []).map(x => String(x).trim()).filter(Boolean);
        if (dCo.length === 0 || !dCo.some(c => selCo.includes(c))) return false;
    }
    if (selBr.length > 0) {
        const dBr = (d.branch || []).map(x => String(x).trim()).filter(Boolean);
        if (dBr.length === 0 || !dBr.some(b => selBr.includes(b))) return false;
    }
    if (selDp.length > 0) {
        const dDp = (d.dept || []).map(x => String(x).trim()).filter(Boolean);
        if (dDp.length === 0 || !dDp.some(dp => selDp.includes(dp))) return false;
    }
    if (selEmp.length > 0) {
        const dEmp = (d.emp || []).map(x => String(x).trim()).filter(Boolean);
        if (dEmp.length === 0 || !dEmp.some(em => selEmp.includes(em))) return false;
    }
    return true;
}

function hasActiveDetailTopFilter() {
    return (
        (F_MS['fCo'] && F_MS['fCo'].length > 0) ||
        (F_MS['fBr'] && F_MS['fBr'].length > 0) ||
        (F_MS['fDp'] && F_MS['fDp'].length > 0) ||
        (F_MS['fEmp'] && F_MS['fEmp'].length > 0)
    );
}

function getFilteredDetails(s) {
    const allDetails = (Array.isArray(s.details) ? s.details : []).map((d, idx) => ({ ...d, _origIdx: idx }));
    if (!hasActiveDetailTopFilter()) return allDetails;
    return allDetails.filter(d => detailMatchesTopFilter(d));
}

function filtered() {
    const qSearch = ((q('#ls')?.value || '') + ' ' + (q('#gs')?.value || '')).toLowerCase().trim();
    const fTypeVal = (q('#fType')?.value || '').trim();
    const fStVal = (q('#fSt')?.value || '').trim();
    const detailFilterOn = hasActiveDetailTopFilter();

    const list = shifts.filter(s => {
        if (fTypeVal && String(s.typeId).trim() !== fTypeVal && String(s.type).trim() !== fTypeVal) return false;
        if (fStVal && String(s.status).trim() !== fStVal) return false;

        if (detailFilterOn) {
            const matchingDetails = getFilteredDetails(s);
            if (matchingDetails.length === 0) return false;
        }

        if (qSearch) {
            const detailNames = (s.details || []).map(d => [
                ...getNamesList('company', d.company),
                ...getNamesList('branch', d.branch),
                ...getNamesList('dept', d.dept),
                ...getNamesList('emp', d.emp)
            ].join(' ')).join(' ');
            const rowStr = (JSON.stringify(s) + ' ' + detailNames).toLowerCase();
            return qSearch.split(/\s+/).every(w => rowStr.includes(w));
        }
        return true;
    });

    list.sort((a, b) => {
        let va = getSortVal(a, sortCol);
        let vb = getSortVal(b, sortCol);
        if (typeof va === 'string' && typeof vb === 'string') {
            const cmp = va.localeCompare(vb, undefined, { numeric: true, sensitivity: 'base' });
            return sortDir === 'asc' ? cmp : -cmp;
        }
        if (va < vb) return sortDir === 'asc' ? -1 : 1;
        if (va > vb) return sortDir === 'asc' ? 1 : -1;
        return 0;
    });

    return list;
}

function render() {
    const L = filtered();
    const pp = +(q('#pp')?.value || 10);
    const pages = Math.max(1, Math.ceil(L.length / pp));
    page = Math.min(page, pages);
    const rows = L.slice((page - 1) * pp, page * pp);

    const tb = q('#tb');
    if (tb) {
        tb.innerHTML = rows.map(s => {
            const details = getFilteredDetails(s);
            const isExp = expandedShifts.has(String(s.id));
            const typeClass = (s.type || '').toLowerCase().includes('night') ? 'Night' : 'Day';
            const statusClass = (s.status || '') === 'Active' ? 'Active' : 'Inactive';

            const firstTimingText = details.length > 0
                ? `${short(details[0].start)} – ${short(details[0].end)}${details.length > 1 ? ` (+${details.length - 1} more)` : ''}`
                : 'No timing added';

            const masterRowHtml = `
                <tr class="master-row ${isExp ? 'expanded' : ''}">
                    <td>
                        <button type="button" class="btn-expand ${isExp ? 'open' : ''}" onclick="toggleExpand('${s.id}')" title="Click to expand/collapse shift details">
                            <span class="exp-icon">▶</span>
                            <span>${details.length}</span>
                        </button>
                    </td>
                    <td class="id">${s.id}</td>
                    <td><div class="nm">${s.name || ''}</div></td>
                    <td><span class="pill ${typeClass}">${s.type || ''}</span></td>
                    <td>${s.desc || '<span class="sub">—</span>'}</td>
                    <td>
                        <span class="pill sched-cnt" onclick="toggleExpand('${s.id}')" title="Click to view all schedules">
                            🕒 ${details.length} Schedule${details.length === 1 ? '' : 's'}
                        </span>
                        <div class="sub" style="margin-top:2px;">${firstTimingText}</div>
                    </td>
                    <td>${s.rem || '<span class="sub">—</span>'}</td>
                    <td><span class="pill ${statusClass}">${s.status || 'Active'}</span></td>
                    <td class="act">
                        <button type="button" class="ib" onclick="openStandaloneDetailModal('add', '${s.id}')" title="Add new timing to this shift">＋ Add Time</button>
                        <button type="button" class="ib" onclick="openForm('${s.id}')">✎ Edit</button>
                        <button type="button" class="ib d" onclick="del('${s.id}')">🗑 Delete</button>
                    </td>
                </tr>
            `;

            if (!isExp) return masterRowHtml;

            const detailRowsHtml = details.length > 0
                ? details.map((d, dispIdx) => {
                    const origIdx = d._origIdx !== undefined ? d._origIdx : dispIdx;
                    const dStatusClass = (d.status || 'Active') === 'Active' ? 'Active' : 'Inactive';
                    const otText = (!d.otRule || d.otRule === 'Not Applicable' || !d.otRuleId)
                        ? '<span class="sub">Not Applicable</span>'
                        : `<b>${d.otRule}</b><div class="sub">After ${d.otAfter || 60}m | Max ${d.otMax || 4}h | Min ${d.otMin || 50}m</div>`;
                    return `
                        <tr>
                            <td><b>#${dispIdx + 1}</b></td>
                            <td>
                                <b>${short(d.start)} – ${short(d.end)}</b>
                                ${d.cross ? '<span class="pill cm" title="Cross midnight">+1d</span>' : ''}
                            </td>
                            <td>${short(d.late)}</td>
                            <td>${short(d.absent)}</td>
                            <td>${short(d.bf)} – ${short(d.bt)}</td>
                            <td>${short(d.early)}</td>
                            <td class="appl-td">${renderApplBadges(d, 'main', s.id, origIdx)}</td>
                            <td>${otText}</td>
                            <td>${formatDateDDMMYYYY(d.eff)}</td>
                            <td>${d.rem || '<span class="sub">—</span>'}</td>
                            <td><span class="pill ${dStatusClass}">${d.status || 'Active'}</span></td>
                            <td class="act">
                                <button type="button" class="ib v" onclick="openStandaloneDetailModal('view', '${s.id}', ${origIdx})">👁 View</button>
                                <button type="button" class="ib" onclick="openStandaloneDetailModal('edit', '${s.id}', ${origIdx})">✎ Edit</button>
                                <button type="button" class="ib d" onclick="deleteStandaloneDetail('${s.id}', ${origIdx})">🗑 Delete</button>
                            </td>
                        </tr>
                    `;
                }).join('')
                : `<tr><td colspan="12" class="empty">No timing details added for this shift yet. Click "＋ Add Time" to add one.</td></tr>`;

            const expandRowHtml = `
                <tr class="detail-expand-row">
                    <td colspan="9">
                        <div class="sub-card">
                            <div class="sub-card-head">
                                <span>📋 Shift Details &amp; Timings for: ${s.name} (Shift ID: ${s.id})</span>
                                <button type="button" class="ib" onclick="openStandaloneDetailModal('add', '${s.id}')">＋ Add Shift Details</button>
                            </div>
                            <div class="shift-table-wrap">
                                <table class="detail-sub-table">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Start – End</th>
                                            <th>Late</th>
                                            <th>Absent</th>
                                            <th>Break</th>
                                            <th>Early Leave Before</th>
                                            <th>Applicable To</th>
                                            <th>Overtime Rules</th>
                                            <th>Effective From</th>
                                            <th>Remarks</th>
                                            <th>Activity Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>${detailRowsHtml}</tbody>
                                </table>
                            </div>
                        </div>
                    </td>
                </tr>
            `;

            return masterRowHtml + expandRowHtml;
        }).join('') || '<tr><td colspan="9" class="empty">No shifts found</td></tr>';
    }

    const info = q('#info');
    if (info) {
        info.textContent = `Showing ${L.length ? (page - 1) * pp + 1 : 0} to ${Math.min(page * pp, L.length)} of ${L.length} entries`;
    }

    const pg = q('#pg');
    if (pg) {
        let h = `<button type="button" ${page == 1 ? 'disabled' : ''} onclick="gp(${page - 1})">Prev</button>`;
        for (let p = 1; p <= pages; p++) {
            if (p == 1 || p == pages || Math.abs(p - page) <= 1)
                h += `<button type="button" class="${p == page ? 'on' : ''}" onclick="gp(${p})">${p}</button>`;
            else if (Math.abs(p - page) == 2)
                h += '<button type="button" disabled>…</button>';
        }
        pg.innerHTML = h + `<button type="button" ${page == pages ? 'disabled' : ''} onclick="gp(${page + 1})">Next</button>`;
    }
    kpis();
    renderSortHeaders();
}

const gp = p => { page = p; render(); };

function kpis() {
    const c = f => shifts.filter(f).length;
    const totalCount = liveDashboardCounts?.TotalShifts ?? shifts.length;
    const dayCount = liveDashboardCounts?.DayShifts ?? c(s => (s.type || '').toLowerCase().includes('day') || s.typeId == '01' || s.typeId == '1');
    const nightCount = liveDashboardCounts?.NightShifts ?? c(s => (s.type || '').toLowerCase().includes('night') || s.typeId == '02' || s.typeId == '2');
    const otCount = liveDashboardCounts?.WithOvertimeRules ?? c(s => (s.details || []).some(d => d.otRuleId));
    const crossCount = liveDashboardCounts?.CrossMidnight ?? c(s => (s.details || []).some(d => d.cross));
    const activeCount = liveDashboardCounts?.Active ?? c(s => s.status === 'Active');
    const inactiveCount = liveDashboardCounts?.Inactive ?? c(s => s.status === 'Inactive');

    const K = [
        ['Total shifts', totalCount, '', '#1d4ed8'],
        ['Day shifts', dayCount, 'fType=01', '#b45309'],
        ['Night shifts', nightCount, 'fType=02', '#3730a3'],
        ['With overtime rules', otCount, '', '#0e7490'],
        ['Cross Midnight', crossCount, '', '#7e22ce'],
        ['Active', activeCount, 'fSt=Active', '#15803d'],
        ['Inactive', inactiveCount, 'fSt=Inactive', '#b91c1c']
    ];

    const kpisEl = q('#kpis');
    if (kpisEl) {
        kpisEl.innerHTML = K.map(k => `<div class="card-box kpi" style="--c:${k[3]}" onclick="kf('${k[2]}')"><small>${k[0]}</small><b>${k[1]}</b></div>`).join('');
    }
}

function kf(x) {
    resetF(1);
    if (x) {
        const [a, b] = x.split('=');
        if (a === 'fType') {
            setSingleFilterValue('#msFType', '#fType', 'Shift type: All', b);
        } else if (a === 'fSt') {
            setSingleFilterValue('#msFSt', '#fSt', 'Activity status: All', b);
        }
    }
    page = 1;
    render();
}

function resetF(qFlag) {
    setSingleFilterValue('#msFType', '#fType', 'Shift type: All', '');
    setSingleFilterValue('#msFSt', '#fSt', 'Activity status: All', '');
    F_MS.fCo = [];
    F_MS.fBr = [];
    F_MS.fDp = [];
    F_MS.fEmp = [];

    const fCoEl = q('#msFCo');
    if (fCoEl) {
        rebuildMultiFilterOptions(fCoEl, 'fCo', 'Company');
        renderMultiFilterMS(fCoEl, 'fCo', 'Company');
    }
    applyTopFilterCascade('fCo');

    if (!qFlag) {
        if (q('#ls')) q('#ls').value = '';
        if (q('#gs')) q('#gs').value = '';
        page = 1;
        render();
    }
}

const ppSelectEl = q('#pp');
if (ppSelectEl) {
    ppSelectEl.onchange = () => {
        page = 1;
        render();
    };
}

['ls', 'gs'].forEach(i => {
    const el = q('#' + i);
    if (el) el.oninput = () => { page = 1; render(); };
});

/* ===== RENDER DETAILS GRID INSIDE MASTER MODAL ===== */
function renderModalDetailsGrid() {
    const tb = q('#modalDetailsTb');
    if (!tb) return;

    if (!formDetails || formDetails.length === 0) {
        tb.innerHTML = `<tr><td colspan="12" class="empty">No shift details added yet. Click <b>"＋ Add Shift Details"</b> above to add timing &amp; attendance rules.</td></tr>`;
        return;
    }

    tb.innerHTML = formDetails.map((d, idx) => {
        const dStatusClass = (d.status || 'Active') === 'Active' ? 'Active' : 'Inactive';
        const otRuleName = d.otRuleId
            ? ((DB_DATA.otRule || []).find(r => String(r.id) === String(d.otRuleId))?.name || d.otRule || d.otRuleId)
            : 'Not Applicable';
        const otText = (!d.otRuleId || otRuleName === 'Not Applicable')
            ? '<span class="sub">N/A</span>'
            : `<b>${otRuleName}</b><div class="sub">Max ${d.otMax || 4}h/day</div>`;

        return `
            <tr>
                <td><b>#${idx + 1}</b></td>
                <td>
                    <b>${short(d.start)} – ${short(d.end)}</b>
                    ${d.cross ? '<span class="pill cm" title="Cross midnight">+1d</span>' : ''}
                </td>
                <td>${short(d.late)}</td>
                <td>${short(d.absent)}</td>
                <td>${short(d.bf)} – ${short(d.bt)}</td>
                <td>${short(d.early)}</td>
                <td class="appl-td">${renderApplBadges(d, 'modal', 'modal', idx)}</td>
                <td>${otText}</td>
                <td>${formatDateDDMMYYYY(d.eff)}</td>
                <td>${d.rem || '<span class="sub">—</span>'}</td>
                <td><span class="pill ${dStatusClass}">${d.status || 'Active'}</span></td>
                <td class="act">
                    <button type="button" class="ib v" onclick="openDetailModal('view', ${idx})">👁 View</button>
                    <button type="button" class="ib" onclick="openDetailModal('edit', ${idx})">✎ Edit</button>
                    <button type="button" class="ib d" onclick="removeModalDetail(${idx})">🗑 Delete</button>
                </td>
            </tr>
        `;
    }).join('');
}

function removeModalDetail(idx) {
    const d = formDetails[idx];
    const timeLabel = d ? `(${short(d.start)} – ${short(d.end)})` : `#${idx + 1}`;
    openDeleteModal(
        'Delete Shift Detail',
        `Remove timing schedule ${timeLabel}?`,
        'This timing row will be removed from the shift details list.',
        function () {
            formDetails.splice(idx, 1);
            renderModalDetailsGrid();
            toast('Timing detail removed from list');
        }
    );
}
window.removeModalDetail = removeModalDetail;

/* ===== MASTER MODAL (ADD / EDIT SHIFT) ===== */
function openForm(id) {
    standaloneShiftCode = null;
    editing = id ? shifts.find(x => String(x.id) == String(id)) : null;
    if (editing) {
        if (q('#mt')) q('#mt').textContent = 'Edit Shift – ' + editing.id;
        if (q('#type')) q('#type').value = editing.typeId || (editing.type.toLowerCase().includes('night') ? '02' : '01');
        if (q('#sid')) q('#sid').value = editing.id;
        if (q('#name')) q('#name').value = editing.name || '';
        if (q('#desc')) q('#desc').value = editing.desc || '';
        if (q('#status')) q('#status').value = editing.status || 'Active';
        if (q('#rem')) q('#rem').value = editing.rem || '';
        formDetails = Array.isArray(editing.details) ? editing.details.map(d => ({
            ...d,
            company: [...(d.company || [])],
            branch: [...(d.branch || [])],
            dept: [...(d.dept || [])],
            emp: [...(d.emp || [])]
        })) : [];
        renderModalDetailsGrid();
        q('#ov')?.classList.add('open');
        document.body.style.overflow = 'hidden';
    } else {
        if (q('#mt')) q('#mt').textContent = 'Add New Shift';
        if (q('#type')) q('#type').selectedIndex = 0;
        if (q('#sid')) q('#sid').value = '';
        if (q('#name')) q('#name').value = '';
        if (q('#desc')) q('#desc').value = '';
        if (q('#status')) q('#status').value = 'Active';
        if (q('#rem')) q('#rem').value = '';
        formDetails = [];
        renderModalDetailsGrid();

        jQuery.get('/HRMATDShifts/GenerateNextCode', function (code) {
            if (q('#sid')) q('#sid').value = code || '';
        });

        q('#ov')?.classList.add('open');
        document.body.style.overflow = 'hidden';
    }
    qAll('.err').forEach(e => e.classList.remove('err'));
}

const closeForm = () => {
    q('#ov')?.classList.remove('open');
    document.body.style.overflow = '';
};

/* ===== DETAILS MODAL (ADD / EDIT / VIEW DETAILS) ===== */
function setDetailModalReadonly(isReadonly) {
    qAll('#detailModalBody .inp, #detailModalBody input[type="checkbox"]').forEach(el => {
        el.disabled = isReadonly;
    });
    qAll('#detailModalBody .tp').forEach(el => {
        el.classList.toggle('readonly', isReadonly);
    });
    qAll('#detailModalBody .ms').forEach(el => {
        el.classList.toggle('readonly', isReadonly);
    });
    const saveBtn = q('#btnSaveDetailItem');
    if (saveBtn) saveBtn.style.display = isReadonly ? 'none' : 'inline-block';
}

function populateDetailModalFields(d) {
    if (d) {
        setTP(tpEl('start'), d.start || '09:00:00 AM');
        setTP(tpEl('end'), d.end || '06:00:00 PM');
        setTP(tpEl('late'), d.late || '09:15:00 AM');
        setTP(tpEl('absent'), d.absent || '11:00:00 AM');
        setTP(tpEl('bf'), d.bf || '01:00:00 PM');
        setTP(tpEl('bt'), d.bt || '02:00:00 PM');
        setTP(tpEl('early'), d.early || '05:30:00 PM');
        if (q('#cross')) q('#cross').checked = !!d.cross;

        MS['company'] = (Array.isArray(d.company) ? [...d.company] : (d.company ? String(d.company).split(',').filter(Boolean) : [])).map(x => String(x).trim());
        MS['branch'] = (Array.isArray(d.branch) ? [...d.branch] : (d.branch ? String(d.branch).split(',').filter(Boolean) : [])).map(x => String(x).trim());
        MS['dept'] = (Array.isArray(d.dept) ? [...d.dept] : (d.dept ? String(d.dept).split(',').filter(Boolean) : [])).map(x => String(x).trim());
        MS['emp'] = (Array.isArray(d.emp) ? [...d.emp] : (d.emp ? String(d.emp).split(',').filter(Boolean) : [])).map(x => String(x).trim());

        const compEl = q('[data-ms="company"]');
        if (compEl) {
            rebuildMSOptions(compEl, 'company', compEl.dataset.label || 'Company');
            renderMS(compEl, 'company', compEl.dataset.label || 'Company');
        }
        applyCascade('company', true);

        setOtRuleValue(d.otRuleId || '');
        if (q('#otAfter')) q('#otAfter').value = d.otAfter ?? 60;
        if (q('#otMax')) q('#otMax').value = d.otMax ?? 4;
        if (q('#otMin')) q('#otMin').value = d.otMin ?? 50;
        if (q('#woOT')) q('#woOT').value = d.woOT || 'Not Applicable';
        if (q('#hOT')) q('#hOT').value = d.hOT || 'Not Applicable';
        if (q('#eff')) q('#eff').value = d.eff || new Date().toISOString().slice(0, 10);
        if (q('#dStatus')) q('#dStatus').value = d.status || 'Active';
        if (q('#dRem')) q('#dRem').value = d.rem || '';
    } else {
        setTP(tpEl('start'), '09:00:00 AM');
        setTP(tpEl('end'), '06:00:00 PM');
        setTP(tpEl('late'), '09:15:00 AM');
        setTP(tpEl('absent'), '11:00:00 AM');
        setTP(tpEl('bf'), '01:00:00 PM');
        setTP(tpEl('bt'), '02:00:00 PM');
        setTP(tpEl('early'), '05:30:00 PM');
        if (q('#cross')) q('#cross').checked = false;

        MS['company'] = [];
        MS['branch'] = [];
        MS['dept'] = [];
        MS['emp'] = [];
        const compEl = q('[data-ms="company"]');
        if (compEl) {
            rebuildMSOptions(compEl, 'company', compEl.dataset.label || 'Company');
            renderMS(compEl, 'company', compEl.dataset.label || 'Company');
        }
        applyCascade('company', false);

        setOtRuleValue('');
        if (q('#otAfter')) q('#otAfter').value = 60;
        if (q('#otMax')) q('#otMax').value = 4;
        if (q('#otMin')) q('#otMin').value = 50;
        if (q('#woOT')) q('#woOT').value = 'Not Applicable';
        if (q('#hOT')) q('#hOT').value = 'Not Applicable';
        if (q('#eff')) q('#eff').value = new Date().toISOString().slice(0, 10);
        if (q('#dStatus')) q('#dStatus').value = 'Active';
        if (q('#dRem')) q('#dRem').value = '';
    }
}

function openDetailModal(mode, idx = -1) {
    standaloneShiftCode = null;
    detailModalMode = mode || 'add';
    detailEditIndex = idx;

    const d = (idx >= 0 && formDetails[idx]) ? formDetails[idx] : null;
    populateDetailModalFields(d);

    if (mode === 'view') {
        if (q('#detailModalTitle')) q('#detailModalTitle').textContent = 'View Shift Timing & Rules Details';
        setDetailModalReadonly(true);
    } else if (mode === 'edit') {
        if (q('#detailModalTitle')) q('#detailModalTitle').textContent = 'Edit Shift Timing & Rules Details';
        setDetailModalReadonly(false);
    } else {
        if (q('#detailModalTitle')) q('#detailModalTitle').textContent = 'Add Shift Timing & Rules Details';
        setDetailModalReadonly(false);
    }

    qAll('#ovDetail .err').forEach(e => e.classList.remove('err'));
    q('#ovDetail')?.classList.add('open');
}
window.openDetailModal = openDetailModal;

// Open Detail Modal directly from Expanded Main Table
function openStandaloneDetailModal(mode, shiftId, detailIdx = -1) {
    standaloneShiftCode = String(shiftId);
    detailModalMode = mode || 'add';
    detailEditIndex = detailIdx;

    const s = shifts.find(x => String(x.id) === String(shiftId));
    const d = (s && Array.isArray(s.details) && detailIdx >= 0) ? s.details[detailIdx] : null;
    populateDetailModalFields(d);

    if (mode === 'view') {
        if (q('#detailModalTitle')) q('#detailModalTitle').textContent = `View Details – Shift ${shiftId}`;
        setDetailModalReadonly(true);
    } else if (mode === 'edit') {
        if (q('#detailModalTitle')) q('#detailModalTitle').textContent = `Edit Details – Shift ${shiftId}`;
        setDetailModalReadonly(false);
    } else {
        if (q('#detailModalTitle')) q('#detailModalTitle').textContent = `Add New Timing Details – Shift ${shiftId}`;
        setDetailModalReadonly(false);
    }

    qAll('#ovDetail .err').forEach(e => e.classList.remove('err'));
    q('#ovDetail')?.classList.add('open');
}
window.openStandaloneDetailModal = openStandaloneDetailModal;

function closeDetailModal() {
    q('#ovDetail')?.classList.remove('open');
}
window.closeDetailModal = closeDetailModal;

function saveDetailItem() {
    const eff = (q('#eff')?.value || '').trim();
    qAll('#ovDetail .err').forEach(e => e.classList.remove('err'));
    if (!eff) {
        q('#eff')?.classList.add('err');
        return toast('Please select Effective From Date');
    }

    const startVal = getTP(tpEl('start'));
    const endVal = getTP(tpEl('end'));
    const isCross = q('#cross')?.checked || false;
    if (mins(startVal) > mins(endVal) && !isCross) {
        return toast('End time is earlier than Start time – please check "Cross Midnight / Next Day"');
    }

    let lunchBreak = 0;
    try {
        const bfM = mins(getTP(tpEl('bf')));
        const btM = mins(getTP(tpEl('bt')));
        let diff = btM - bfM;
        if (diff < 0) diff += 1440;
        lunchBreak = Math.round((diff / 60) * 100) / 100;
    } catch (e) { }

    const otRuleIdVal = q('#otRule')?.value || '';
    const otRuleNameVal = otRuleIdVal
        ? ((DB_DATA.otRule || []).find(r => String(r.id) === String(otRuleIdVal))?.name || otRuleIdVal)
        : 'Not Applicable';

    const existingObj = standaloneShiftCode
        ? (shifts.find(x => String(x.id) === String(standaloneShiftCode))?.details?.[detailEditIndex] || null)
        : (detailEditIndex >= 0 ? formDetails[detailEditIndex] : null);

    const detailItem = {
        autoId: existingObj ? (existingObj.autoId || 0) : 0,
        shiftCode: standaloneShiftCode || (q('#sid')?.value || '').trim(),
        start: startVal,
        end: endVal,
        late: getTP(tpEl('late')),
        absent: getTP(tpEl('absent')),
        bf: getTP(tpEl('bf')),
        bt: getTP(tpEl('bt')),
        breakHour: lunchBreak,
        early: getTP(tpEl('early')),
        cross: isCross,
        company: [...(MS['company'] || [])],
        branch: [...(MS['branch'] || [])],
        dept: [...(MS['dept'] || [])],
        emp: [...(MS['emp'] || [])],
        otRuleId: otRuleIdVal,
        otRule: otRuleNameVal,
        otAfter: +(q('#otAfter')?.value || 60),
        otMax: +(q('#otMax')?.value || 4),
        otMin: +(q('#otMin')?.value || 50),
        woOT: q('#woOT')?.value || 'Not Applicable',
        hOT: q('#hOT')?.value || 'Not Applicable',
        eff: eff,
        status: q('#dStatus')?.value || 'Active',
        rem: (q('#dRem')?.value || '').trim()
    };

    // If opened directly from the main table's expanded row, save immediately via API
    if (standaloneShiftCode) {
        const payload = mapDetailToBackendDto(detailItem, standaloneShiftCode);
        const token = q('input[name="__RequestVerificationToken"]')?.value || '';
        jQuery.ajax({
            url: '/HRMATDShifts/SaveDetail',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            headers: token ? { 'RequestVerificationToken': token } : {},
            success: function (res) {
                if (res.isSuccess) {
                    toast(res.message || 'Shift detail saved successfully');
                    expandedShifts.add(String(standaloneShiftCode));
                    closeDetailModal();
                    loadShifts();
                    loadDashboardCount();
                } else {
                    toast(res.message || 'Failed to save shift detail');
                }
            },
            error: function (xhr) {
                toast('Failed to save detail: ' + (xhr.responseText || xhr.statusText));
            }
        });
        return;
    }

    // Otherwise update Master Modal's formDetails array
    if (detailModalMode === 'edit' && detailEditIndex >= 0) {
        formDetails[detailEditIndex] = detailItem;
        toast('Shift detail updated in list');
    } else {
        formDetails.push(detailItem);
        toast('Shift detail added to list');
    }

    renderModalDetailsGrid();
    closeDetailModal();
}
window.saveDetailItem = saveDetailItem;

let pendingDeleteCallback = null;

function openDeleteModal(title, heading, message, onConfirm) {
    if (q('#deleteModalTitle')) q('#deleteModalTitle').textContent = title || 'Delete Confirmation';
    if (q('#deleteModalHeading')) q('#deleteModalHeading').textContent = heading || 'Are you sure you want to delete?';
    if (q('#deleteModalMessage')) q('#deleteModalMessage').textContent = message || 'This action will permanently remove the selected record.';
    pendingDeleteCallback = typeof onConfirm === 'function' ? onConfirm : null;
    q('#ovDelete')?.classList.add('open');
}
window.openDeleteModal = openDeleteModal;

function closeDeleteModal() {
    q('#ovDelete')?.classList.remove('open');
    pendingDeleteCallback = null;
}
window.closeDeleteModal = closeDeleteModal;

function confirmDeleteAction() {
    const fn = pendingDeleteCallback;
    closeDeleteModal();
    if (typeof fn === 'function') {
        fn();
    }
}
window.confirmDeleteAction = confirmDeleteAction;

function deleteStandaloneDetail(shiftId, detailIdx) {
    const s = shifts.find(x => String(x.id) === String(shiftId));
    const d = s?.details?.[detailIdx];
    if (!d) return;

    openDeleteModal(
        'Delete Shift Timing Detail',
        `Delete timing schedule (${short(d.start)} – ${short(d.end)})?`,
        `This timing schedule will be permanently deleted from Shift ${shiftId} (${s?.name || ''}).`,
        function () {
            const token = q('input[name="__RequestVerificationToken"]')?.value || '';
            jQuery.ajax({
                url: '/HRMATDShifts/DeleteDetail',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(d.autoId),
                headers: token ? { 'RequestVerificationToken': token } : {},
                success: function (res) {
                    if (res.isSuccess) {
                        toast(res.message || 'Shift detail deleted');
                        loadShifts();
                        loadDashboardCount();
                    } else {
                        toast(res.message || 'Failed to delete detail');
                    }
                },
                error: function (xhr) {
                    toast('Error deleting detail: ' + (xhr.responseText || xhr.statusText));
                }
            });
        }
    );
}
window.deleteStandaloneDetail = deleteStandaloneDetail;

document.addEventListener('keydown', e => {
    if (e.key === 'Escape') {
        if (q('#ovDelete')?.classList.contains('open')) {
            closeDeleteModal();
        } else if (q('#ovDetail')?.classList.contains('open')) {
            closeDetailModal();
        } else {
            closeForm();
        }
    }
});

function toIsoDateTime(dateStr, time12h) {
    const baseDate = toIsoDateStr(dateStr);
    const m = (time12h || '').match(/(\d+):(\d+):(\d+)\s*(AM|PM)/i);
    if (!m) return `${baseDate}T09:00:00`;
    let h = parseInt(m[1], 10);
    const min = m[2].padStart(2, '0');
    const sec = m[3].padStart(2, '0');
    const ampm = m[4].toUpperCase();
    if (ampm === 'PM' && h < 12) h += 12;
    if (ampm === 'AM' && h === 12) h = 0;
    return `${baseDate}T${String(h).padStart(2, '0')}:${min}:${sec}`;
}

function mapDetailToBackendDto(d, shiftCode) {
    const effDate = toIsoDateStr(d.eff);
    return {
        AutoId: d.autoId || 0,
        ShiftCode: shiftCode,
        ShiftStartTime: toIsoDateTime(effDate, d.start),
        ShiftEndTime: toIsoDateTime(effDate, d.end),
        LateTime: toIsoDateTime(effDate, d.late),
        AbsentTime: toIsoDateTime(effDate, d.absent),
        LunchOutTime: toIsoDateTime(effDate, d.bf),
        LunchInTime: toIsoDateTime(effDate, d.bt),
        LunchBreakHour: d.breakHour || 0,
        EarlyLeaveTime: d.early || '',
        IsCrossMidnight: !!d.cross,
        CompanyIdsList: d.company || [],
        BranchIdsList: d.branch || [],
        DepartmentIdsList: d.dept || [],
        EmployeeIdsList: d.emp || [],
        OvertimeRuleID: d.otRuleId || '',
        OTGraceTime: d.otAfter ?? 60,
        MaxOTPerDay: d.otMax ?? 4,
        MinOTMinutes: d.otMin ?? 50,
        WeeklyOffOTRule: d.woOT || 'Not Applicable',
        HolidayOTRule: d.hOT || 'Not Applicable',
        Wef: `${effDate}T00:00:00`,
        IsActiveStatus: d.status || 'Active',
        IsActive: (d.status || 'Active') === 'Active',
        Remarks: d.rem || ''
    };
}

/* ===== SAVE SHIFT (MASTER + DETAILS) TO DATABASE ===== */
function save() {
    const sid = (q('#sid')?.value || '').trim();
    const name = (q('#name')?.value || '').trim();

    const bad = [
        ['#sid', !sid],
        ['#name', !name]
    ].filter(b => b[1]);

    qAll('#ov .err').forEach(e => e.classList.remove('err'));
    if (bad.length) {
        bad.forEach(b => q(b[0])?.classList.add('err'));
        return toast('Please fill in the required fields highlighted in red');
    }

    if (!formDetails || formDetails.length === 0) {
        return toast('Please add at least one Shift Detail (Timing & Rules) using "＋ Add Shift Details"');
    }

    const mappedDetails = formDetails.map(d => mapDetailToBackendDto(d, sid));
    const firstD = mappedDetails[0];

    const postData = {
        AutoId: editing ? editing.autoId : 0,
        ShiftCode: sid,
        ShiftName: name,
        ShiftShortName: q('#desc')?.value.trim() || '',
        Description: q('#desc')?.value.trim() || '',
        ShiftTypeId: q('#type')?.value || '',
        IsActiveStatus: q('#status')?.value || 'Active',
        IsActive: (q('#status')?.value || 'Active') === 'Active',
        Remarks: q('#rem')?.value.trim() || '',
        ShiftStartTime: firstD.ShiftStartTime,
        ShiftEndTime: firstD.ShiftEndTime,
        LateTime: firstD.LateTime,
        AbsentTime: firstD.AbsentTime,
        LunchOutTime: firstD.LunchOutTime,
        LunchInTime: firstD.LunchInTime,
        LunchBreakHour: firstD.LunchBreakHour,
        EarlyLeaveTime: firstD.EarlyLeaveTime,
        IsCrossMidnight: firstD.IsCrossMidnight,
        CompanyIdsList: firstD.CompanyIdsList,
        BranchIdsList: firstD.BranchIdsList,
        DepartmentIdsList: firstD.DepartmentIdsList,
        EmployeeIdsList: firstD.EmployeeIdsList,
        OvertimeRuleID: firstD.OvertimeRuleID,
        Wef: firstD.Wef,
        Details: mappedDetails
    };

    const token = q('input[name="__RequestVerificationToken"]')?.value || '';

    jQuery.ajax({
        url: '/HRMATDShifts/Setup',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(postData),
        headers: token ? { 'RequestVerificationToken': token } : {},
        success: function (res) {
            if (res.isSuccess) {
                toast(res.message || 'Shift saved successfully');
                expandedShifts.add(String(res.lastCode || sid));
                closeForm();
                loadShifts();
                loadDashboardCount();
            } else {
                toast(res.message || 'Save failed');
            }
        },
        error: function (xhr) {
            toast('Failed to save: ' + (xhr.responseText || xhr.statusText));
        }
    });
}

/* ===== DELETE SHIFT FROM DATABASE ===== */
function del(id) {
    const s = shifts.find(x => String(x.id) === String(id));
    const shiftTitle = s && s.name ? `${s.name} (Shift ID: ${id})` : `Shift ${id}`;
    openDeleteModal(
        'Delete Shift Confirmation',
        `Are you sure to delete ${shiftTitle}?`,
        'This will permanently delete the master shift and all of its associated timing schedules.',
        function () {
            const token = q('input[name="__RequestVerificationToken"]')?.value || '';
            jQuery.ajax({
                url: '/HRMATDShifts/Delete',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify([id]),
                headers: token ? { 'RequestVerificationToken': token } : {},
                success: function (res) {
                    if (res.isSuccess) {
                        toast(res.message || 'Shift deleted successfully');
                        loadShifts();
                        loadDashboardCount();
                    } else {
                        toast(res.message || 'Delete failed');
                    }
                },
                error: function (xhr) {
                    toast('Failed to delete: ' + (xhr.responseText || xhr.statusText));
                }
            });
        }
    );
}

function toast(m) {
    const t = q('#toast');
    if (!t) return;
    t.textContent = m;
    t.style.display = 'block';
    clearTimeout(t.h);
    t.h = setTimeout(() => t.style.display = 'none', 3000);
}

window.openForm = openForm;
window.closeForm = closeForm;
window.save = save;
window.del = del;
window.resetF = resetF;
window.kf = kf;
window.gp = gp;

function initPage() {
    renderSortHeaders();

    const floatingPop = q('#applFloatingPopover');
    if (floatingPop) {
        floatingPop.onmouseenter = () => clearTimeout(applPopTimeout);
        floatingPop.onmouseleave = hideApplPopover;
    }

    loadShifts();
    loadDashboardCount();
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPage);
} else {
    initPage();
}
</script>
