        field.innerHTML = `<label>${label}</label><div class="ms" data-ms="${key}"></div>`;
        applEl.appendChild(field);
        buildMS(field.querySelector('.ms'), key, label);
    }
});

/* ===== TOP FILTER BAR: PROJECT-STYLE SEARCHABLE & CASCADING DROPDOWNS ===== */
const F_MS = { fCo: [], fBr: [], fDp: [], fEmp: [] };
const F_OPT = {
    fCo: [...ALL_OPT.company],
    fBr: [...ALL_OPT.branch],
    fDp: [...ALL_OPT.dept],
    fEmp: [...ALL_OPT.emp]
};

function buildSingleFilterDropdown(elSelector, selectSelector, defaultPlaceholder, optionsList) {
    const el = q(elSelector);
    const sel = q(selectSelector);
    if (!el) return;

    if (sel) {
        sel.innerHTML = `<option value="">${defaultPlaceholder}</option>` +
            optionsList.map(o => `<option value="${o.id}">${o.name}</option>`).join('');
    }

    const allOpts = [{ id: '', name: defaultPlaceholder }, ...optionsList];
    el.innerHTML = `
        <button type="button" class="msb">
            <span class="ms-selected-text ph">${defaultPlaceholder}</span>
            <input type="text" class="ms-inline-search" placeholder="Type to search..." autocomplete="off">
            <span class="ms-right-clear" title="Clear filter">×</span>
            <span class="ms-caret">▾</span>
        </button>
        <div class="msl">
            ${allOpts.map(o => `<div class="ms-single-opt ${o.id === '' ? 'active' : ''}" data-val="${o.id}" data-search="${o.name.toLowerCase().replace(/"/g, '&quot;')}">${o.name}</div>`).join('')}
            <div class="ms-empty" style="display:none;">No matching results</div>
        </div>
    `;

    const msb = el.querySelector('.msb');
    const searchInp = el.querySelector('.ms-inline-search');
    const rightClear = el.querySelector('.ms-right-clear');
    const msl = el.querySelector('.msl');

    msb.onclick = e => {
        if (e.target.closest('.ms-right-clear')) return;
        if (e.target === searchInp && el.classList.contains('open')) return;
        const wasOpen = el.classList.contains('open');
        qAll('.ms').forEach(m => { if (m !== el) closeMSInstance(m); });
        if (wasOpen && e.target !== searchInp) {
            closeMSInstance(el);
        } else {
            el.classList.add('open');
            if (searchInp) {
                searchInp.value = '';
                filterMSList(el, '');
                setTimeout(() => searchInp.focus(), 10);
            }
        }
    };

    if (searchInp) {
        searchInp.onclick = e => e.stopPropagation();
        searchInp.onkeydown = e => {
            e.stopPropagation();
            if (e.key === 'Escape') closeMSInstance(el);
        };
        searchInp.oninput = e => filterMSList(el, e.target.value);
    }

    if (rightClear) {
        rightClear.onclick = e => {
            e.preventDefault();
            e.stopPropagation();
            setSingleFilterValue(elSelector, selectSelector, defaultPlaceholder, '');
            page = 1;
            render();
        };
    }

    msl.onclick = e => {
        const opt = e.target.closest('.ms-single-opt');
        if (!opt) return;
        setSingleFilterValue(elSelector, selectSelector, defaultPlaceholder, opt.dataset.val || '');
        closeMSInstance(el);
        page = 1;
        render();
    };
}

function setSingleFilterValue(elSelector, selectSelector, defaultPlaceholder, val) {
    const el = q(elSelector);
    const sel = q(selectSelector);
    const strVal = String(val || '').trim();
    if (sel) sel.value = strVal;
    if (!el) return;

    const opts = [...el.querySelectorAll('.ms-single-opt')];
    let activeText = defaultPlaceholder;
    opts.forEach(o => {
        const isMatch = String(o.dataset.val || '').trim() === strVal;
        o.classList.toggle('active', isMatch);
        if (isMatch) activeText = o.textContent;
    });

    const textSpan = el.querySelector('.msb .ms-selected-text');
    const rightClear = el.querySelector('.msb .ms-right-clear');
    if (textSpan) {
        textSpan.textContent = activeText;
        textSpan.classList.toggle('ph', !strVal);
    }
    if (rightClear) {
        rightClear.style.display = strVal ? 'inline-block' : 'none';
    }
}

function buildMultiFilterMS(el, fKey, label) {
    if (!el) return;
    F_MS[fKey] = [];
    el.dataset.label = label;
    el.innerHTML = `
        <button type="button" class="msb">
            <span class="ms-selected-text ph">${label}: All</span>
            <input type="text" class="ms-inline-search" placeholder="Type to search ${label.toLowerCase()}..." autocomplete="off">
            <span class="ms-right-clear" title="Clear filter">×</span>
            <span class="ms-caret">▾</span>
        </button>
        <div class="msl"></div>
    `;

    const msb = el.querySelector('.msb');
    const searchInp = el.querySelector('.ms-inline-search');
    const rightClear = el.querySelector('.ms-right-clear');
    const msl = el.querySelector('.msl');

    rebuildMultiFilterOptions(el, fKey, label);

    msb.onclick = e => {
        if (e.target.closest('.ms-right-clear')) return;
        if (e.target === searchInp && el.classList.contains('open')) return;
        const wasOpen = el.classList.contains('open');
        qAll('.ms').forEach(m => { if (m !== el) closeMSInstance(m); });
        if (wasOpen && e.target !== searchInp) {
            closeMSInstance(el);
        } else {
            el.classList.add('open');
            if (searchInp) {
                searchInp.value = '';
                filterMSList(el, '');
                setTimeout(() => searchInp.focus(), 10);
            }
        }
    };

    if (searchInp) {
        searchInp.onclick = e => e.stopPropagation();
        searchInp.onkeydown = e => {
            e.stopPropagation();
            if (e.key === 'Escape') closeMSInstance(el);
        };
        searchInp.oninput = e => filterMSList(el, e.target.value);
    }

    if (rightClear) {
        rightClear.onclick = e => {
            e.preventDefault();
            e.stopPropagation();
            F_MS[fKey] = [];
            renderMultiFilterMS(el, fKey, label);
            applyTopFilterCascade(fKey);
            page = 1;
            render();
        };
    }

    msl.onclick = e => {
        const clearRow = e.target.closest('.ms-clear-row');
        if (clearRow) {
            e.preventDefault();
            e.stopPropagation();
            F_MS[fKey] = [];
            if (searchInp) {
                searchInp.value = '';
                filterMSList(el, '');
            }
            renderMultiFilterMS(el, fKey, label);
            applyTopFilterCascade(fKey);
            page = 1;
            render();
        }
    };

    msl.onchange = e => {
        const allCbs = [...el.querySelectorAll('.msl label[data-item] input[value]')];
        const visibleCbs = allCbs.filter(c => c.closest('label').style.display !== 'none');
        if (e.target.dataset.all != null) {
            visibleCbs.forEach(c => c.checked = e.target.checked);
        }
        F_MS[fKey] = allCbs.filter(c => c.checked).map(c => String(c.value).trim());
        renderMultiFilterMS(el, fKey, label);
        applyTopFilterCascade(fKey);
        page = 1;
        render();
    };

    renderMultiFilterMS(el, fKey, label);
}

function rebuildMultiFilterOptions(el, fKey, label) {
    if (!el) return;
    const msl = el.querySelector('.msl');
    if (!msl) return;
    const items = F_OPT[fKey] || [];
    const selectedSet = new Set((F_MS[fKey] || []).map(x => String(x).trim()));

    if (items.length === 0) {
        msl.innerHTML = `<div class="ms-empty">No ${(label || fKey).toLowerCase()} available</div>`;
        return;
    }

    msl.innerHTML =
        `<div class="ms-clear-row" style="display:none;"><span>×</span> <span>Clear all</span></div>` +
        `<label class="ms-all-row"><input type="checkbox" data-all> <span>Select All</span></label>` +
        items.map(o => {
            const isChecked = selectedSet.has(String(o.id).trim()) ? 'checked' : '';
            return `<label data-item data-search="${(o.name + ' ' + o.id).toLowerCase().replace(/"/g, '&quot;')}"><input type="checkbox" value="${o.id}" ${isChecked}> <span>${o.name}</span></label>`;
        }).join('') +
        `<div class="ms-empty" style="display:none;">No matching results</div>`;
}

function renderMultiFilterMS(el, fKey, label) {
    if (!el) return;
    const a = (F_MS[fKey] || []).map(x => String(x).trim());
    const items = F_OPT[fKey] || [];
    const names = items.filter(x => a.includes(String(x.id).trim())).map(x => x.name);
    const textSpan = el.querySelector('.msb .ms-selected-text');
    const rightClear = el.querySelector('.msb .ms-right-clear');
    const clearRow = el.querySelector('.msl .ms-clear-row');
    const lbl = label || el.dataset.label || fKey;

    if (textSpan) {
        if (names.length === 0) {
            textSpan.textContent = `${lbl}: All`;
            textSpan.classList.add('ph');
            el.querySelector('.msb').title = '';
        } else if (names.length === 1) {
            textSpan.textContent = names[0];
            textSpan.classList.remove('ph');
            el.querySelector('.msb').title = names[0];
        } else {
            textSpan.textContent = `${names.length} ${lbl.toLowerCase()} selected`;
            textSpan.classList.remove('ph');
            el.querySelector('.msb').title = names.join(', ');
        }
    }

    if (rightClear) rightClear.style.display = a.length > 0 ? 'inline-block' : 'none';
    if (clearRow) clearRow.style.display = a.length > 0 ? 'flex' : 'none';

    const cbs = [...el.querySelectorAll('.msl label[data-item] input[value]')];
    cbs.forEach(c => c.checked = a.includes(String(c.value).trim()));

    const all = el.querySelector('[data-all]');
    if (all) {
        const visibleCbs = cbs.filter(c => c.closest('label').style.display !== 'none');
        all.checked = visibleCbs.length > 0 && visibleCbs.every(c => c.checked);
    }
}

function applyTopFilterCascade(changedKey) {
    const selCo = (F_MS['fCo'] || []).map(x => String(x).trim()).filter(Boolean);

    // 1. Filter Branch by Company
    if (selCo.length === 0) {
        F_OPT.fBr = [...ALL_OPT.branch];
    } else {
        const matchedBr = ALL_OPT.branch.filter(b =>
            !b.companyCodes?.length || b.companyCodes.some(c => selCo.includes(c))
        );
        F_OPT.fBr = matchedBr.length > 0 ? matchedBr : [...ALL_OPT.branch];
    }
    const validBrSet = new Set(F_OPT.fBr.map(b => b.id));
    F_MS['fBr'] = (F_MS['fBr'] || []).filter(id => validBrSet.has(String(id).trim()));
    const fBrEl = q('#msFBr');
    if (fBrEl) {
        rebuildMultiFilterOptions(fBrEl, 'fBr', 'Branch');
        renderMultiFilterMS(fBrEl, 'fBr', 'Branch');
    }

    // 2. Filter Department by Company & Branch
    const selBr = (F_MS['fBr'] || []).map(x => String(x).trim()).filter(Boolean);
    if (selCo.length === 0 && selBr.length === 0) {
        F_OPT.fDp = [...ALL_OPT.dept];
    } else {
        let matchedDp = ALL_OPT.dept.filter(d => {
            const okCo = selCo.length === 0 || !d.companyCodes?.length || d.companyCodes.some(c => selCo.includes(c));
            const okBr = selBr.length === 0 || (d.branchCodes && d.branchCodes.some(b => selBr.includes(b)));
            return okCo && okBr;
        });
        if (matchedDp.length === 0 && selCo.length > 0) {
            matchedDp = ALL_OPT.dept.filter(d => !d.companyCodes?.length || d.companyCodes.some(c => selCo.includes(c)));
        }
        F_OPT.fDp = matchedDp.length > 0 ? matchedDp : [...ALL_OPT.dept];
    }
    const validDpSet = new Set(F_OPT.fDp.map(d => d.id));
    F_MS['fDp'] = (F_MS['fDp'] || []).filter(id => validDpSet.has(String(id).trim()));
    const fDpEl = q('#msFDp');
    if (fDpEl) {
        rebuildMultiFilterOptions(fDpEl, 'fDp', 'Department');
        renderMultiFilterMS(fDpEl, 'fDp', 'Department');
    }

    // 3. Filter Employee by Company, Branch & Department
    const selDp = (F_MS['fDp'] || []).map(x => String(x).trim()).filter(Boolean);
    if (selCo.length === 0 && selBr.length === 0 && selDp.length === 0) {
        F_OPT.fEmp = [...ALL_OPT.emp];
    } else {
        F_OPT.fEmp = ALL_OPT.emp.filter(e => {
            const okCo = selCo.length === 0 || selCo.includes(e.companyCode);
            const okBr = selBr.length === 0 || selBr.includes(e.branchCode);
            const okDp = selDp.length === 0 || selDp.includes(e.deptCode);
            return okCo && okBr && okDp;
        });
    }
    const validEmpSet = new Set(F_OPT.fEmp.map(e => e.id));
    F_MS['fEmp'] = (F_MS['fEmp'] || []).filter(id => validEmpSet.has(String(id).trim()));
    const fEmpEl = q('#msFEmp');
    if (fEmpEl) {
        rebuildMultiFilterOptions(fEmpEl, 'fEmp', 'Employee');
        renderMultiFilterMS(fEmpEl, 'fEmp', 'Employee');
    }
}

