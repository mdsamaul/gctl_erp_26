const TPK = ['start', 'end', 'late', 'absent', 'bf', 'bt', 'early'];

/* ===== 12-HOUR TIME PICKER (hh : mm : ss AM/PM + spinner) ===== */
function buildTP(el, val) {
    if (!el) return;
    el.className = 'tp';
    el.innerHTML = '<span class="seg" tabindex="0" data-k="h"></span>:<span class="seg" tabindex="0" data-k="m"></span>:<span class="seg" tabindex="0" data-k="s"></span> <span class="seg" tabindex="0" data-k="p"></span><span class="sp"><i data-d="1">▲</i><i data-d="-1">▼</i></span>';
    el.active = 'h';
    setTP(el, val || '12:00:00 AM');
    const segs = [...el.querySelectorAll('.seg')];
    segs.forEach((s, i) => {
        s.onfocus = () => el.active = s.dataset.k;
        s.onkeydown = e => {
            const k = s.dataset.k;
            if (e.key == 'ArrowUp' || e.key == 'ArrowDown') {
                e.preventDefault();
                bump(el, k, e.key == 'ArrowUp' ? 1 : -1);
            } else if (e.key == 'ArrowRight' && segs[i + 1]) {
                e.preventDefault();
                segs[i + 1].focus();
            } else if (e.key == 'ArrowLeft' && segs[i - 1]) {
                e.preventDefault();
                segs[i - 1].focus();
            } else if (/^\d$/.test(e.key) && k != 'p') {
                e.preventDefault();
                const max = k == 'h' ? 12 : 59, t = el.buf && el.bk == k ? +(el.buf + e.key) : +e.key;
                if (t <= max && !(k == 'h' && t == 0 && el.buf)) {
                    el.v[k] = k == 'h' && t == 0 ? 12 : t;
                    paint(el);
                }
                if (el.buf && el.bk == k || (+e.key > (k == 'h' ? 1 : 5))) {
                    el.buf = '';
                    segs[i + 1] && segs[i + 1].focus();
                } else {
                    el.buf = e.key;
                    el.bk = k;
                }
            } else if (k == 'p' && /^[ap]$/i.test(e.key)) {
                el.v.p = e.key.toLowerCase() == 'a' ? 'AM' : 'PM';
                paint(el);
            }
        };
        s.onwheel = e => {
            e.preventDefault();
            s.focus();
            bump(el, s.dataset.k, e.deltaY < 0 ? 1 : -1);
        };
    });
    el.querySelectorAll('.sp i').forEach(b => b.onclick = () => bump(el, el.active, +b.dataset.d));
}

function bump(el, k, d) {
    const v = el.v;
    if (k == 'h') v.h = ((v.h - 1 + d + 12) % 12) + 1;
    else if (k == 'm') v.m = (v.m + d + 60) % 60;
    else if (k == 's') v.s = (v.s + d + 60) % 60;
    else v.p = v.p == 'AM' ? 'PM' : 'AM';
    paint(el);
}

function paint(el) {
    const p = n => String(n).padStart(2, '0');
    el.querySelector('[data-k=h]').textContent = p(el.v.h);
    el.querySelector('[data-k=m]').textContent = p(el.v.m);
    el.querySelector('[data-k=s]').textContent = p(el.v.s);
    el.querySelector('[data-k=p]').textContent = el.v.p;
}

function setTP(el, str) {
    if (!el) return;
    const m = (str || '').match(/(\d+):(\d+):(\d+)\s*(AM|PM)/i);
    el.v = m ? { h: +m[1], m: +m[2], s: +m[3], p: m[4].toUpperCase() } : { h: 12, m: 0, s: 0, p: 'AM' };
    paint(el);
}

function getTP(el) {
    if (!el || !el.v) return '12:00:00 AM';
    const p = n => String(n).padStart(2, '0'), v = el.v;
    return `${p(v.h)}:${p(v.m)}:${p(v.s)} ${v.p}`;
}

const tpEl = k => q(`[data-tp=${k}]`);
const short = t => t ? t.replace(/:00\s*(AM|PM)/i, ' $1') : '—';
const mins = t => {
    const m = (t || '').match(/(\d+):(\d+):?(\d*)\s*(AM|PM)/i);
    if (!m) return 0;
    return ((+m[1] % 12) + (m[4].toUpperCase() == 'PM' ? 12 : 0)) * 60 + +m[2];
};

function formatDateDDMMYYYY(val) {
    if (!val || val === '-') return '';
    const s = String(val).trim();
    const mIso = s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);
    if (mIso) {
        return `${mIso[3].padStart(2, '0')}/${mIso[2].padStart(2, '0')}/${mIso[1]}`;
    }
    const mSlash = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/);
    if (mSlash) {
        return `${mSlash[1].padStart(2, '0')}/${mSlash[2].padStart(2, '0')}/${mSlash[3]}`;
    }
    return s;
}

function toIsoDateStr(val) {
    if (!val) return new Date().toISOString().slice(0, 10);
    const s = String(val).trim();
    const mIso = s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);
    if (mIso) {
        return `${mIso[1]}-${mIso[2].padStart(2, '0')}-${mIso[3].padStart(2, '0')}`;
    }
    const mSlash = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/);
    if (mSlash) {
        return `${mSlash[3]}-${mSlash[2].padStart(2, '0')}-${mSlash[1].padStart(2, '0')}`;
    }
    return new Date().toISOString().slice(0, 10);
}

/* ===== PROJECT-STYLE SEARCHABLE MULTI-SELECT & CASCADING DROPDOWNS ===== */
const MS = {};

function buildMS(el, key, label) {
    if (!el) return;
    MS[key] = [];
    el.dataset.label = label;
    el.innerHTML = `
        <button type="button" class="msb">
            <span class="ms-selected-text ph">Select ${label.toLowerCase()}</span>
            <input type="text" class="ms-inline-search" placeholder="Type to search ${label.toLowerCase()}..." autocomplete="off">
            <span class="ms-right-clear" title="Clear selection">×</span>
            <span class="ms-caret">▾</span>
        </button>
        <div class="msl"></div>
    `;

    const msb = el.querySelector('.msb');
    const searchInp = el.querySelector('.ms-inline-search');
    const rightClear = el.querySelector('.ms-right-clear');
    const msl = el.querySelector('.msl');

    rebuildMSOptions(el, key, label);

    msb.onclick = e => {
        if (e.target.closest('.ms-right-clear')) return;
        if (e.target === searchInp && el.classList.contains('open')) return;

        const wasOpen = el.classList.contains('open');
        qAll('.ms').forEach(m => {
            if (m !== el) closeMSInstance(m);
        });

        if (wasOpen && e.target !== searchInp) {
            closeMSInstance(el);
        } else {
            el.classList.add('open');
            if (searchInp) {
                searchInp.value = '';
                filterMSList(el, '');
                setTimeout(() => searchInp.focus(), 10);
            }
        }
    };

    if (searchInp) {
        searchInp.onclick = e => e.stopPropagation();
        searchInp.onkeydown = e => {
            e.stopPropagation();
            if (e.key === 'Escape') {
                closeMSInstance(el);
            }
        };
        searchInp.oninput = e => {
            filterMSList(el, e.target.value);
        };
    }

    if (rightClear) {
        rightClear.onclick = e => {
            e.preventDefault();
            e.stopPropagation();
            MS[key] = [];
            renderMS(el, key, label);
            applyCascade(key);
        };
    }

    msl.onclick = e => {
        const clearRow = e.target.closest('.ms-clear-row');
        if (clearRow) {
            e.preventDefault();
            e.stopPropagation();
            MS[key] = [];
            if (searchInp) {
                searchInp.value = '';
                filterMSList(el, '');
            }
            renderMS(el, key, label);
            applyCascade(key);
        }
    };

    msl.onchange = e => {
        const allCbs = [...el.querySelectorAll('.msl label[data-item] input[value]')];
        const visibleCbs = allCbs.filter(c => c.closest('label').style.display !== 'none');

        if (e.target.dataset.all != null) {
            visibleCbs.forEach(c => c.checked = e.target.checked);
        }
        MS[key] = allCbs.filter(c => c.checked).map(c => String(c.value).trim());
        renderMS(el, key, label);
        applyCascade(key);
    };

    renderMS(el, key, label);
}

function closeMSInstance(el) {
    if (!el) return;
    el.classList.remove('open');
    const searchInp = el.querySelector('.ms-inline-search');
    if (searchInp && searchInp.value) {
        searchInp.value = '';
        filterMSList(el, '');
    }
}

function rebuildMSOptions(el, key, label) {
    if (!el) return;
    const msl = el.querySelector('.msl');
    if (!msl) return;
    const items = OPT[key] || [];
    const selectedSet = new Set((MS[key] || []).map(x => String(x).trim()));

    if (items.length === 0) {
        msl.innerHTML = `<div class="ms-empty">No ${(label || key).toLowerCase()} available</div>`;
        return;
    }

    msl.innerHTML =
        `<div class="ms-clear-row" style="display:none;"><span>×</span> <span>Clear all</span></div>` +
        `<label class="ms-all-row"><input type="checkbox" data-all> <span>Select All</span></label>` +
        items.map(o => {
            const isChecked = selectedSet.has(String(o.id).trim()) ? 'checked' : '';
            return `<label data-item data-search="${(o.name + ' ' + o.id).toLowerCase().replace(/"/g, '&quot;')}"><input type="checkbox" value="${o.id}" ${isChecked}> <span>${o.name}</span></label>`;
        }).join('') +
        `<div class="ms-empty" style="display:none;">No matching results</div>`;
}

function filterMSList(el, term) {
    if (!el) return;
    const qTerm = (term || '').toLowerCase().trim();
    const itemLabels = [...el.querySelectorAll('.msl label[data-item], .msl .ms-single-opt')];
    let visibleCount = 0;

    itemLabels.forEach(lbl => {
        const text = (lbl.dataset.search || lbl.textContent || '').toLowerCase();
        const match = !qTerm || text.includes(qTerm);
        lbl.style.display = match ? '' : 'none';
        if (match) visibleCount++;
    });

    const allRow = el.querySelector('.msl .ms-all-row');
    if (allRow) allRow.style.display = visibleCount > 0 ? '' : 'none';

    const emptyMsg = el.querySelector('.msl .ms-empty');
    if (emptyMsg && itemLabels.length > 0) {
        emptyMsg.style.display = visibleCount === 0 ? 'block' : 'none';
    }

    // Update Select All checkbox state for visible items
    const allCb = el.querySelector('.msl input[data-all]');
    if (allCb) {
        const visibleCbs = itemLabels
            .filter(l => l.style.display !== 'none')
            .map(l => l.querySelector('input[value]'))
            .filter(Boolean);
        allCb.checked = visibleCbs.length > 0 && visibleCbs.every(c => c.checked);
    }
}

function renderMS(el, key, label) {
    if (!el) return;
    const a = (MS[key] || []).map(x => String(x).trim());
    const items = OPT[key] || [];
    const allItems = ALL_OPT[key] || items;
    const names = items.filter(x => a.includes(String(x.id).trim())).map(x => x.name);
    const fallbackNames = names.length ? names : allItems.filter(x => a.includes(String(x.id).trim())).map(x => x.name);

    const textSpan = el.querySelector('.msb .ms-selected-text');
    const rightClear = el.querySelector('.msb .ms-right-clear');
    const clearRow = el.querySelector('.msl .ms-clear-row');
    const lbl = (label || el.dataset.label || key).toLowerCase();

    if (textSpan) {
        if (fallbackNames.length === 0) {
            textSpan.textContent = 'Select ' + lbl;
            textSpan.classList.add('ph');
            el.querySelector('.msb').title = '';
        } else if (fallbackNames.length === 1) {
            textSpan.textContent = fallbackNames[0];
            textSpan.classList.remove('ph');
            el.querySelector('.msb').title = fallbackNames[0];
        } else {
            textSpan.textContent = `${fallbackNames.length} ${lbl} selected`;
            textSpan.classList.remove('ph');
            el.querySelector('.msb').title = fallbackNames.join(', ');
        }
    }

    if (rightClear) rightClear.style.display = a.length > 0 ? 'inline-block' : 'none';
    if (clearRow) clearRow.style.display = a.length > 0 ? 'flex' : 'none';

    const cbs = [...el.querySelectorAll('.msl label[data-item] input[value]')];
    cbs.forEach(c => c.checked = a.includes(String(c.value).trim()));

    const all = el.querySelector('[data-all]');
    if (all) {
        const visibleCbs = cbs.filter(c => c.closest('label').style.display !== 'none');
        all.checked = visibleCbs.length > 0 && visibleCbs.every(c => c.checked);
    }
}

/* ===== CASCADING FILTER: Company -> Branch -> Department -> Employee ===== */
function applyCascade(changedKey, keepExistingSelections = false) {
    const selCompanies = (MS['company'] || []).map(x => String(x).trim()).filter(Boolean);

    // 1. Filter Branches by selected Company
    if (selCompanies.length === 0) {
        OPT.branch = [...ALL_OPT.branch];
    } else {
        const matchedBranches = ALL_OPT.branch.filter(b =>
            !b.companyCodes || b.companyCodes.length === 0 || b.companyCodes.some(c => selCompanies.includes(c))
        );
        OPT.branch = matchedBranches.length > 0 ? matchedBranches : [...ALL_OPT.branch];
    }

    if (!keepExistingSelections) {
        const validBranchIds = new Set(OPT.branch.map(b => b.id));
        MS['branch'] = (MS['branch'] || []).filter(id => validBranchIds.has(String(id).trim()));
    }
    const brEl = q('[data-ms="branch"]');
    if (brEl) {
        rebuildMSOptions(brEl, 'branch', brEl.dataset.label || 'Branch');
        renderMS(brEl, 'branch', brEl.dataset.label || 'Branch');
    }

    // 2. Filter Departments by selected Company & Branch
    const selBranches = (MS['branch'] || []).map(x => String(x).trim()).filter(Boolean);
    if (selCompanies.length === 0 && selBranches.length === 0) {
        OPT.dept = [...ALL_OPT.dept];
    } else {
        let matchedDepts = ALL_OPT.dept.filter(d => {
            const matchCo = selCompanies.length === 0 || !d.companyCodes?.length || d.companyCodes.some(c => selCompanies.includes(c));
            const matchBr = selBranches.length === 0 || (d.branchCodes && d.branchCodes.some(b => selBranches.includes(b)));
            return matchCo && matchBr;
        });
        // Fallback if branch has no department mappings yet in EmployeeOfficialInfo
        if (matchedDepts.length === 0 && selCompanies.length > 0) {
            matchedDepts = ALL_OPT.dept.filter(d => !d.companyCodes?.length || d.companyCodes.some(c => selCompanies.includes(c)));
        }
        if (matchedDepts.length === 0) {
            matchedDepts = [...ALL_OPT.dept];
        }
        OPT.dept = matchedDepts;
    }

    if (!keepExistingSelections) {
        const validDeptIds = new Set(OPT.dept.map(d => d.id));
        MS['dept'] = (MS['dept'] || []).filter(id => validDeptIds.has(String(id).trim()));
    }
    const dpEl = q('[data-ms="dept"]');
    if (dpEl) {
        rebuildMSOptions(dpEl, 'dept', dpEl.dataset.label || 'Department');
        renderMS(dpEl, 'dept', dpEl.dataset.label || 'Department');
    }

    // 3. Filter Employees by selected Company, Branch & Department
    const selDepts = (MS['dept'] || []).map(x => String(x).trim()).filter(Boolean);
    if (selCompanies.length === 0 && selBranches.length === 0 && selDepts.length === 0) {
        OPT.emp = [...ALL_OPT.emp];
    } else {
        OPT.emp = ALL_OPT.emp.filter(e => {
            const matchCo = selCompanies.length === 0 || selCompanies.includes(e.companyCode);
            const matchBr = selBranches.length === 0 || selBranches.includes(e.branchCode);
            const matchDp = selDepts.length === 0 || selDepts.includes(e.deptCode);
            return matchCo && matchBr && matchDp;
        });
    }

    if (!keepExistingSelections) {
        const validEmpIds = new Set(OPT.emp.map(e => e.id));
        MS['emp'] = (MS['emp'] || []).filter(id => validEmpIds.has(String(id).trim()));
    }
    const empEl = q('[data-ms="emp"]');
    if (empEl) {
        rebuildMSOptions(empEl, 'emp', empEl.dataset.label || 'Employee');
        renderMS(empEl, 'emp', empEl.dataset.label || 'Employee');
    }
}

function setMS(key, arr, skipCascade = false) {
    MS[key] = (Array.isArray(arr) ? [...arr] : (arr ? String(arr).split(',').filter(Boolean) : []))
        .map(x => String(x).trim())
        .filter(Boolean);
    const el = q(`[data-ms=${key}]`);
    if (el) {
        rebuildMSOptions(el, key, el.dataset.label);
        renderMS(el, key, el.dataset.label);
    }
    if (!skipCascade) {
        applyCascade(key);
    }
}

