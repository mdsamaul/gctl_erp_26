@model GCTL.UI.Core.ViewModels.HrmAtdShifts.HrmAtdShiftPageViewModel
@{
    ViewBag.Title = "Shift Setup | HR & Payroll";
    var companies = ViewBag.CompanyList ?? new List<object>();
    var branches = ViewBag.BranchList ?? new List<object>();
    var depts = ViewBag.DepartmentList ?? new List<object>();
    var emps = ViewBag.EmployeeList ?? new List<object>();
    var shiftTypes = ViewBag.ShiftTypeList ?? new List<object>();
    var otRules = ViewBag.OvertimeRuleList ?? new List<object>();
}

@Html.AntiForgeryToken()

<style>
/* ===== THEME TOKENS ===== */
:root {
    --pri: #1d4ed8;
    --pri-d: #1e3a8a;
    --pri-l: #eaf0ff;
    --bg: #f3f5f9;
    --card: #fff;
    --bd: #dde2ec;
    --tx: #1f2937;
    --mu: #6b7280;
    --ok: #15803d;
    --okb: #e3f6ea;
    --no: #b91c1c;
    --nob: #fde8e8;
    --wa: #b45309;
    --wab: #fff3dc;
    --r: 10px;
    --tpbg: #fff8dc;
}

.shift-app * { box-sizing: border-box; }
.shift-app {
    color: var(--tx);
    font-family: "Segoe UI", Inter, Roboto, Arial, sans-serif;
    font-size: 14px;
    line-height: 1.45;
}

.wrap {
    /* max-width: 1500px;
    margin: 0 auto; */
    padding: 10px 15px 30px;
}

.crumb {
    font-size: 12px;
    color: var(--mu);
    margin-bottom: 4px;
}

.top {
    display: flex;
    gap: 14px;
    align-items: center;
    flex-wrap: wrap;
    margin: 4px 0 16px;
}

.top h1 {
    margin: 0;
    font-size: 22px;
    font-weight: 700;
    color: var(--pri-d);
    flex: 1;
    min-width: 160px;
}

.btn-custom {
    border: 1px solid var(--bd);
    background: #fff;
    border-radius: 8px;
    padding: 8px 14px;
    cursor: pointer;
    font-weight: 600;
    display: inline-flex;
    gap: 6px;
    align-items: center;
    font-size: 13.5px;
    transition: all 0.15s ease;
    text-decoration: none !important;
}

.btn-custom:hover {
    border-color: var(--pri);
    color: var(--pri);
}

.btn-custom.p {
    background: var(--pri);
    border-color: var(--pri);
    color: #fff !important;
}

.btn-custom.p:hover {
    background: var(--pri-d);
    border-color: var(--pri-d);
    color: #fff !important;
}

.in {
    border: 1px solid var(--bd);
    border-radius: 8px;
    padding: 8px 10px;
    background: #fff;
    width: 100%;
    min-width: 0;
    font-size: 13.5px;
}

.in:focus, .tp:focus-within, .ms.open > .msb {
    outline: 2px solid #93b4ff;
    border-color: var(--pri);
}

.card-box {
    background: var(--card);
    border: 1px solid var(--bd);
    border-radius: var(--r);
    box-shadow: 0 1px 3px rgba(16, 24, 40, .05);
}

.gsearch { width: 240px; }

.dd { position: relative; }
.dd .menu {
    display: none;
    position: absolute;
    right: 0;
    top: 110%;
    background: #fff;
    border: 1px solid var(--bd);
    border-radius: 8px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, .12);
    z-index: 200;
    min-width: 190px;
    padding: 4px;
}

.dd.open .menu { display: block; }
.menu button {
    display: block;
    width: 100%;
    text-align: left;
    border: 0;
    background: none;
    padding: 8px 10px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 13px;
}
.menu button:hover { background: var(--pri-l); }

/* KPI CARDS */
.kpis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(135px, 1fr));
    gap: 12px;
    margin-bottom: 14px;
}

.kpi {
    padding: 12px 14px;
    border-left: 4px solid var(--c, var(--pri));
    cursor: pointer;
    transition: transform 0.15s, box-shadow 0.15s;
}

.kpi:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(0, 0, 0, .08);
}

.kpi small {
    color: var(--mu);
    display: block;
    font-size: 12px;
    font-weight: 600;
}

.kpi b {
    font-size: 24px;
    color: var(--c, var(--pri-d));
}

/* FILTERS */
.filters {
    display: grid;
    grid-template-columns: auto repeat(5, minmax(120px, 1fr)) auto;
    gap: 10px;
    align-items: center;
    padding: 12px 14px;
    margin-bottom: 14px;
}

.filters label {
    font-weight: 600;
    color: var(--mu);
    white-space: nowrap;
}

.tb {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    align-items: flex-end;
    padding: 12px 14px;
    border-bottom: 1px solid var(--bd);
    flex-wrap: wrap;
}

.tb-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
}

.tb-select, .tb-search {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    margin-bottom: 0;
}

.tb select, .tb input { width: auto; }
.tb h2 {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    color: var(--pri-d);
}

/* TABLE */
.shift-table-wrap { overflow-x: auto; overflow-y: hidden !important; }
table.shift-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: auto;
}

table.shift-table th {
    background: #eef2f9;
    color: #374151;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: .3px;
    text-align: left;
    padding: 10px 8px;
    border-bottom: 1px solid var(--bd);
    font-weight: 700;
}

th.th-sort {
    cursor: pointer;
    user-select: none;
    transition: background 0.15s ease, color 0.15s ease;
    white-space: nowrap;
}
th.th-sort:hover {
    background: #e2e8f0 !important;
    color: var(--pri-d) !important;
}
th.th-sort.sorted-asc,
th.th-sort.sorted-desc {
    background: #e3ebf7 !important;
    color: var(--pri-d) !important;
}
th.th-sort .th-inner {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    justify-content: space-between;
}
.sort-arrows {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-left: 5px;
    vertical-align: middle;
    gap: 1px;
}
.sort-arrows .arr-u, 
.sort-arrows .arr-d {
    font-style: normal;
    font-size: 10px;
    line-height: 8px;
    color: #94a3b8;
    cursor: pointer;
    transition: color 0.15s ease, transform 0.15s ease;
    user-select: none;
    padding: 1px 2px;
    display: block;
}
.sort-arrows .arr-u:hover {
    color: #2563eb;
    transform: translateY(-1px);
}
.sort-arrows .arr-d:hover {
    color: #2563eb;
    transform: translateY(1px);
}
.sort-arrows .arr-u.active {
    color: #1d4ed8 !important;
    font-weight: 900;
}
.sort-arrows .arr-d.active {
    color: #1d4ed8 !important;
    font-weight: 900;
}

table.shift-table td {
    padding: 9px 8px;
    border-bottom: 1px solid #edf0f6;
    vertical-align: middle;
    font-size: 13px;
}

table.shift-table tbody tr:hover { background: #f7f9ff; }
.id { font-weight: 700; color: var(--pri); }
.nm { font-weight: 600; }
.sub { color: var(--mu); font-size: 11.5px; }

.pill {
    display: inline-block;
    padding: 2px 9px;
    border-radius: 99px;
    font-size: 11.5px;
    font-weight: 700;
}

.pill.Day { background: var(--wab); color: var(--wa); }
.pill.Night { background: #e5e8ff; color: #3730a3; }
.pill.Active { background: var(--okb); color: var(--ok); }
.pill.Inactive { background: var(--nob); color: var(--no); }
.pill.cm { background: #f3e8ff; color: #7e22ce; margin-left: 4px; }

/* Applicable to: New-Line items and Floating Popover */
.appl-td {
    vertical-align: middle;
}

.appl-lines {
    display: flex;
    flex-direction: column;
    gap: 3px;
    align-items: flex-start;
}

.appl-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 7px;
    border-radius: 5px;
    font-size: 11.5px;
    font-weight: 600;
    color: #475569;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    cursor: pointer;
    transition: all 0.15s ease;
    white-space: nowrap;
    user-select: none;
    line-height: 1.25;
}

.appl-item:hover {
    background: #eff6ff;
    color: #1d4ed8;
    border-color: #93c5fd;
    box-shadow: 0 1px 3px rgba(37, 99, 235, 0.12);
}

.appl-item .appl-icon {
    font-size: 11px;
    opacity: 0.9;
}

.appl-item.has-data {
    color: #1e3a8a;
    background: #f1f5fd;
    border-color: #c7d7f8;
}

.appl-item.has-data:hover {
    background: #e0ecff;
    border-color: #60a5fa;
}

/* Floating Popover on Top of Everything */
.appl-floating-popover {
    position: fixed;
    z-index: 999999;
    display: none;
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.22);
    padding: 10px 12px;
    width: 260px;
    max-height: 220px;
    overflow: hidden;
    font-size: 12px;
    line-height: 1.4;
    color: #1e293b;
    pointer-events: auto;
    animation: fadeInApplPop 0.12s ease-out;
}

@@keyframes fadeInApplPop {
    from { opacity: 0; transform: scale(0.96); }
    to { opacity: 1; transform: scale(1); }
}

.appl-pop-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid #e2e8f0;
    padding-bottom: 5px;
    margin-bottom: 6px;
    font-weight: 700;
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    color: var(--pri-d);
}

.appl-pop-count {
    background: var(--pri-l);
    color: var(--pri);
    padding: 1px 6px;
    border-radius: 99px;
    font-size: 10.5px;
    font-weight: 700;
}

.appl-pop-body {
    max-height: 170px;
    overflow-y: auto;
    padding-right: 4px;
}

.appl-pop-body::-webkit-scrollbar {
    width: 5px;
}
.appl-pop-body::-webkit-scrollbar-track {
    background: #f1f5f9;
    border-radius: 4px;
}
.appl-pop-body::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 4px;
}
.appl-pop-body::-webkit-scrollbar-thumb:hover {
    background: #94a3b8;
}

.appl-pop-list {
    margin: 0;
    padding: 0;
    list-style: none;
}

.appl-pop-list li {
    padding: 3px 0;
    display: flex;
    align-items: flex-start;
    gap: 6px;
    color: #334155;
    font-size: 12px;
    border-bottom: 1px dashed #f1f5f9;
}
.appl-pop-list li:last-child {
    border-bottom: none;
}

.appl-pop-bullet {
    color: var(--pri);
    font-weight: bold;
    line-height: 1;
}

.appl-pop-empty {
    color: #64748b;
    font-style: italic;
    padding: 6px 0;
    font-size: 12px;
}

.act { white-space: nowrap; }
.ib {
    border: 1px solid var(--bd);
    background: #fff;
    border-radius: 6px;
    padding: 4px 9px;
    cursor: pointer;
    font-size: 12px;
    font-weight: 600;
    transition: all 0.1s;
}

.ib:hover { border-color: var(--pri); color: var(--pri); }
.ib.d:hover { border-color: var(--no); color: var(--no); }

.foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 14px;
    flex-wrap: wrap;
    gap: 8px;
    color: var(--mu);
    font-size: 13px;
}

.pg button {
    border: 1px solid var(--bd);
    background: #fff;
    padding: 5px 11px;
    margin-left: 3px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 13px;
}

.pg button.on {
    background: var(--pri);
    color: #fff;
    border-color: var(--pri);
}

.pg button:disabled { opacity: .45; cursor: default; }
.empty { text-align: center; padding: 30px; color: var(--mu); }

/* MODAL OVERLAY */
.ov {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 25, 40, .6);
    z-index: 99999;
    padding: 20px;
    overflow-y: auto;
}

.ov.open { display: block; }
.modal-box {
    background: #fff;
    border-radius: 12px;
    max-width: 900px;
    margin: 25px auto;
    box-shadow: 0 20px 60px rgba(0, 0, 0, .3);
    animation: modalIn 0.2s ease-out;
}

@@keyframes modalIn {
    from { opacity: 0; transform: translateY(-15px); }
    to { opacity: 1; transform: translateY(0); }
}

.mh {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 22px;
    background: #1f3a5f;
    color: #fff;
    border-radius: 12px 12px 0 0;
}

.mh h3 { margin: 0; font-size: 18px; color: #fff; font-weight: 700; }
.mh button {
    background: none;
    border: 0;
    color: #fff;
    font-size: 26px;
    cursor: pointer;
    line-height: 1;
}

.mb { padding: 6px 22px 14px; }
.grid-form {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
}

.f { display: flex; flex-direction: column; gap: 4px; }
.f.s2 { grid-column: span 2; }
.f.s4 { grid-column: span 4; }
.f > label { font-size: 12px; font-weight: 600; color: #6b7a8c; margin-bottom: 0; }
.req { color: #dc2626; font-weight: 700; }

.modal-box .inp {
    height: 38px;
    padding: 0 12px;
    border: 1px solid #e1e6ed;
    border-radius: 8px;
    background: #fff;
    min-width: 0;
    width: 100%;
    font-size: 13.5px;
}

.modal-box textarea.inp {
    height: auto;
    padding: 8px 12px;
    resize: vertical;
}

.modal-box .inp:focus, .modal-box .ms button:focus {
    outline: 2px solid rgba(31, 58, 95, .25);
    border-color: #1f3a5f;
}

.sec {
    margin: 16px 0 8px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .8px;
    color: #c8963e;
    border-bottom: 1px solid #e1e6ed;
    padding-bottom: 6px;
}

.mf {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding: 14px 22px;
    border-top: 1px solid #e1e6ed;
    background: #fafbfc;
    border-radius: 0 0 12px 12px;
}

.modal-box .btn-modal {
    height: 38px;
    padding: 0 16px;
    border-radius: 8px;
    border: 1px solid #e1e6ed;
    background: #fff;
    cursor: pointer;
    font-weight: 600;
    font-size: 13.5px;
}

.modal-box .btn-modal.p {
    background: #1f3a5f;
    border-color: #1f3a5f;
    color: #fff;
}

.modal-box .btn-modal.p:hover { background: #16294a; }
.chk {
    display: flex;
    flex-direction: row;
    gap: 8px;
    align-items: center;
    font-weight: 600;
    padding-top: 18px;
}
.chk input { width: 18px; height: 18px; accent-color: #1f3a5f; cursor: pointer; }
.err { border-color: var(--no) !important; outline: 1px solid var(--no) !important; }

/* 12-HOUR TIME PICKER */
.tp {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    background: var(--tpbg);
    border: 1px solid #d9cfa0;
    border-radius: 6px;
    padding: 4px 6px;
    width: fit-content;
    user-select: none;
}

.tp .seg {
    padding: 2px 4px;
    border-radius: 3px;
    min-width: 24px;
    text-align: center;
    font-variant-numeric: tabular-nums;
    cursor: default;
    outline: 0;
    font-size: 13.5px;
    font-weight: 600;
}

.tp .seg:focus { background: #3b6fd8; color: #fff; }
.tp .sp { display: flex; flex-direction: column; margin-left: 5px; gap: 1px; }
.tp .sp i {
    font-style: normal;
    width: 16px;
    height: 10px;
    background: #d8dbe3;
    border: 1px solid #aab;
    border-radius: 2px;
    font-size: 7px;
    line-height: 8px;
    text-align: center;
    cursor: pointer;
}
.tp .sp i:hover { background: #c3cdee; }

/* MULTI SELECT */
.ms { position: relative; }
.msb {
    width: 100%;
    height: 38px;
    padding: 0 12px;
    border: 1px solid #e1e6ed;
    border-radius: 8px;
    background: #fff;
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 13px;
}

.msb .ph { color: #6b7a8c; }
.msl {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 42px;
    max-height: 210px;
    overflow-y: auto;
    background: #fff;
    border: 1px solid #e1e6ed;
    border-radius: 8px;
    box-shadow: 0 4px 14px rgba(20, 35, 60, .15);
    z-index: 1000;
}

.ms.open .msl { display: block; }
.msl label {
    display: flex;
    gap: 8px;
    padding: 8px 12px;
    cursor: pointer;
    font-size: 13.5px;
    font-weight: 400;
    color: #1d2733;
    margin-bottom: 0;
}

.msl label:hover { background: #f3f5f8; }

.toast-box {
    position: fixed;
    right: 20px;
    bottom: 20px;
    background: #111827;
    color: #fff;
    padding: 12px 18px;
    border-radius: 8px;
    display: none;
    z-index: 999999;
    box-shadow: 0 10px 25px rgba(0, 0, 0, .3);
    font-weight: 500;
}

/* RESPONSIVE DESIGN */
@@media(max-width: 1180px) {
    .filters {
        grid-template-columns: repeat(3, 1fr);
    }
    .filters label { grid-column: span 3; }
    table.shift-table, thead, tbody, tr, td { display: block; }
    thead { display: none; }
    tbody tr {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 6px 12px;
        padding: 12px 14px;
        border-bottom: 1px solid var(--bd);
    }
    td { border: 0 !important; padding: 0 !important; }
    td[data-l]:before {
        content: attr(data-l);
        display: block;
        font-size: 10.5px;
        text-transform: uppercase;
        color: var(--mu);
        font-weight: 700;
    }
    td.wide { grid-column: span 2; }
    td.act { grid-column: span 2; text-align: right; align-self: end; }
}

@@media(max-width: 760px) {
    .grid-form { grid-template-columns: 1fr 1fr; }
    .f.s4, .sec { grid-column: span 2; }
    tbody tr { grid-template-columns: repeat(2, 1fr); }
}

@@media(max-width: 520px) {
    .ov { padding: 10px; }
    .mb { padding: 6px 14px 8px; }
    .grid-form { grid-template-columns: 1fr; }
    .f.s2, .f.s4, .sec { grid-column: span 1; }
    .mf { padding: 12px 14px; }
}

@@media print {
    .top .btn-custom, .top .dd, .filters, .tb, .foot, .act, .kpis, .mh button, .mf { display: none !important; }
    .wrap { padding: 0; }
}
</style>

<div class="shift-app">
    <div class="wrap">
        <div class="crumb">HR &amp; Payroll › Attendance › Shift Setup</div>
        <div class="top">
            <h1>Shift Setup</h1>
            <input class="in gsearch" id="gs" placeholder="🔍 Search shifts…">
            <div class="dd" id="exp">
                <button type="button" class="btn-custom" onclick="this.parentNode.classList.toggle('open')">⬇ Export ▾</button>
                <div class="menu">
                    <button type="button" onclick="window.print()">🖨 Print / Preview</button>
                    <button type="button" onclick="window.print()">📄 PDF (Save as PDF)</button>
                    <button type="button" onclick="exportCSV()">📊 Excel (CSV)</button>
                </div>
            </div>
            <button type="button" class="btn-custom p" onclick="openForm()">＋ New Shift</button>
        </div>

        <!-- KPI Cards -->
        <div class="kpis" id="kpis"></div>

        <!-- Filter Bar -->
        <div class="card-box filters">
            <label>Filter By:</label>
            <select class="in" id="fType">
                <option value="">Shift type: All</option>
            </select>
            <select class="in" id="fCo"><option value="">Company: All</option></select>
            <select class="in" id="fBr"><option value="">Branch: All</option></select>
            <select class="in" id="fDp"><option value="">Department: All</option></select>
            <select class="in" id="fSt">
                <option value="">Activity status: All</option>
                <option value="Active">Active</option>
                <option value="Inactive">Inactive</option>
            </select>
            <button type="button" class="btn-custom" onclick="resetF()">↺ Reset</button>
        </div>

        <!-- Shift List Table Card -->
        <div class="card-box">
            <div class="tb">
                <div class="tb-left">
                    <h2>Shift List</h2>
                    <label class="tb-select">
                        Show 
                        <select class="in" id="pp" style="margin: 0 4px;">
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                        </select> 
                        Entries
                    </label>
                </div>
