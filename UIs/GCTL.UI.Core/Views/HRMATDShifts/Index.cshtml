function toggleExpand(shiftId) {
    const key = String(shiftId);
    if (expandedShifts.has(key)) {
        expandedShifts.delete(key);
    } else {
        expandedShifts.add(key);
    }
    render();
}
window.toggleExpand = toggleExpand;

function toggleExpandAll() {
    const L = filtered();
    const allExpanded = L.length > 0 && L.every(s => expandedShifts.has(String(s.id)));
    if (allExpanded) {
        expandedShifts.clear();
        if (q('#btnExpandAll')) q('#btnExpandAll').textContent = '⊞ Expand All Details';
    } else {
        L.forEach(s => expandedShifts.add(String(s.id)));
        if (q('#btnExpandAll')) q('#btnExpandAll').textContent = '⊟ Collapse All Details';
    }
    render();
}
window.toggleExpandAll = toggleExpandAll;

function sortBy(col, forceDir) {
    if (forceDir) {
        sortCol = col;
        sortDir = forceDir;
    } else if (sortCol === col) {
        sortDir = sortDir === 'asc' ? 'desc' : 'asc';
    } else {
        sortCol = col;
        sortDir = 'asc';
    }
    page = 1;
    render();
}
window.sortBy = sortBy;

function renderSortHeaders() {
    qAll('th.th-sort').forEach(th => {
        const col = th.dataset.col;
        const u = th.querySelector('.arr-u');
        const d = th.querySelector('.arr-d');
        th.classList.remove('sorted-asc', 'sorted-desc');

        if (sortCol === col) {
            if (sortDir === 'asc') {
                th.classList.add('sorted-asc');
                if (u) u.classList.add('active');
                if (d) d.classList.remove('active');
            } else {
                th.classList.add('sorted-desc');
                if (u) u.classList.remove('active');
                if (d) d.classList.add('active');
            }
        } else {
            if (u) u.classList.remove('active');
            if (d) d.classList.remove('active');
        }
    });
}

function getSortVal(s, col) {
    switch (col) {
        case 'id':
            return s.id || '';
        case 'name':
            return (s.name || '').toLowerCase();
        case 'type':
            return (s.type || '').toLowerCase();
        case 'status':
            return (s.status || '').toLowerCase();
        default:
            return '';
