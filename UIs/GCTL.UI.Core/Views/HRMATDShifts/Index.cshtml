    <div class="appl-floating-popover" id="applFloatingPopover"></div>
</div>

@section Scripts {
<script>
/* ===== REAL DATABASE MASTER DATA ===== */
const DB_DATA = {
    company: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(companies)),
    branch: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(branches)),
    dept: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(depts)),
    emp: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(emps)),
    shiftType: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(shiftTypes)),
    otRule: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(otRules))
};

const OPT = {
    company: (DB_DATA.company || []).map(x => ({ id: x.id, name: x.name })),
    branch: (DB_DATA.branch || []).map(x => ({ id: x.id, name: x.name })),
    dept: (DB_DATA.dept || []).map(x => ({ id: x.id, name: x.name })),
    emp: (DB_DATA.emp || []).map(x => ({ id: x.id, name: x.name }))
};

// Safe DOM Selectors (avoids shadowing window.$ / jQuery)
const q = s => document.querySelector(s);
const qAll = s => [...document.querySelectorAll(s)];
const TPK = ['start', 'end', 'late', 'absent', 'bf', 'bt', 'early'];

/* ===== 12-HOUR TIME PICKER (hh : mm : ss AM/PM + spinner) ===== */
function buildTP(el, val) {
    if (!el) return;
    el.className = 'tp';
    el.innerHTML = '<span class="seg" tabindex="0" data-k="h"></span>:<span class="seg" tabindex="0" data-k="m"></span>:<span class="seg" tabindex="0" data-k="s"></span> <span class="seg" tabindex="0" data-k="p"></span><span class="sp"><i data-d="1">▲</i><i data-d="-1">▼</i></span>';
    el.active = 'h';
    setTP(el, val || '12:00:00 AM');
    const segs = [...el.querySelectorAll('.seg')];
    segs.forEach((s, i) => {
        s.onfocus = () => el.active = s.dataset.k;
        s.onkeydown = e => {
            const k = s.dataset.k;
            if (e.key == 'ArrowUp' || e.key == 'ArrowDown') {
                e.preventDefault();
                bump(el, k, e.key == 'ArrowUp' ? 1 : -1);
            } else if (e.key == 'ArrowRight' && segs[i + 1]) {
                e.preventDefault();
                segs[i + 1].focus();
            } else if (e.key == 'ArrowLeft' && segs[i - 1]) {
                e.preventDefault();
                segs[i - 1].focus();
            } else if (/^\d$/.test(e.key) && k != 'p') {
                e.preventDefault();
                const max = k == 'h' ? 12 : 59, t = el.buf && el.bk == k ? +(el.buf + e.key) : +e.key;
                if (t <= max && !(k == 'h' && t == 0 && el.buf)) {
                    el.v[k] = k == 'h' && t == 0 ? 12 : t;
                    paint(el);
                }
                if (el.buf && el.bk == k || (+e.key > (k == 'h' ? 1 : 5))) {
                    el.buf = '';
                    segs[i + 1] && segs[i + 1].focus();
                } else {
                    el.buf = e.key;
                    el.bk = k;
                }
            } else if (k == 'p' && /^[ap]$/i.test(e.key)) {
                el.v.p = e.key.toLowerCase() == 'a' ? 'AM' : 'PM';
                paint(el);
            }
        };
        s.onwheel = e => {
            e.preventDefault();
            s.focus();
            bump(el, s.dataset.k, e.deltaY < 0 ? 1 : -1);
        };
    });
    el.querySelectorAll('.sp i').forEach(b => b.onclick = () => bump(el, el.active, +b.dataset.d));
}

function bump(el, k, d) {
    const v = el.v;
    if (k == 'h') v.h = ((v.h - 1 + d + 12) % 12) + 1;
    else if (k == 'm') v.m = (v.m + d + 60) % 60;
    else if (k == 's') v.s = (v.s + d + 60) % 60;
    else v.p = v.p == 'AM' ? 'PM' : 'AM';
    paint(el);
}

function paint(el) {
    const p = n => String(n).padStart(2, '0');
    el.querySelector('[data-k=h]').textContent = p(el.v.h);
    el.querySelector('[data-k=m]').textContent = p(el.v.m);
    el.querySelector('[data-k=s]').textContent = p(el.v.s);
    el.querySelector('[data-k=p]').textContent = el.v.p;
}

function setTP(el, str) {
    if (!el) return;
    const m = (str || '').match(/(\d+):(\d+):(\d+)\s*(AM|PM)/i);
    el.v = m ? { h: +m[1], m: +m[2], s: +m[3], p: m[4].toUpperCase() } : { h: 12, m: 0, s: 0, p: 'AM' };
    paint(el);
}

function getTP(el) {
    if (!el || !el.v) return '12:00:00 AM';
    const p = n => String(n).padStart(2, '0'), v = el.v;
    return `${p(v.h)}:${p(v.m)}:${p(v.s)} ${v.p}`;
}

const tpEl = k => q(`[data-tp=${k}]`);
const short = t => t ? t.replace(/:00\s*(AM|PM)/i, ' $1') : '—';
const mins = t => {
    const m = (t || '').match(/(\d+):(\d+):?(\d*)\s*(AM|PM)/i);
    if (!m) return 0;
    return ((+m[1] % 12) + (m[4].toUpperCase() == 'PM' ? 12 : 0)) * 60 + +m[2];
};

/* ===== MULTI SELECT DROPDOWN ===== */
const MS = {};
function buildMS(el, key, label) {
    if (!el) return;
    MS[key] = [];
    el.dataset.label = label;
    el.innerHTML = '<button type="button" class="msb"></button><div class="msl"></div>';
    el.querySelector('.msl').innerHTML = '<label><input type="checkbox" data-all> <b>Select all</b></label>' +
        (OPT[key] || []).map(o => `<label><input type="checkbox" value="${o.id}"> ${o.name}</label>`).join('');

    el.querySelector('.msb').onclick = () => {
        qAll('.ms').forEach(m => m != el && m.classList.remove('open'));
        el.classList.toggle('open');
    };

    el.querySelector('.msl').onchange = e => {
        const cs = [...el.querySelectorAll('.msl [value]')];
        if (e.target.dataset.all != null) {
            cs.forEach(c => c.checked = e.target.checked);
        }
        MS[key] = cs.filter(c => c.checked).map(c => c.value);
        renderMS(el, key, label);
    };
    renderMS(el, key, label);
}

function renderMS(el, key, label) {
    if (!el) return;
    const a = MS[key] || [];
    const items = OPT[key] || [];
    const names = items.filter(x => a.includes(x.id)).map(x => x.name);
    const msb = el.querySelector('.msb');
    const lbl = (label || el.dataset.label || key).toLowerCase();
    if (msb) {
        if (names.length === 0) {
            msb.textContent = 'Select ' + lbl;
            msb.title = '';
        } else if (names.length === 1) {
            msb.textContent = names[0];
            msb.title = names[0];
        } else {
            msb.textContent = `${names.length} ${lbl} selected`;
            msb.title = names.join(', ');
        }
    }
    el.querySelectorAll('.msl [value]').forEach(c => c.checked = a.includes(c.value));
    const all = el.querySelector('[data-all]');
    if (all) all.checked = items.length > 0 && a.length === items.length;
}

function setMS(key, arr) {
    MS[key] = Array.isArray(arr) ? [...arr] : (arr ? String(arr).split(',') : []);
    const el = q(`[data-ms=${key}]`);
    if (el) renderMS(el, key, el.dataset.label);
}

function getNameById(key, id) {
    if (!id) return '';
    const items = OPT[key] || [];
    const found = items.find(x => String(x.id).trim() == String(id).trim() || String(x.name).trim() == String(id).trim());
    return found ? found.name : id;
}

function getNamesList(key, arr) {
    if (!arr) return [];
    const list = Array.isArray(arr) ? arr : String(arr).split(',');
    return list.map(id => getNameById(key, id)).filter(Boolean);
}

document.addEventListener('click', e => {
    if (!e.target.closest('.ms')) qAll('.ms').forEach(m => m.classList.remove('open'));
    if (!e.target.closest('.dd')) q('#exp')?.classList.remove('open');
});

/* ===== INITIALIZE DROPDOWNS ===== */
TPK.forEach(k => buildTP(tpEl(k)));

[['company', 'Company'], ['branch', 'Branch'], ['dept', 'Department'], ['emp', 'Employee']].forEach(([key, label]) => {
    const applEl = q('#appl');
    if (applEl) {
        const field = document.createElement('div');
        field.className = 'f';
        field.innerHTML = `<label>${label}</label><div class="ms" data-ms="${key}"></div>`;
        applEl.appendChild(field);
        buildMS(field.querySelector('.ms'), key, label);
    }
});

// Populate Top Filters
[['fCo', 'Company', 'company'], ['fBr', 'Branch', 'branch'], ['fDp', 'Department', 'dept']].forEach(([i, l, k]) => {
    const sel = q('#' + i);
    if (sel) {
        sel.innerHTML = `<option value="">${l}: All</option>` + (OPT[k] || []).map(o => `<option value="${o.id}">${o.name}</option>`).join('');
    }
});

// Populate Shift Type Dropdowns
if (DB_DATA.shiftType && DB_DATA.shiftType.length) {
    if (q('#fType')) q('#fType').innerHTML = `<option value="">Shift type: All</option>` + DB_DATA.shiftType.map(st => `<option value="${st.id}">${st.name}</option>`).join('');
    if (q('#type')) q('#type').innerHTML = DB_DATA.shiftType.map(st => `<option value="${st.id}">${st.name}</option>`).join('');
} else {
    if (q('#fType')) q('#fType').innerHTML = `<option value="">Shift type: All</option><option value="01">Day Shift</option><option value="02">Night Shift</option>`;
    if (q('#type')) q('#type').innerHTML = `<option value="01">Day Shift</option><option value="02">Night Shift</option>`;
}

// Populate Overtime Rules Dropdown
if (DB_DATA.otRule && DB_DATA.otRule.length) {
    if (q('#otRule')) q('#otRule').innerHTML = `<option value="">Not Applicable</option>` + DB_DATA.otRule.map(r => `<option value="${r.id}">${r.name}</option>`).join('');
} else {
    if (q('#otRule')) q('#otRule').innerHTML = `<option value="">Not Applicable</option><option value="01">After Shift End</option><option value="02">Shift End + After Grace</option>`;
}

/* ===== REAL DATA STATE & AJAX ===== */
let shifts = [];
let page = 1;
let editing = null;
let liveDashboardCounts = null;
let sortCol = 'id';
let sortDir = 'asc';

function sortBy(col, forceDir) {
    if (forceDir) {
        sortCol = col;
        sortDir = forceDir;
    } else if (sortCol === col) {
        sortDir = sortDir === 'asc' ? 'desc' : 'asc';
    } else {
        sortCol = col;
        sortDir = 'asc';
    }
    page = 1;
    render();
}
window.sortBy = sortBy;

function renderSortHeaders() {
    qAll('th.th-sort').forEach(th => {
        const col = th.dataset.col;
        const u = th.querySelector('.arr-u');
        const d = th.querySelector('.arr-d');
        th.classList.remove('sorted-asc', 'sorted-desc');

        if (sortCol === col) {
            if (sortDir === 'asc') {
                th.classList.add('sorted-asc');
                if (u) u.classList.add('active');
                if (d) d.classList.remove('active');
            } else {
                th.classList.add('sorted-desc');
                if (u) u.classList.remove('active');
                if (d) d.classList.add('active');
            }
        } else {
            if (u) u.classList.remove('active');
            if (d) d.classList.remove('active');
        }
    });
}

function getSortVal(s, col) {
    switch (col) {
        case 'id':
            return s.id || '';
        case 'name':
            return (s.name || '').toLowerCase();
        case 'type':
            return (s.type || '').toLowerCase();
        case 'start':
            return mins(s.start);
        case 'late':
            return mins(s.late);
        case 'absent':
            return mins(s.absent);
        case 'bf':
            return mins(s.bf);
        case 'early':
            return mins(s.early);
        case 'appl': {
            const compCount = Array.isArray(s.company) ? s.company.length : 0;
            const brCount = Array.isArray(s.branch) ? s.branch.length : 0;
            const deptCount = Array.isArray(s.dept) ? s.dept.length : 0;
            const empCount = Array.isArray(s.emp) ? s.emp.length : 0;
            return (compCount * 1000) + (brCount * 100) + (deptCount * 10) + empCount;
        }
        case 'otRule':
            return (s.otRule || '').toLowerCase();
        case 'eff':
            return s.eff ? new Date(s.eff).getTime() : 0;
        case 'status':
            return (s.status || '').toLowerCase();
        default:
            return '';
    }
}

let applPopTimeout = null;

function hoverAppl(targetEl, shiftId, type) {
    clearTimeout(applPopTimeout);
    const pop = q('#applFloatingPopover');
    if (!pop) return;

    const s = shifts.find(x => x.id == shiftId);
    if (!s) return;

    let title = '';
    let items = [];
    let countBadge = '';

    if (type === 'co') {
        items = getNamesList('company', s.company);
        countBadge = items.length ? items.length + ' Company' : 'All';
        title = '🏢 Company (' + countBadge + ')';
    } else if (type === 'br') {
        items = getNamesList('branch', s.branch);
        countBadge = items.length ? items.length + ' Branch' : 'All';
        title = '🌿 Branch (' + countBadge + ')';
    } else if (type === 'dp') {
        items = getNamesList('dept', s.dept);
        countBadge = items.length ? items.length + ' Department' : 'All';
        title = '📁 Department (' + countBadge + ')';
    } else if (type === 'em') {
        items = getNamesList('emp', s.emp);
        countBadge = items.length ? items.length + ' Employee' : 'All';
        title = '👤 Employee (' + countBadge + ')';
    }

    let bodyHtml = '';
    if (items && items.length > 0) {
        bodyHtml = '<ul class="appl-pop-list">' + 
            items.map(name => `<li><span class="appl-pop-bullet">•</span> <span>${name}</span></li>`).join('') + 
            '</ul>';
    } else {
        bodyHtml = `<div class="appl-pop-empty">All selected (No restriction)</div>`;
    }

    pop.innerHTML = `
        <div class="appl-pop-header">
            <span>${title}</span>
            <span class="appl-pop-count">${items.length ? items.length + ' item' + (items.length > 1 ? 's' : '') : 'All'}</span>
        </div>
        <div class="appl-pop-body">${bodyHtml}</div>
    `;

    pop.style.display = 'block';

    // Position fixed calculation (relative to viewport)
    const rect = targetEl.getBoundingClientRect();
    const popWidth = 260;
    const popMaxHeight = 220;

    let left = rect.right + 10;
    let top = rect.top - 5;

    // Flip to left if overflowing right of window
    if (left + popWidth > window.innerWidth - 12) {
        left = Math.max(10, rect.left - popWidth - 10);
    }

    // Shift upwards if overflowing bottom of viewport
    if (top + popMaxHeight > window.innerHeight - 12) {
        top = Math.max(10, window.innerHeight - popMaxHeight - 12);
    }
    if (top < 10) top = 10;

    pop.style.left = left + 'px';
    pop.style.top = top + 'px';
}
window.hoverAppl = hoverAppl;

function hideApplPopover() {
    clearTimeout(applPopTimeout);
    applPopTimeout = setTimeout(() => {
        const pop = q('#applFloatingPopover');
        if (pop) pop.style.display = 'none';
    }, 150);
}
window.hideApplPopover = hideApplPopover;

function loadShifts() {
    jQuery.ajax({
        url: '/HRMATDShifts/GetShifts',
        type: 'GET',
        cache: false,
        success: function (data) {
            shifts = Array.isArray(data) ? data : [];
            page = 1;
            render();
        },
        error: function (xhr) {
            console.error('Failed to load shifts', xhr);
            toast('Failed to load shift records');
        }
    });
}

function loadDashboardCount() {
    jQuery.ajax({
        type: 'GET',
        url: '/HRMATDShifts/GetDashboardCount',
        cache: false,
        success: function (data) {
            if (data) {
                liveDashboardCounts = data;
                kpis();
            }
        },
        error: function (xhr) {
            console.warn('Dashboard count query error', xhr);
        }
    });
}

function filtered() {
    const qSearch = ((q('#ls')?.value || '') + ' ' + (q('#gs')?.value || '')).toLowerCase().trim();
    const fTypeVal = q('#fType')?.value || '';
    const fCoVal = q('#fCo')?.value || '';
    const fBrVal = q('#fBr')?.value || '';
    const fDpVal = q('#fDp')?.value || '';
    const fStVal = q('#fSt')?.value || '';

    const list = shifts.filter(s => {
        if (fTypeVal && s.typeId !== fTypeVal && s.type !== fTypeVal) return false;
        if (fCoVal && !(s.company || []).includes(fCoVal)) return false;
        if (fBrVal && !(s.branch || []).includes(fBrVal)) return false;
        if (fDpVal && !(s.dept || []).includes(fDpVal)) return false;
        if (fStVal && s.status !== fStVal) return false;
        if (qSearch) {
            const rowStr = JSON.stringify(s).toLowerCase();
            return qSearch.split(' ').every(w => rowStr.includes(w));
        }
        return true;
    });

    list.sort((a, b) => {
        let va = getSortVal(a, sortCol);
        let vb = getSortVal(b, sortCol);
        if (typeof va === 'string' && typeof vb === 'string') {
            const cmp = va.localeCompare(vb, undefined, { numeric: true, sensitivity: 'base' });
            return sortDir === 'asc' ? cmp : -cmp;
        }
        if (va < vb) return sortDir === 'asc' ? -1 : 1;
        if (va > vb) return sortDir === 'asc' ? 1 : -1;
        return 0;
    });

    return list;
}

function render() {
    const L = filtered();
    const pp = +(q('#pp')?.value || 10);
    const pages = Math.max(1, Math.ceil(L.length / pp));
    page = Math.min(page, pages);
    const rows = L.slice((page - 1) * pp, page * pp);

    const tb = q('#tb');
    if (tb) {
        tb.innerHTML = rows.map(s => {
            const compNames = getNamesList('company', s.company);
            const brNames = getNamesList('branch', s.branch);
            const deptNames = getNamesList('dept', s.dept);
            const empNames = getNamesList('emp', s.emp);

            const compCount = compNames.length;
            const brCount = brNames.length;
            const deptCount = deptNames.length;
            const empCount = empNames.length;

            const compLabel = compCount ? (compCount + ' Company') : 'All Company';
            const brLabel = brCount ? (brCount + ' Branch') : 'All Branch';
            const deptLabel = deptCount ? (deptCount + ' Department') : 'All Department';
            const empLabel = empCount ? (empCount + ' Employee' + (empCount > 1 ? 's' : '')) : 'All Employees';

            const typeClass = (s.type || '').toLowerCase().includes('night') ? 'Night' : 'Day';
            const statusClass = (s.status || '') === 'Active' ? 'Active' : 'Inactive';

            return `<tr>
    <td data-l="Shift ID" class="id">${s.id}</td>
    <td data-l="Shift name" class="wide"><div class="nm">${s.name || ''}</div></td>
    <td data-l="Type"><span class="pill ${typeClass}">${s.type || ''}</span>${s.cross ? '<span class="pill cm" title="Cross midnight">+1d</span>' : ''}</td>
    <td data-l="Start – End" class="wide">${short(s.start)} – ${short(s.end)}</td>
    <td data-l="Late">${short(s.late)}</td>
    <td data-l="Absent">${short(s.absent)}</td>
    <td data-l="Break">${short(s.bf)} – ${short(s.bt)}</td>
    <td data-l="Early leave before">${short(s.early)}</td>
    <td data-l="Applicable to" class="appl-td">
        <div class="appl-lines">
            <div class="appl-item ${compCount ? 'has-data' : ''}" 
                 title="${compNames.length ? compNames.join(', ') : 'All Company'}" 
                 onmouseenter="hoverAppl(this, '${s.id}', 'co')" 
                 onmouseleave="hideApplPopover()">
                <span class="appl-icon">🏢</span>
                <span class="appl-lbl">${compLabel}</span>
            </div>
            <div class="appl-item ${brCount ? 'has-data' : ''}" 
                 title="${brNames.length ? brNames.join(', ') : 'All Branch'}" 
                 onmouseenter="hoverAppl(this, '${s.id}', 'br')" 
                 onmouseleave="hideApplPopover()">
                <span class="appl-icon">🌿</span>
                <span class="appl-lbl">${brLabel}</span>
            </div>
            <div class="appl-item ${deptCount ? 'has-data' : ''}" 
                 title="${deptNames.length ? deptNames.join(', ') : 'All Department'}" 
                 onmouseenter="hoverAppl(this, '${s.id}', 'dp')" 
                 onmouseleave="hideApplPopover()">
                <span class="appl-icon">📁</span>
                <span class="appl-lbl">${deptLabel}</span>
            </div>
            <div class="appl-item ${empCount ? 'has-data' : ''}" 
                 title="${empNames.length ? empNames.join(', ') : 'All Employee'}" 
                 onmouseenter="hoverAppl(this, '${s.id}', 'em')" 
                 onmouseleave="hideApplPopover()">
                <span class="appl-icon">👤</span>
                <span class="appl-lbl">${empLabel}</span>
            </div>
        </div>
    </td>
    <td data-l="Overtime">${(!s.otRule || s.otRule === 'Not Applicable') ? '<span class="sub">N/A</span>' : `${s.otRule}<div class="sub">Max ${s.otMax || 4}h/day</div>`}</td>
    <td data-l="Effective From">${s.eff || ''}</td>
    <td data-l="Status"><span class="pill ${statusClass}">${s.status || ''}</span></td>
    <td class="act">
        <button type="button" class="ib" onclick="openForm('${s.id}')">✎ Edit</button> 
        <button type="button" class="ib d" onclick="del('${s.id}')">🗑 Delete</button>
    </td>
</tr>`;
        }).join('') || '<tr><td colspan="13" class="empty">No shifts found</td></tr>';
    }

    const info = q('#info');
    if (info) {
        info.textContent = `Showing ${L.length ? (page - 1) * pp + 1 : 0} to ${Math.min(page * pp, L.length)} of ${L.length} entries`;
    }

    const pg = q('#pg');
    if (pg) {
        let h = `<button type="button" ${page == 1 ? 'disabled' : ''} onclick="gp(${page - 1})">Prev</button>`;
        for (let p = 1; p <= pages; p++) {
            if (p == 1 || p == pages || Math.abs(p - page) <= 1)
                h += `<button type="button" class="${p == page ? 'on' : ''}" onclick="gp(${p})">${p}</button>`;
            else if (Math.abs(p - page) == 2)
                h += '<button type="button" disabled>…</button>';
        }
        pg.innerHTML = h + `<button type="button" ${page == pages ? 'disabled' : ''} onclick="gp(${page + 1})">Next</button>`;
    }
    kpis();
    renderSortHeaders();
}

const gp = p => { page = p; render(); };

function kpis() {
    const c = f => shifts.filter(f).length;
    const totalCount = liveDashboardCounts?.TotalShifts ?? shifts.length;
    const dayCount = liveDashboardCounts?.DayShifts ?? c(s => (s.type || '').toLowerCase().includes('day') || s.typeId == '01' || s.typeId == '1');
    const nightCount = liveDashboardCounts?.NightShifts ?? c(s => (s.type || '').toLowerCase().includes('night') || s.typeId == '02' || s.typeId == '2');
    const otCount = liveDashboardCounts?.WithOvertimeRules ?? c(s => s.otRule && s.otRule !== 'Not Applicable' && s.otRuleId);
    const crossCount = liveDashboardCounts?.CrossMidnight ?? c(s => s.cross);
    const activeCount = liveDashboardCounts?.Active ?? c(s => s.status === 'Active');
    const inactiveCount = liveDashboardCounts?.Inactive ?? c(s => s.status === 'Inactive');

    const K = [
        ['Total shifts', totalCount, '', '#1d4ed8'],
        ['Day shifts', dayCount, 'fType=01', '#b45309'],
        ['Night shifts', nightCount, 'fType=02', '#3730a3'],
        ['With overtime rules', otCount, '', '#0e7490'],
        ['Cross Midnight', crossCount, '', '#7e22ce'],
        ['Active', activeCount, 'fSt=Active', '#15803d'],
        ['Inactive', inactiveCount, 'fSt=Inactive', '#b91c1c']
    ];

    const kpisEl = q('#kpis');
    if (kpisEl) {
        kpisEl.innerHTML = K.map(k => `<div class="card-box kpi" style="--c:${k[3]}" onclick="kf('${k[2]}')"><small>${k[0]}</small><b>${k[1]}</b></div>`).join('');
    }
}

function kf(x) {
    resetF(1);
    if (x) {
        const [a, b] = x.split('=');
        const target = q('#' + a);
        if (target) target.value = b;
    }
    page = 1;
    render();
}

function resetF(qFlag) {
    ['fType', 'fSt', 'fCo', 'fBr', 'fDp'].forEach(i => {
        const el = q('#' + i);
        if (el) el.selectedIndex = 0;
    });
    if (!qFlag) {
        if (q('#ls')) q('#ls').value = '';
        if (q('#gs')) q('#gs').value = '';
        page = 1;
        render();
    }
}

['fType', 'fCo', 'fBr', 'fDp', 'fSt', 'pp'].forEach(i => {
    const el = q('#' + i);
    if (el) el.onchange = () => { page = 1; render(); };
});

['ls', 'gs'].forEach(i => {
    const el = q('#' + i);
    if (el) el.oninput = () => { page = 1; render(); };
});

/* ===== ADD / EDIT FORM POPUP ===== */
function openForm(id) {
    editing = id ? shifts.find(x => x.id == id) : null;
    if (editing) {
        if (q('#mt')) q('#mt').textContent = 'Edit Shift – ' + editing.id;
        if (q('#type')) q('#type').value = editing.typeId || (editing.type.toLowerCase().includes('night') ? '02' : '01');
        if (q('#sid')) q('#sid').value = editing.id;
        if (q('#name')) q('#name').value = editing.name || '';
        if (q('#desc')) q('#desc').value = editing.desc || '';
        setTP(tpEl('start'), editing.start);
        setTP(tpEl('end'), editing.end);
        setTP(tpEl('late'), editing.late);
        setTP(tpEl('absent'), editing.absent);
        setTP(tpEl('bf'), editing.bf);
        setTP(tpEl('bt'), editing.bt);
        setTP(tpEl('early'), editing.early);
        if (q('#cross')) q('#cross').checked = !!editing.cross;
        setMS('company', editing.company || []);
        setMS('branch', editing.branch || []);
        setMS('dept', editing.dept || []);
        setMS('emp', editing.emp || []);
        if (q('#otRule')) q('#otRule').value = editing.otRuleId || '';
        if (q('#eff')) q('#eff').value = editing.eff || new Date().toISOString().slice(0, 10);
        if (q('#status')) q('#status').value = editing.status || 'Active';
        if (q('#rem')) q('#rem').value = editing.rem || '';
        q('#ov')?.classList.add('open');
        document.body.style.overflow = 'hidden';
    } else {
        if (q('#mt')) q('#mt').textContent = 'Add New Shift';
        if (q('#type')) q('#type').selectedIndex = 0;
        if (q('#sid')) q('#sid').value = '';
        if (q('#name')) q('#name').value = '';
        if (q('#desc')) q('#desc').value = '';
        setTP(tpEl('start'), '09:00:00 AM');
        setTP(tpEl('end'), '06:00:00 PM');
        setTP(tpEl('late'), '09:15:00 AM');
        setTP(tpEl('absent'), '11:00:00 AM');
        setTP(tpEl('bf'), '01:00:00 PM');
        setTP(tpEl('bt'), '02:00:00 PM');
        setTP(tpEl('early'), '05:30:00 PM');
        if (q('#cross')) q('#cross').checked = false;
        setMS('company', []);
        setMS('branch', []);
        setMS('dept', []);
        setMS('emp', []);
        if (q('#otRule')) q('#otRule').selectedIndex = 0;
        if (q('#eff')) q('#eff').value = new Date().toISOString().slice(0, 10);
        if (q('#status')) q('#status').value = 'Active';
        if (q('#rem')) q('#rem').value = '';

        // Fetch real next shift code from database
        jQuery.get('/HRMATDShifts/GenerateNextCode', function (code) {
            if (q('#sid')) q('#sid').value = code || '';
        });

        q('#ov')?.classList.add('open');
        document.body.style.overflow = 'hidden';
    }
    qAll('.err').forEach(e => e.classList.remove('err'));
}

const closeForm = () => {
    q('#ov')?.classList.remove('open');
    document.body.style.overflow = '';
};

document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeForm();
});

/* ===== SAVE SHIFT TO DATABASE ===== */
function save() {
    const sid = (q('#sid')?.value || '').trim();
    const name = (q('#name')?.value || '').trim();
    const eff = (q('#eff')?.value || '').trim();

    const bad = [
        ['#sid', !sid],
        ['#name', !name],
        ['#eff', !eff]
    ].filter(b => b[1]);

    qAll('.err').forEach(e => e.classList.remove('err'));
    if (bad.length) {
        bad.forEach(b => q(b[0])?.classList.add('err'));
        return toast('Please fill in the required fields highlighted in red');
    }

    const startVal = getTP(tpEl('start'));
    const endVal = getTP(tpEl('end'));
    const isCross = q('#cross')?.checked || false;
    if (mins(startVal) > mins(endVal) && !isCross) {
        return toast('End is earlier than start – please check "Cross Midnight / Next Day"');
    }

    // Calculate lunch break hour
    let lunchBreak = 0;
    try {
        const bfM = mins(getTP(tpEl('bf')));
        const btM = mins(getTP(tpEl('bt')));
        let diff = btM - bfM;
        if (diff < 0) diff += 1440;
        lunchBreak = Math.round((diff / 60) * 100) / 100;
    } catch (e) { }

    const postData = {
        AutoId: editing ? editing.autoId : 0,
        ShiftCode: sid,
        ShiftName: name,
        ShiftShortName: q('#desc')?.value.trim() || '',
        Description: q('#desc')?.value.trim() || '',
        ShiftTypeId: q('#type')?.value || '',
        ShiftStartTime: startVal,
        ShiftEndTime: endVal,
        LateTime: getTP(tpEl('late')),
        AbsentTime: getTP(tpEl('absent')),
        LunchOutTime: getTP(tpEl('bf')),
        LunchInTime: getTP(tpEl('bt')),
        LunchBreakHour: lunchBreak,
        EarlyLeaveTime: getTP(tpEl('early')),
        IsCrossMidnight: isCross,
        CompanyIdsList: MS['company'] || [],
        BranchIdsList: MS['branch'] || [],
        DepartmentIdsList: MS['dept'] || [],
        EmployeeIdsList: MS['emp'] || [],
        OvertimeRuleID: q('#otRule')?.value || '',
        Wef: eff,
        IsActiveStatus: q('#status')?.value || 'Active',
        Remarks: q('#rem')?.value.trim() || ''
    };

    const token = q('input[name="__RequestVerificationToken"]')?.value || '';

    jQuery.ajax({
        url: '/HRMATDShifts/Setup',
        type: 'POST',
        data: postData,
        headers: token ? { 'RequestVerificationToken': token } : {},
        success: function (res) {
            if (res.isSuccess) {
                toast(res.message || 'Shift saved successfully');
                closeForm();
                loadShifts();
                loadDashboardCount();
            } else {
                toast(res.message || 'Save failed');
            }
        },
        error: function (xhr) {
            toast('Failed to save: ' + (xhr.responseText || xhr.statusText));
        }
    });
}

/* ===== DELETE SHIFT FROM DATABASE ===== */
function del(id) {
    if (confirm('Delete shift ' + id + '?')) {
        const token = q('input[name="__RequestVerificationToken"]')?.value || '';
        jQuery.ajax({
            url: '/HRMATDShifts/Delete',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify([id]),
            headers: token ? { 'RequestVerificationToken': token } : {},
            success: function (res) {
                if (res.isSuccess) {
                    toast(res.message || 'Shift deleted successfully');
                    loadShifts();
                    loadDashboardCount();
                } else {
                    toast(res.message || 'Delete failed');
                }
            },
            error: function (xhr) {
                toast('Failed to delete: ' + (xhr.responseText || xhr.statusText));
            }
        });
    }
}

function toast(m) {
    const t = q('#toast');
    if (!t) return;
    t.textContent = m;
    t.style.display = 'block';
    clearTimeout(t.h);
    t.h = setTimeout(() => t.style.display = 'none', 3000);
}

function exportCSV() {
    const H = ['ID', 'Name', 'Type', 'Start', 'End', 'Late', 'Absent', 'Break From', 'Break To', 'Early Leave', 'Applicable To', 'Overtime', 'Effective From', 'Status'];
    const r = filtered().map(s => {
        const compNames = getNamesList('company', s.company);
        const brNames = getNamesList('branch', s.branch);
        const deptNames = getNamesList('dept', s.dept);
        const compStr = compNames.length ? compNames.join('; ') : 'All Company';
        const brStr = brNames.length ? brNames.join('; ') : 'All Branch';
        const deptStr = deptNames.length ? deptNames.join('; ') : 'All Department';
        const applSummary = `Company: ${compStr} | Branch: ${brStr} | Department: ${deptStr}`;
        return [
            s.id, s.name, s.type, s.start, s.end, s.late, s.absent, s.bf, s.bt, s.early, applSummary, s.otRule, s.eff, s.status
        ].map(v => `"${(v || '').replace(/"/g, '""')}"`).join(',');
    });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([[H.join(','), ...r].join('\n')], { type: 'text/csv;charset=utf-8;' }));
    a.download = 'shifts.csv';
    a.click();
}

// Expose handlers globally so onclick attributes work
window.openForm = openForm;
window.closeForm = closeForm;
window.save = save;
window.del = del;
window.resetF = resetF;
window.kf = kf;
window.gp = gp;
window.exportCSV = exportCSV;

// Initial Load from Database on page ready
function initPage() {
    renderSortHeaders();
    
    const floatingPop = q('#applFloatingPopover');
    if (floatingPop) {
        floatingPop.onmouseenter = () => clearTimeout(applPopTimeout);
        floatingPop.onmouseleave = hideApplPopover;
    }
    
    loadShifts();
    loadDashboardCount();
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPage);
} else {
    initPage();
}
</script>
}