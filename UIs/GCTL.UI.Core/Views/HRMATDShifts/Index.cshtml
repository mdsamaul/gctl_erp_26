.mf {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    padding: 14px 22px;
    border-top: 1px solid #e1e6ed;
    background: #fafbfc;
    border-radius: 0 0 12px 12px;
}

.modal-box .btn-modal {
    height: 38px;
    padding: 0 16px;
    border-radius: 8px;
    border: 1px solid #e1e6ed;
    background: #fff;
    cursor: pointer;
    font-weight: 600;
    font-size: 13.5px;
}

.modal-box .btn-modal.p {
    background: #1f3a5f;
    border-color: #1f3a5f;
    color: #fff;
}

.modal-box .btn-modal.p:hover { background: #16294a; }
.modal-box .btn-modal.d {
    background: #dc2626;
    border-color: #dc2626;
    color: #fff;
}
.modal-box .btn-modal.d:hover {
    background: #991b1b;
    border-color: #991b1b;
}
.del-body {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 16px 4px 10px;
}
.del-icon {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #fee2e2;
    color: #dc2626;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
}
.del-text h4 {
    margin: 0 0 6px;
    font-size: 15px;
    font-weight: 700;
    color: #111827;
}
.del-text p {
    margin: 0;
    font-size: 13px;
    color: #6b7280;
    line-height: 1.45;
}
.chk {
    display: flex;
    flex-direction: row;
    gap: 8px;
    align-items: center;
    font-weight: 600;
    padding-top: 18px;
}
.chk input { width: 18px; height: 18px; accent-color: #1f3a5f; cursor: pointer; }
.err { border-color: var(--no) !important; outline: 1px solid var(--no) !important; }

/* 12-HOUR TIME PICKER */
.tp {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    background: var(--tpbg);
    border: 1px solid #d9cfa0;
    border-radius: 6px;
    padding: 4px 6px;
    width: fit-content;
    user-select: none;
}

.tp.readonly {
    opacity: 0.75;
    pointer-events: none;
}

.tp .seg {
    padding: 2px 4px;
    border-radius: 3px;
    min-width: 24px;
    text-align: center;
    font-variant-numeric: tabular-nums;
    cursor: default;
    outline: 0;
    font-size: 13.5px;
    font-weight: 600;
}

.tp .seg:focus { background: #3b6fd8; color: #fff; }
.tp .sp { display: flex; flex-direction: column; margin-left: 5px; gap: 1px; }
.tp .sp i {
    font-style: normal;
    width: 16px;
    height: 10px;
    background: #d8dbe3;
    border: 1px solid #aab;
    border-radius: 2px;
    font-size: 7px;
    line-height: 8px;
    text-align: center;
    cursor: pointer;
}
.tp .sp i:hover { background: #c3cdee; }

/* MULTI SELECT & SEARCHABLE DROPDOWN (PROJECT STYLE) */
.ms { position: relative; }
.ms.readonly { pointer-events: none; opacity: 0.8; }
.msb {
    width: 100%;
    height: 38px;
    padding: 0 60px 0 12px;
    border: 1px solid #e1e6ed;
    border-radius: 8px;
    background: #fff;
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 13.5px;
    position: relative;
    display: flex;
    align-items: center;
    color: #1f2937;
}

.msb .ms-selected-text {
    display: block;
    width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    line-height: 36px;
}

.msb .ms-selected-text.ph {
    color: #6b7a8c;
}

.msb .ms-inline-search {
    display: none;
    width: 100%;
    height: 30px;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    background: transparent !important;
    font-size: 13.5px;
    color: #1f2937;
    padding: 0;
    margin: 0;
}

.ms.open .msb .ms-selected-text {
    display: none !important;
}

.ms.open .msb .ms-inline-search {
    display: block !important;
}

.msb .ms-right-clear {
    position: absolute;
    right: 28px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 16px;
    font-weight: 700;
    color: #6b7280;
    cursor: pointer;
    padding: 2px 5px;
    line-height: 1;
    border-radius: 4px;
    display: none;
    z-index: 3;
}

.msb .ms-right-clear:hover {
    color: #b91c1c;
    background: #fee2e2;
}

.msb .ms-caret {
    position: absolute;
    right: 11px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 11px;
    color: #6b7280;
    pointer-events: none;
    transition: transform 0.15s ease;
}

.ms.open .msb .ms-caret {
    transform: translateY(-50%) rotate(180deg);
    color: #1f3a5f;
}

.msl {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 41px;
    max-height: 240px;
    overflow-y: auto;
    background: #fff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    box-shadow: 0 8px 22px rgba(15, 23, 42, .16);
    z-index: 1050;
    padding: 4px 0;
}

.ms.open .msl { display: block; }

.msl .ms-clear-row {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    font-size: 12.5px;
    font-weight: 600;
    color: #64748b;
    cursor: pointer;
    border-bottom: 1px solid #f1f5f9;
    user-select: none;
}

.msl .ms-clear-row:hover {
    background: #fef2f2;
    color: #dc2626;
}

.msl .ms-all-row {
    border-bottom: 1px solid #f1f5f9;
    background: #f8fafc;
    font-weight: 600 !important;
}

.msl label {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    cursor: pointer;
    font-size: 13.5px;
    font-weight: 400;
    color: #1d2733;
    margin-bottom: 0;
    user-select: none;
}

.msl label:hover { background: #eff6ff; }
.msl label input[type="checkbox"] {
    width: 15px;
    height: 15px;
    accent-color: #1f3a5f;
    cursor: pointer;
    flex-shrink: 0;
}

.msl .ms-single-opt {
    padding: 8px 12px;
    cursor: pointer;
    font-size: 13.5px;
    color: #1d2733;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.msl .ms-single-opt:hover {
    background: #eff6ff;
    color: #1d4ed8;
}

.msl .ms-single-opt.active {
    background: #e0e7ff;
    color: #1e3a8a;
    font-weight: 600;
}

.msl .ms-empty {
    padding: 10px 12px;
    text-align: center;
    color: #94a3b8;
    font-size: 12.5px;
    font-style: italic;
}

.toast-box {
    position: fixed;
    right: 20px;
    bottom: 20px;
    background: #111827;
    color: #fff;
    padding: 12px 18px;
    border-radius: 8px;
    display: none;
    z-index: 999999;
    box-shadow: 0 10px 25px rgba(0, 0, 0, .3);
    font-weight: 500;
}

@@media(max-width: 760px) {
    .grid-form { grid-template-columns: 1fr 1fr; }
    .f.s3, .f.s4, .sec { grid-column: span 2; }
}

@@media(max-width: 520px) {
    .ov { padding: 10px; }
    .mb { padding: 6px 14px 8px; }
    .grid-form { grid-template-columns: 1fr; }
    .f.s2, .f.s3, .f.s4, .sec { grid-column: span 1; }
    .mf { padding: 12px 14px; }
}

@@media print {
    .top .btn-custom, .top .dd, .filters, .tb, .foot, .act, .kpis, .mh button, .mf { display: none !important; }
    .wrap { padding: 0; }
}
