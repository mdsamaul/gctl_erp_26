@model GCTL.UI.Core.ViewModels.HrmAtdShifts.HrmAtdShiftPageViewModel
@inject GCTL.Core.Data.IRepository<GCTL.Data.Models.HrmEmployeeOfficialInfo> EmpOfficialRepo
@inject GCTL.Core.Data.IRepository<GCTL.Data.Models.HrmEmployee> EmpRepo
@inject GCTL.Core.Data.IRepository<GCTL.Data.Models.CoreBranch> BranchRepo
@inject GCTL.Core.Data.IRepository<GCTL.Data.Models.HrmDefDepartment> DeptRepo
@{
    ViewBag.Title = "Shift Setup | HR & Payroll";
    var companies = ViewBag.CompanyList ?? new List<object>();
    var shiftTypes = ViewBag.ShiftTypeList ?? new List<object>();
    var otRules = ViewBag.OvertimeRuleList ?? new List<object>();

    // Load active employee official mappings (EmployeeStatus == "01" -> Active)
    var activeOfficialList = EmpOfficialRepo.All()
        .Where(o => o.EmployeeStatus == "01" || o.EmployeeStatus == "Active")
        .Select(o => new
        {
            empId = (o.EmployeeId ?? "").Trim(),
            compId = (o.CompanyCode ?? "").Trim(),
            brId = (o.BranchCode ?? "").Trim(),
            deptId = (o.DepartmentCode ?? "").Trim()
        })
        .ToList();

    var activeOfficialByEmp = activeOfficialList
        .Where(o => !string.IsNullOrEmpty(o.empId))
        .GroupBy(o => o.empId, StringComparer.OrdinalIgnoreCase)
        .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

    var branchCompMap = activeOfficialList
        .Where(o => !string.IsNullOrEmpty(o.brId) && !string.IsNullOrEmpty(o.compId))
        .GroupBy(o => o.brId, StringComparer.OrdinalIgnoreCase)
        .ToDictionary(g => g.Key, g => g.Select(x => x.compId).Distinct().ToList(), StringComparer.OrdinalIgnoreCase);

    var deptCompMap = activeOfficialList
        .Where(o => !string.IsNullOrEmpty(o.deptId) && !string.IsNullOrEmpty(o.compId))
        .GroupBy(o => o.deptId, StringComparer.OrdinalIgnoreCase)
        .ToDictionary(g => g.Key, g => g.Select(x => x.compId).Distinct().ToList(), StringComparer.OrdinalIgnoreCase);

    var deptBranchMap = activeOfficialList
        .Where(o => !string.IsNullOrEmpty(o.deptId) && !string.IsNullOrEmpty(o.brId))
        .GroupBy(o => o.deptId, StringComparer.OrdinalIgnoreCase)
        .ToDictionary(g => g.Key, g => g.Select(x => x.brId).Distinct().ToList(), StringComparer.OrdinalIgnoreCase);

    var branches = BranchRepo.All()
        .ToList()
        .Select(x =>
        {
            var bid = (x.BranchCode ?? "").Trim();
            var compSet = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            if (!string.IsNullOrWhiteSpace(x.CompanyCode)) compSet.Add(x.CompanyCode.Trim());
            if (branchCompMap.TryGetValue(bid, out var cList))
            {
                foreach (var c in cList) compSet.Add(c);
            }
            return new
            {
                id = bid,
                name = x.BranchName ?? "",
                companyCodes = compSet.ToList()
            };
        })
        .OrderBy(x => x.name)
        .ToList();

    var depts = DeptRepo.All()
        .ToList()
        .Select(x =>
        {
            var did = (x.DepartmentCode ?? "").Trim();
            var compSet = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            if (!string.IsNullOrWhiteSpace(x.CompanyCode)) compSet.Add(x.CompanyCode.Trim());
            if (deptCompMap.TryGetValue(did, out var cList))
            {
                foreach (var c in cList) compSet.Add(c);
            }
            var brSet = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            if (deptBranchMap.TryGetValue(did, out var bList))
            {
                foreach (var b in bList) brSet.Add(b);
            }
            return new
            {
                id = did,
                name = x.DepartmentName ?? "",
                companyCodes = compSet.ToList(),
                branchCodes = brSet.ToList()
            };
        })
        .OrderBy(x => x.name)
        .ToList();

    var emps = EmpRepo.All()
        .Select(x => new
        {
            id = (x.EmployeeId ?? "").Trim(),
            firstName = x.FirstName ?? "",
            lastName = x.LastName ?? ""
        })
        .ToList()
        .Where(x => !string.IsNullOrEmpty(x.id) && activeOfficialByEmp.ContainsKey(x.id))
        .Select(x =>
        {
            activeOfficialByEmp.TryGetValue(x.id, out var off);
            return new
            {
                id = x.id,
                name = (x.id + " - " + (x.firstName + " " + x.lastName).Trim()).Trim(),
                companyCode = off?.compId ?? "",
                branchCode = off?.brId ?? "",
                deptCode = off?.deptId ?? ""
            };
        })
        .OrderBy(x => x.id)
        .ToList();
}

@Html.AntiForgeryToken()

