@model List<GCTL.Core.ViewModels.HrmAtdShifts.HrmAtdShiftSetupViewModel>

<table id="hRMATDShifts-grid" class="table table-striped table-bordered table-sm table-hover table-common">
    <thead class="row-border">
        <tr class="table row-border">
            <th class="text-center text-middle" style="width: 30px;">
                <input type="checkbox" id="hRMATDShifts-check-all" />
            </th>
            <th class="text-center text-middle">Shift ID</th>
            <th class="text-left text-left">Shift Name</th>
            <th class="text-center text-middle">Type</th>
            <th class="text-center text-middle">Start – End</th>
            <th class="text-center text-middle">Late</th>
            <th class="text-center text-middle">Absent</th>
            <th class="text-center text-middle">Break</th>
            <th class="text-center text-middle">Early leave before</th>
            <th class="text-center text-middle">Applicable to</th>
            <th class="text-center text-middle">Overtime</th>
            <th class="text-center text-middle">Effective From</th>
            <th class="text-center text-middle">Status</th>
            <th class="text-center text-middle" style="width: 70px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model.OrderByDescending(x => x.ShiftCode))
            {
                <tr>
                    <td class="text-center">
                        <input type="checkbox" class="text-center text-middle checkBox" data-id="@item.ShiftCode" value="@item.ShiftCode" />
                    </td>
                    <td class="text-center">
                        <a href="javascript:void(0);" class="btn js-hRMATDShifts-edit font-weight-bold"
                           style="text-decoration: underline; color: rebeccapurple;"
                           data-id="@item.ShiftCode" title="Edit">
                            @item.ShiftCode
                        </a>
                    </td>
                    <td class="text-left">@item.ShiftName</td>
                    <td class="text-center"><span class="badge badge-light border">@item.ShiftTypeName</span></td>
                    <td class="text-center">@item.ShiftStartTime.ToString("hh:mm tt") – @item.ShiftEndTime.ToString("hh:mm tt")</td>
                    <td class="text-center">@item.LateTime.ToString("hh:mm tt")</td>
                    <td class="text-center">@item.AbsentTime.ToString("hh:mm tt")</td>
                    <td class="text-center">@(item.LunchBreakHour > 0 ? item.LunchBreakHour.ToString("0.##") + " hr" : "-")</td>
                    <td class="text-center">@(string.IsNullOrEmpty(item.EarlyLeaveTime) ? "-" : item.EarlyLeaveTime)</td>
                    <td class="text-center">
                        @if (!string.IsNullOrEmpty(item.CompanyIds) || !string.IsNullOrEmpty(item.DepartmentIds))
                        {
                            <span class="badge badge-info" title="Comp: @item.CompanyIds, Dept: @item.DepartmentIds">Assigned</span>
                        }
                        else
                        {
                            <span class="badge badge-secondary">All</span>
                        }
                    </td>
                    <td class="text-center">
                        @if (!string.IsNullOrEmpty(item.OvertimeRuleName))
                        {
                            <span class="badge badge-primary">@item.OvertimeRuleName</span>
                        }
                        else if (!string.IsNullOrEmpty(item.OvertimeRuleID))
                        {
                            <span class="badge badge-secondary">@item.OvertimeRuleID</span>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td class="text-center">@item.Wef.ToString("dd/MM/yyyy")</td>
                    <td class="text-center">
                        @if (item.IsActiveStatus == "Active" || item.IsActive)
                        {
                            <span class="badge badge-success">Active</span>
                        }
                        else
                        {
                            <span class="badge badge-danger">Inactive</span>
                        }
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2 js-hRMATDShifts-edit" data-id="@item.ShiftCode" title="Edit">
                            <i class="fas fa-edit"></i>
                        </button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

