@model ToobarModel
<div class="row">
	<div class="col-md-5">
		<h6 class="page-title px-3 text-black font-weight-bold">@Model.Title</h6>
	</div>
	<div class="col-md-7">
		<div class="btn-toolbar d-flex justify-content-end">
			<div class="btn-group">
				<button type="button" class="btn btn-default success-btn js-salarysheet-report-save" id="submitButton" disabled>
					<i class="fa fa-save">&nbsp;</i> Save
				</button>
				<button type="button" class="btn btn-default danger-btn" id="js-salarysheet-report-delete-confirm" disabled>
					<i class="fa fa-trash">&nbsp;</i> Delete
				</button>
				<button type="button" class="btn btn-default primary-btn " id="js-salarysheet-report-clear">
					<i class="fa fa-redo">&nbsp;</i> Clear
				</button>
				<button type="button" class="btn btn-default info-btn js-salarysheet-report-print" disabled>
					<i class="fa fa-print">&nbsp;</i> Print
				</button>
				<button type="button" class="btn btn-default warning-btn js-salarysheet-report-favorite">
					<i class="fa fa-star">&nbsp;</i> Favorite
				</button>
			</div>
		</div>
	</div>
</div>