@model GCTL.UI.Core.ViewModels.HrmDefBankAndNomineeInfos.HrmDefBankAndNomineeInfosPageViewModel
<!-- Content Header (Page header) -->
@{

    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Nominee Info";
    Model.Breadcrumb = "Nominee Info";
}

<section class="content-header" style="padding-bottom: 0;">
    <div class="container-fluid">
        <div class="calloutx callout-info" style="height: 30px;">
            <div class="row">
                <div class="col-md-8 row">
                    <ol class="breadcrumb float-sm-right">
                    </ol>
                </div>
                <div class="col-md-4">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="/Dashboard">Home</a></li>
                        <li class="breadcrumb-item"><a href="/HrmDefBankAndNomineeInfos"> Employee Nominee List</a></li>
                        <li class="breadcrumb-item active"></li>
                    </ol>
                </div>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header border-transparent">
                        <partial name="_Toolbars" model="new ToobarModel() { Title = Model.Breadcrumb, Code = Model.Code, Name = Model.Setup.BankAndNomineeId}" />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="content">

    <div class="container-fluid">
        <div class="form-group row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header px-2">
                        @await Html.PartialAsync("_TabButton")
                    </div>
                    <div class="card-body">
                        <div style="padding-top: 5px;">
                            <div class="row">
                                <div class="col-lg-12">
                                    <form asp-action="Setup" method="post" id="HrmDefBankAndNomineeInfos-form" enctype="multipart/form-data" asp-controller="HrmDefBankAndNomineeInfos">

                                        <div class="js-HrmDefBankAndNomineeInfos-form-container">

                                            @await Html.PartialAsync("_Setup", Model.Setup)

                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</section>
<partial name="QuickAddModal" />
<partial name="DeleteModal" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/pages/hrmDefBankAndNomineeInfos.js"></script>
    <script type="text/javascript">
              var options = {
             baseUrl: '@Url.Action("", "HrmDefBankAndNomineeInfos")'
         };
         options.load = () => {
         };
         $.hrmDefBankAndNomineeInfos(options);

    </script>
}



