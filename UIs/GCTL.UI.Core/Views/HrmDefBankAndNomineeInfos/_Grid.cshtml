@model List<GCTL.Core.ViewModels.HrmDefBankAndNomineeInfos.HrmDefBankAndNomineeInfosSetupViewModel>

<div class="card">
    <div class="card-body">
        <table id="HrmDefBankAndNomineeInfos-gridTT" class="table table-striped  table-bordered table-sm table-hover table-common">
            <thead class="row-border">
                <tr class="table row-border">
                    <th class="text-center text-middle" style="width: 5%;">
                        Select <br /> <input type="checkbox" id="HrmDefBankAndNomineeInfos-check-all" />
                    </th>
                    <th class="text-center text-middle" style="width: 5%;"> Id</th>
                    <th class="text-center text-middle" style="width: 15%;">Nominee</th>
                    <th class="text-center text-middle" style="width: 8%;">Relationship</th>
                    <th class="text-center text-middle" style="width: 10%;">Bank</th>
                    <th class="text-center text-middle" style="width: 8%;">Branch</th>
                    <th class="text-center text-middle" style="width: 13%;">Bank A/C Name</th>
                    <th class="text-center text-middle" style="width: 10%;">Bank A/C No</th>
                    <th class="text-center text-middle" style="width: 13%;">Present Address</th>
                    <th class="text-center text-middle" style="width: 13%;">Permanent Address</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr class="text-center text-middle">
                        <td colspan="13">No Data Available.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.OrderByDescending(x => x.BankAndNomineeId))
                    {
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" class="text-center text-middle checkBox" data-id2="@item.EmployeeId" data-id="@item.BankAndNomineeId" value="@item.BankAndNomineeId" />
                            </td>
                            <td style="text-align: center; vertical-align: middle;">
                                <a href="#" class="btn js-HrmDefBankAndNomineeInfos-edit"
                                   style="text-decoration: underline; color: rebeccapurple;"
                                   data-id="@item.BankAndNomineeId" data-id2="@item.EmployeeId" title="Edit">
                                    @item.BankAndNomineeId
                                </a>
                            </td>
                            <td class="text-left text-middle">@item.NomineeName</td>
                            <td class="text-center text-middle">@item.RelationName</td>
                            <td class="text-center text-middle">@item.BankName</td>
                            <td class="text-center text-middle">@item.BankBranchName</td>
                            <td class="text-center text-middle">@item.BankAccountName</td>
                            <td class="text-center text-middle">@item.BankAccountNo</td>
                            <td class="text-center text-middle">@item.PresentAddress</td>
                            <td class="text-center text-middle">@item.ParmanentAddress</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>