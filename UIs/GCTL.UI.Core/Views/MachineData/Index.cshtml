    }

    .filter-row {
        display: flex;
        gap: 15px;
        margin-bottom: 15px;
        align-items: flex-start;
        flex-wrap: wrap;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
        min-width: 250px;
    }

        .filter-group label {
            font-weight: 600;
            font-size: 0.9em;
            color: #333;
            margin-bottom: 5px;
