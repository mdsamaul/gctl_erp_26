<div class="container-fluid my-4">
    <h2 class="mb-4">Machine Data & Attendance Report</h2>

    <!-- Filter Container -->
    <div class="filter-container">
        <h4 class="mb-3">Export Filters</h4>

        <!-- Filter Type Tabs -->
        <div class="filter-type-tabs d-none">
            <button class="filter-type-tab active" data-filter="date">Date Range</button>
            <button class="filter-type-tab" data-filter="month">Month-Year Range</button>
        </div>

        <!-- Employee IDs with Bootstrap Multiselect -->
        <div class="filter-row col-3">
            <div class="filter-group" style="flex: 1;">
                <label for="employeeIdsInput">Select Employees</label>
                <select class="form-control" id="employeeIdsInput" multiple="multiple">
                    @if (ViewBag.EmployeeList != null)
                    {
                        var employeeList = ViewBag.EmployeeList as Dictionary<string, List<SelectListItem>>;
                        if (employeeList != null)
                        {
                            foreach (var group in employeeList)
                            {
                                <optgroup label="@group.Key">
                                    @foreach (var employee in group.Value)
                                    {
                                        <option value="@employee.Value">@employee.Text</option>
                                    }
                                </optgroup>
                            }
                        }
                    }
                </select>
            </div>
        </div>

        <!-- Date Range Filter -->
        <div class="filter-section active d-none" id="dateFilter">
            <div class="filter-row">
                <div class="filter-group">
                    <label for="fromDateInput">From Date</label>
                    <input type="date" id="fromDateInput" class="form-control" />
                </div>
                <div class="filter-group">
                    <label for="toDateInput">To Date</label>
                    <input type="date" id="toDateInput" class="form-control" />
                </div>
            </div>
        </div>

        <!-- Month-Year Range Filter -->
        <div class="filter-section d-none" id="monthFilter">
            <div class="filter-row">
                <div class="filter-group">
                    <label for="fromMonthInput">From Month</label>
                    <select id="fromMonthInput" class="form-control">
                        <option value="">Select Month</option>
                        <option value="1">January</option>
                        <option value="2">February</option>
                        <option value="3">March</option>
                        <option value="4">April</option>
                        <option value="5">May</option>
                        <option value="6">June</option>
                        <option value="7">July</option>
                        <option value="8">August</option>
                        <option value="9">September</option>
                        <option value="10">October</option>
                        <option value="11">November</option>
                        <option value="12">December</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label for="fromYearInput">From Year</label>
                    <input type="number"
                           id="fromYearInput"
                           class="form-control"
                           placeholder="e.g., 2024"
                           min="2000"
                           max="2100" />
                </div>
                <div class="filter-group">
                    <label for="toMonthInput">To Month</label>
                    <select id="toMonthInput" class="form-control">
                        <option value="">Select Month</option>
                        <option value="1">January</option>
                        <option value="2">February</option>
                        <option value="3">March</option>
                        <option value="4">April</option>
                        <option value="5">May</option>
                        <option value="6">June</option>
                        <option value="7">July</option>
                        <option value="8">August</option>
                        <option value="9">September</option>
                        <option value="10">October</option>
                        <option value="11">November</option>
                        <option value="12">December</option>
                    </select>
                </div>
                <div class="filter-group">
                    <label for="toYearInput">To Year</label>
                    <input type="number"
                           id="toYearInput"
                           class="form-control"
                           placeholder="e.g., 2024"
                           min="2000"
                           max="2100" />
                </div>
            </div>
        </div>

        <!-- Export Button -->
        <div class="filter-row">
            <button class="btn-export" id="btnExport">
                 Export to Excel
            </button>
        </div>
    </div>

    <!-- DataTable -->
    <div class="table-responsive">
        <table id="machineDataTable" class="display table table-striped table-bordered" style="width:100%">
            <thead>
                <tr>
                    <th>FingerPrint ID</th>
                    <th>Machine ID</th>
                    <th>Date</th>
                    <th>Time</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

