@section Scripts {
    <!-- Bootstrap Multiselect CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-multiselect/1.1.2/css/bootstrap-multiselect.min.css">

    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css">

    <!-- Bootstrap Multiselect JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-multiselect/1.1.2/js/bootstrap-multiselect.min.js"></script>

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            console.log('Initializing page...');

            // Initialize Bootstrap Multiselect
            try {
                $('#employeeIdsInput').multiselect({
                    includeSelectAllOption: true,
                    selectAllText: 'Select All',
                    selectAllValue: 'all',
                    enableFiltering: true,
                    enableCaseInsensitiveFiltering: true,
                    filterPlaceholder: 'Search employees...',
                    nonSelectedText: 'Select Employees',
                    nSelectedText: ' selected',
                    allSelectedText: 'All Selected',
                    numberDisplayed: 3,
                    maxHeight: 400,
                    buttonWidth: '100%',
                    buttonClass: 'btn btn-default multiselect',
                    includeResetOption: true,
                    includeResetDivider: true,
                    resetText: 'Clear Selection',
                    enableClickableOptGroups: true,
                    enableCollapsibleOptGroups: true,
                    collapseOptGroupsByDefault: false,
                    onChange: function(option, checked, select) {
                        var values = $('#employeeIdsInput').val();
                        console.log('Selected employees:', values ? values.length : 0);
                    },
                    onSelectAll: function() {
                        console.log('All employees selected');
                    },
                    onDeselectAll: function() {
                        console.log('All employees deselected');
                    }
                });
                console.log('Multiselect initialized successfully');
            } catch (e) {
                console.error('Error initializing multiselect:', e);
            }

            // Initialize DataTable
            try {
                var table = $('#machineDataTable').DataTable({
                    processing: true,
                    serverSide: true,
                    ajax: {
                        url: '/MachineData/GetDataTableData',
                        type: 'POST',
                        dataType: 'json',
                        error: function(xhr, error, code) {
                            console.log('DataTable Error:', error, code);
                        }
                    },
                    columns: [
                        { data: 'fingerPrintId', title: 'FingerPrint ID' },
                        { data: 'machineId', title: 'Machine ID' },
                        {
                            data: 'date',
                            title: 'Date',
                            render: function (data) {
                                if (data) {
                                    const date = new Date(data);
                                    return date.toLocaleDateString('en-GB');
                                }
                                return '';
                            }
                        },
                        {
                            data: 'time',
                            title: 'Time',
                            render: function (data) {
                                if (data) {
                                    const timePart = new Date(data).toTimeString().split(' ')[0];
                                    return timePart;
                                }
                                return '';
                            }
                        }
                    ],
                    order: [[2, 'desc']],
                    language: {
                        processing: "Loading data..."
                    },
                    pageLength: 25,
                    lengthMenu: [25, 50, 75, 100],
                    responsive: true
                });
                console.log('DataTable initialized successfully');
            } catch (e) {
                console.error('Error initializing DataTable:', e);
            }

            // Filter Type Toggle
            $('.filter-type-tab').on('click', function() {
                const filterType = $(this).data('filter');

                // Update active tab
                $('.filter-type-tab').removeClass('active');
                $(this).addClass('active');

                // Show/hide filter sections
                $('.filter-section').removeClass('active');
                if (filterType === 'date') {
                    $('#dateFilter').addClass('active');
                    // Clear month fields
                    $('#fromMonthInput, #fromYearInput, #toMonthInput, #toYearInput').val('');
                } else {
                    $('#monthFilter').addClass('active');
                    // Clear date fields
                    $('#fromDateInput, #toDateInput').val('');
                }
            });

            // Export Button Click
            $('#btnExport').on('click', function() {
                exportExcel();
            });

            function exportExcel() {
                const activeFilter = $('.filter-type-tab.active').data('filter');

                // Get selected employee IDs
                const selectedEmployees = $('#employeeIdsInput').val();
                const employeeIds = selectedEmployees && selectedEmployees.length > 0
                    ? selectedEmployees.join(',')
                    : null;

                let data = {
                    employeeIds: employeeIds
                };

                if (activeFilter === 'date') {
                    data.fromDate = $('#fromDateInput').val() || null;
                    data.toDate = $('#toDateInput').val() || null;
                    data.fromMonth = null;
                    data.fromYear = null;
                    data.toMonth = null;
                    data.toYear = null;

                    if (!data.fromDate && !data.toDate) {
                        alert('⚠️ Please select at least one date (From or To)');
                        return;
                    }
                } else {
                    data.fromDate = null;
                    data.toDate = null;
