                        alert('⚠️ Please select complete month-year range');
                        return;
                    }
                }

                // Disable button and show loading
                const $btn = $('#btnExport');
                const originalText = $btn.text();
                $btn.prop('disabled', true).text('⏳ Generating...');

                $.ajax({
                    url: '/MachineData/ExportAttendanceToExcel',
                    type: 'POST',
                    data: data,
                    xhrFields: {
                        responseType: 'blob'
