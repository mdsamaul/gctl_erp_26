        padding: 10px 25px;
        background: #28a745;
        color: white;
        border: none;
        border-radius: 5px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.3s;
    }

        .btn-export:hover {
            background: #218838;
        }

        .btn-export:disabled {
            background: #6c757d;
            cursor: not-allowed;
