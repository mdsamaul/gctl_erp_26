@model List<GCTL.Core.ViewModels.CourseTitle.CourseTitleSetupViewModel>

<table id="CourseTitle-grid" class="table table-striped  table-bordered table-sm table-hover table-common">
    <thead class="row-border">
        <tr class="table row-border">
            <th class="text-center text-middle" style="width: 10%;">
                Select <br /> <input type="checkbox" id="CourseTitle-check-all" />
            </th>
            <th class="text-center text-middle" style="width: 10%;"> Id</th>
            <th class="text-center text-middle" style="width: 60%;"> Course Name</th>
            <th class="text-center text-middle" style="width: 20%;"> Short Name</th>

        </tr>
    </thead>
    <tbody>

        @if (Model == null || !Model.Any())
        {
            <tr class="text-center text-middle">
                <td colspan="8">No Data Available.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model.OrderByDescending(x => x.CourseCode))
            {
                <tr>
                    <td class="text-center">
                        <input type="checkbox" class="text-center text-middle checkBox" data-id="@item.CourseCode" value="@item.CourseCode" />
                    </td>
                    <td>
                        <a href="#" class='btn js-CourseTitle-edit'
                           style="text-decoration: underline; color: rebeccapurple;"
                           data-id="@item.CourseCode" title="Edit">
                            @item.CourseCode
                        </a>
                    </td>

                    <td class="text-center text-middle">@item.CourseName</td>
                    <td class="text-center text-middle">@item.ShortName</td>

                </tr>
            }
        }


    </tbody>
</table>