<div class="card mt-3">
    <div class="card-header">
        <h5 class="mb-0">Manual Entry Approval Form</h5>
    </div>
    <div class="card-body">
        <div class="form-group">
            <label for="remarks">Remarks</label>
            <textarea id="remarks" class="form-control" rows="3" placeholder="Enter approval remarks..."></textarea>
        </div>
        <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-secondary" id="js-manual-approval-clear">
                <i class="fas fa-times"></i> Clear
            </button>
            <button type="button" class="btn btn-success js-manual-approval-save">
                <i class="fas fa-check"></i> Approve Selected
            </button>
        </div>
    </div>
</div>