                                                           placeholder="Search contacts...">
                                                </div>
                                                <table class="table table-bordered table-sm mb-0 ">
                                                    <thead>
                                                        <tr>
                                                            <th style="width: 40px;" class="text-center text-middle">
                                                                Select
                                                                <input type="checkbox" class="text-center text-middle" id="selectAllCP" title="Select All">
                                                            </th>
                                                            <th class="text-center text-middle" style="width: 150px;">Name</th>
                                                            <th class="text-center text-middle" style="width: 150px;">Designation</th>
                                                            <th class="text-center text-middle" style="width: 120px;">Phone</th>
                                                            <th class="text-center text-middle" style="width: 170px;">Email</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody id="contactPersonTableBody">
                                                        <!-- Data loaded via JavaScript -->
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                        <!-- Add Button -->
                                        <button type="button"
                                                class="btn btn-outline-secondary col-1 js-quick-add"
                                                data-url="@Url.Action("Index", "ContactPersonInfo")"
                                                data-target="#ContatPerson1"
                                                data-reload-url="@Url.Action("GetContactPersonInfo", "Cascading")"
                                                data-title="Contact Person Info">
                                            <i class="fa fa-plus"></i>
                                        </button>

                                    </div>

                                </div>
                            </div>
                            <div class="col-12 col-md-6"> </div>
                        </div>

                        <div class="bank-account-section">
                            <fieldset class="bank-fieldset">
                                <legend style="width: 167px;">Bank Account Info</legend>
                                <input type="hidden" id="Sbaid" name="name" value="0" />
                                <div class="bank-form-row">

                                    <div class="form-group-con">
                                        <label asp-for="SupplierBankId">Bank Name</label>
                                        <div class="input-group">
                                            <select asp-for="SupplierBankId" data-placeholder="--Select Supplier Bank--" asp-items="ViewBag.SupplierBankDD as SelectList" class="form-control form-select-sm selectpickerSup" tabindex="21">
                                                <option value=""></option>
                                            </select>
                                            <button type="button" class="btn btn-outline-secondary ms-2 js-quick-add input-group-textc"
                                                    data-url="@Url.Action("Index", "BankInformations")"
                                                    data-target="#SupplierBankId"
                                                    data-reload-url="@Url.Action("GetBank", "Cascading")"
                                                    data-title="Supplier Bank">
                                                <i class="fa fa-plus"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="form-group-con">
                                        <label asp-for="SupplierBankBranchId">Branch</label>
                                        <div class="input-group">
                                            <select asp-for="SupplierBankBranchId" data-placeholder="--Select Supplier Branch--" asp-items="ViewBag.SupplierBankBranchDD as SelectList" class="form-control form-select-sm selectpickerSup" tabindex="22">
                                                <option value="">--Select Branch--</option>
                                            </select>
                                            <button type="button" class="btn btn-outline-secondary ms-2 js-quick-add input-group-textc"
                                                    data-url="@Url.Action("Index", "BankBranchInformations")"
                                                    data-target="#SupplierBankBranchId"
                                                    data-reload-url="@Url.Action("GetBankBranch", "Cascading")"
                                                    data-title="Supplier Bank Branch">
                                                <i class="fa fa-plus"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <div class="form-group-con">
                                        <label for="AccountNo">Account No.</label>
                                        <input type="text" asp-for="AccountNo" class="form-control form-control-sm" tabindex="23" placeholder="Enter Bank Account Number">
                                    </div>

                                    <div class="form-actions pt-4">
                                        <button type="button" id="BankAccountInfoSaveBtn" title="Save">
                                            <i class="fa fa-save"></i>
                                        </button>
                                        <button type="button" id="BankAccountInfoDeleteBtn" title="Delete">
                                            <i class="fas fa-trash" style="font-size: 17px;"></i>
                                        </button>

                                        <button type="button" id="BankAccountInfoRefreshBtn" title="Refresh">
                                            <i class="fa fa-sync"></i>
                                        </button>
                                    </div>

                                </div>

                                <div class="SupplierBankAccountTemp-grid-container">
                                    @await Html.PartialAsync("_GridBankAccountInfo", Model.bangkInfo)
                                </div>

                            </fieldset>
                        </div>

                        <div class="row py-2">
                            <div class="col-12 col-md-6">
                                <div class="row">
                                    <div class="col-12 col-md-4 text-right p-0">
                                        <label asp-for="OpeningBalance" class="form-label col-form-label-sm d-flex justify-content-end" style="white-space:nowrap;">Opening Balance</label>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div class="row">
                                            <div class="col-12 col-md-6">
                                                <input asp-for="OpeningBalance" class="form-control form-control-sm" type="number" placeholder="Enter Opening Balance" tabindex="24" />
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <div class="input-group">
                                                    <!-- Dropdown -->
                                                    <select asp-for="Optype" data-placeholder="-- Select Optype --"
                                                            class="form-control form-control-sm selectpickerSup js-"
                                                            tabindex="25"
                                                            asp-items="@ViewBag.OptypeDD as SelectList">
                                                        <option value=""></option> <!-- Default option -->
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="row">
                                    <div class="col-12 col-md-4 text-right p-0">
                                        <label asp-for="SalesPersonId" class="form-label col-form-label-sm d-flex justify-content-end hannan" style="white-space:nowrap;">Sales Person</label>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <div class="input-group">
                                            <!-- Dropdown -->
                                            <select asp-for="SalesPersonId" data-placeholder="-- Select Sales Person --"
                                                    class="form-control form-control-sm selectpickerSup js-"
                                                    tabindex="26"
                                                    asp-items="@ViewBag.SalesPersonDD as SelectList">
                                                <option value=""></option> <!-- Default option -->
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row pe-2">
                            <div class="col-12 ">
                                <div class="row">
                                    <div class="col-12 col-md-2 text-right p-0">
                                        <label asp-for="Remarks" class="form-label col-form-label-sm d-flex justify-content-end hannan" style="white-space:nowrap;">Remarks </label>
                                    </div>
                                    <div class="col-12 col-md-9">
                                        <div class="input-wrapper">
                                            <textarea asp-for="Remarks" class="form-control form-control-sm" rows="1" placeholder="Enter Remarks" tabindex="27"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row py-2">
                            <div class="col-12 col-md-6">
                                <div class="row">
                                    <div class="col-12 col-md-4 text-right p-0">
                                        <label asp-for="Active" class="form-label col-form-label-sm d-flex justify-content-end hannan" style="white-space:nowrap;">Active</label>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <div class="input-group">
                                            <!-- Dropdown -->
                                            <select asp-for="Active" data-placeholder="-- Select Sales Person --"
                                                    class="form-control form-control-sm selectpickerSup js-"
                                                    tabindex="28"
                                                    asp-items="@ViewBag.ActiveDD as SelectList">
                                                <option value=""></option> <!-- Default option -->
                                            </select>
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                            </div>
                        </div>

                        <hr id="sectionBreak" />

                        <div class=" row" id="LdateModifyHide">

                            <div class="col-6 d-flex align-items-center justify-content-between">
                                <label class="col-6 form-label col-form-label-sm d-flex justify-content-end">Creation Date:</label>
                                <div class="col-6">
                                    <span id="creationDateSpan">
                                        @(Model.Ldate.HasValue? Model.Ldate?.ToString("dd/MM/yyyy hh:mm tt") : "")
                                    </span>
                                </div>
                            </div>

                            <div class="col-6 d-flex align-items-center justify-content-between">
                                <label class="col-6 form-label col-form-label-sm d-flex justify-content-end">Last Update Date:</label>
                                <div class="col-6">
                                    <span id="modifyDateSpan">
                                        @(Model.ModifyDate.HasValue? Model.ModifyDate?.ToString("dd/MM/yyyy hh:mm tt") : "")
                                    </span>
                                </div>
                            </div>

                        </div>

                        <div class="row no-print mt-3">
                            <div class="col-12">
                                <button type="button" class="btn btn-outline-success btn-common btn-circle float-right js-SupplierInformation-save" data-id="@Model.SupplierId">
                                    <i class="fas fa-save"></i> Save
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
