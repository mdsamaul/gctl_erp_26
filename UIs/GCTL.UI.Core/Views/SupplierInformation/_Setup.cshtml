@model GCTL.Core.ViewModels.SupplierInformation.SupplierInformationSetupViewModel

<style>

    .form-group-con label {
        margin-right: .5rem;
        min-width: 150px;
    }

    .form-group-con input {
        flex: 1;
        max-width: 100%;
    }

    .input-wrapper {
        position: relative;
        width: 100%;
    }

    .input-wrapper span {
        width: 100%;
    }

    .required::after {
        content: '*';
        color: red;
        margin-left: 5px;
    }

    .bank-fieldset {
        border: 2px solid #ccc;
        border-radius: 8px;
        padding: 15px;
        margin: 20px 0;
        background: #fff;
    }

    .bank-fieldset legend {
        font-weight: bold;
        font-size: 1.1rem;
        padding: 0 10px;
    }

    .bank-form-row {
        display: flex;
        align-items: flex-end;
        gap: 15px;
        flex-wrap: wrap;
    }

    .form-group-con {
        display: flex;
        flex-direction: column;
        min-width: 24vw;
    }

    .form-group-con label {
        font-size: 0.9rem;
        margin-bottom: 4px;
    }

    .input-with-icon {
        position: relative;
    }

    .input-with-icon select {
        width: 100%;
        padding-right: 30px;
        padding-left: 8px;
        height: 34px;
        border: 1px solid #ccc;
        border-radius: 5px;
    }

    .input-with-icon .add-icon {
        position: absolute;
        right: 8px;
        top: 6px;
        font-size: 18px;
        color: #007bff;
        cursor: pointer;
    }

    #accountNo {
        height: 34px;
        border: 1px solid #ccc;
        border-radius: 5px;
        padding: 0 8px;
    }

    .form-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: auto;
    }

   .form-actions button {
       border: none;
       background: transparent;
       cursor: pointer;
       font-size: 18px;
       color: #555;
       transition: color 0.2s;
   }

   .form-actions button:hover {
       color: #007bff;
   }

    /* Container for select and button */
    .input-group {
        display: flex;
        align-items: center;
        border: 1px solid #ccc;
        border-radius: 5px;
        overflow: hidden;
    }

     /* Dropdown styling */
     .input-group select {
         flex: 1;
         border: none;
         padding: 6px 8px;
         height: 34px;
         outline: none;
     }

     /* Button styling */
     .input-group .add-btn {
         background-color: #fff;
         color: #333;
         border: none;
         padding: 0 12px;
         height: 34px;
         cursor: pointer;
         font-size: 18px;
         border: 1px solid #ddd;
         transition: background 0.3s;
     }

     .input-group .add-btn:hover {
         background-color: #333;
         color: #fff;
     }

    .select2-selection--single {
        border-top-width: 0px !important;
        border-bottom-width: 0px !important;
        border-right-width: 0px !important;
        border-left-width: 0px !important;
    }

    .multi-select-dropdown {
        position: relative;
    }

    .multi-select-button {
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: white;
        border: 1px solid #ced4da;
        border-radius: 0.375rem;
        padding: 0.375rem 0.75rem;
        cursor: pointer;
        min-height: 31px;
    }

    .multi-select-button:hover {
        border-color: #86b7fe;
    }

    .multi-select-dropdown-menu {
        position: absolute;
        top: 100%;
        left: 0;
        z-index: 1000;
        background: white;
        border: 1px solid #ced4da;
        border-radius: 0.375rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
        max-height: 300px;
        overflow-y: auto;
        overflow-x: auto;
        min-width: 100%;
        width: max-content;
        max-width: 90vw;
    }

    .contact-table {
        width: 100%;
        margin: 0;
        min-width: 700px;
        table-layout: auto;
    }

     .contact-table th {
         background-color: #f8f9fa;
         font-weight: 600;
         font-size: 12px;
         padding: 8px 10px;
         border-bottom: 2px solid #dee2e6;
         position: sticky;
         top: 0;
         z-index: 10; 
         white-space: nowrap;
         text-align: left;
     }

     .contact-table td {
         padding: 8px 10px;
         font-size: 12px;
         border-bottom: 1px solid #f0f0f0;
         white-space: nowrap;
         overflow: hidden;
         text-overflow: ellipsis;
         max-width: 0;
     }

    .contact-table td:first-child {
        width: 40px;
        max-width: 40px;
        text-align: center;
    }

    .contact-table td:nth-child(2) {
        min-width: 120px;
        max-width: 200px;
    }

    .contact-table td:nth-child(3) {
        min-width: 120px;
        max-width: 200px;
    }

    .contact-table td:nth-child(4) {
        min-width: 100px;
        max-width: 120px;
    }

    .contact-table td:nth-child(5) {
        min-width: 150px;
        max-width: 200px;
    }

    .contact-table tbody tr:hover {
        background-color: #f8f9fa;
    }

    .contact-checkbox {
        margin: 0;
    }

    .selected-count {
        color: #6c757d;
        font-size: 14px;
    }

    .clear-selection {
        background: none;
        border: none;
        color: #6c757d;
        cursor: pointer;
        padding: 2px;
    }

    .clear-selection:hover {
        color: #dc3545;
    }

    .loading-spinner {
        text-align: center;
        padding: 20px;
        color: #6c757d;
    }

    .multi-select-dropdown-menu.show-below {
        top: 100%;
        margin-top: 2px;
    }

    .multi-select-dropdown-menu.show-above {
        bottom: 100%;
        margin-bottom: 2px;
        top: auto;
    }

    .multi-select-dropdown-menu.show-above .contact-table thead th {
        position: sticky;
        bottom: 0;
        top: auto;
    }

    .contact-table thead th {
        position: sticky;
        top: 0;
        z-index: 10;
        background-color: #f8f9fa;
        border-bottom: 2px solid #dee2e6;
    }

</style>

