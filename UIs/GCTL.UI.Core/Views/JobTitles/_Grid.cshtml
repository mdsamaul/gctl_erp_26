@model List<GCTL.Core.ViewModels.JobTitles.JobTitleSetupViewModel>


<table id="JobTitle-grid" class="table table-striped  table-bordered table-sm table-hover table-common">

        <thead class="row-border">
            <tr class="table row-border">
                <th class="text-center text-middle" style="width: 10%;">
                    Select <br />
                    <input type="checkbox" id="JobTitle-check-all" />
                </th>
                <th class="text-center text-middle" style="width: 8%;"> ID</th>
                <th class="text-center text-middle" style="width: 82%;">Job Title</th>
            </tr>
        </thead>
        <tbody>

            @if (Model == null || !Model.Any())
            {
                <tr class="text-center text-middle">
                    <td colspan="8">No Job Title Available.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.OrderByDescending(x => x.JobTitleId))
                {
                    <tr>
                        <td class="text-center">
                            <input type="checkbox" class="text-center text-middle checkBox" data-id="@item.JobTitleId" value="@item.JobTitleId" />
                        </td>
                        <td>
                            <a href="#" class='btn js-JobTitle-edit'
                               style="text-decoration: underline; color: rebeccapurple;"
                               data-id="@item.JobTitleId" title="Edit">
                                @item.JobTitleId
                            </a>
                        </td>

                        <td class="text-center text-middle">@item.JobTitle</td>



                    </tr>
                }
            }


        </tbody>
    </table>
