<!-- Flatpickr CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="~/js/pages/HRM_NOCEntry.js"></script>

    <script type="text/javascript">
        // ── Sync Education NOC ID box with Travel NOC ID box ─────────────
        $(document).on("input", "#iNocId", function () {
            $("#iNocId_edu").val($(this).val());
        });

        // ── Sync Remarks between sections ────────────────────────────────
        $(document).on("input", "#iRemarks", function () {
            $("#iRemarks_edu").val($(this).val());
        });
        $(document).on("input", "#iRemarks_edu", function () {
            $("#iRemarks").val($(this).val());
        });

        // ── Init plugin ──────────────────────────────────────────────────
        var _nocEntry = $.HRM_NOCEntry({
            baseUrl: '@Url.Action("", "HRM_NOCEntry")'
        });

        // ── If editing an existing record pass AutoId from query-string ──
        (function () {
            var params = new URLSearchParams(window.location.search);
            var autoId = params.get("autoId");
            if (autoId) { _nocEntry.loadRecord(Number(autoId)); }
        })();
    </script>
}
