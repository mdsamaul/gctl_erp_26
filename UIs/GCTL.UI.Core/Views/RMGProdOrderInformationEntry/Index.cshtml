    }

    #stickyHeader {
        transition: transform 0.3s ease, opacity 0.3s ease;
    }

        #stickyHeader{
            background:#fff;
        }
        #stickyHeader.hide-header {
            transform: translateY(-100%);
            opacity: 0;
        }

    .select2-selection__clear {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
    }
    
    .form-container {
        display: grid;
        grid-template-columns: 75% 25%;
        gap: 0;
        max-width: 100%;
        margin: 0 auto;
    }

    .left-panel {
        border: 1px solid #dee2e6;
        border-top: 0;
        padding: 15px;
        margin : 16px;
        padding-top: 0px;
        margin-top: 0px;
    }

