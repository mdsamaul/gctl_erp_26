            grid-template-columns: 16.5% 1fr;
        }

    .radio-group {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 5px;
    }

    .radio-item {
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 1fr 1fr;
        /* cursor:pointer; */
    }

    .radio-item > input+label {
       
