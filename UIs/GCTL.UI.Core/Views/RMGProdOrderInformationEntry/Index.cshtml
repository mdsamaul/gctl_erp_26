        border: 1px solid #e0e0e0;
    }

        .icon-group .toolbar-btn {
            border: 1px solid transparent;
            background-color: transparent;
        }

            .icon-group .toolbar-btn:hover {
                background-color: #fff;
                border-color: #ccc;
            }

