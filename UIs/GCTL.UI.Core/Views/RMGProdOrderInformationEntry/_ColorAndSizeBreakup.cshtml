@model GCTL.UI.Core.ViewModels.RMGProdOrderInformationEntry.RMGProdOrderInformationEntryViewModel

<div class="form-container">
    <div class="left-panel">
        <div class="card container mt-2">
            <input type="hidden" asp-for="TempColorSizeBreakupDto.TC" value="0" class="form-control">
            <div class="form-grid-color pt-2">
                <!-- Row 1 -->
                <div class="form-row">
                    <label class="col-form-label">P.O No</label>
                    <div class="input-group input-group-sm">
                        <select class="form-select searchAbleSelectMulti" id="TempColorSizeBreakupDtoPONo" asp-items="ViewBag.ProdOrderDetailsRepoList as SelectList">
                            <option value="" disabled hidden selected>Select P.O</option>
                        </select>
                    </div>
                </div>

                <div class="form-row">
                    <label class="col-form-label">Style</label>
                    <div class="input-group input-group-sm">
                        <select class="form-select searchAbleSelectMulti" id="TempColorSizeBreakupDtoStyle" asp-items="ViewBag.styleList as SelectList">
                            <option value="" disabled hidden selected>Select Style</option>
                        </select>
                    </div>
                </div>

                <!-- Row 2 -->
                <div class="form-row">
                    <label class="col-form-label">Integra Job No</label>
                    <div class="input-group input-group-sm">
                        <select class="form-select searchAbleSelectMulti"  asp-for="TempColorSizeBreakupDto.IntegraJOBNo"  asp-items="ViewBag.intregraJobNoList as SelectList">
                            <option value="" disabled hidden selected>Select Intregra Job No</option>
                        </select>                       
                    </div>
                </div>
            </div>

            <div class="form-grid-color-dt pt-2">
                <!-- Row 1 -->
                <div class="form-row">
                    <label class="col-form-label">Color</label>
                    <div class="input-group input-group-sm">
                        <select class="form-select form-control-sm searchAbleSelectMulti" asp-for="TempColorSizeBreakupDto.ColorId" multiple="multiple" asp-items="ViewBag.colorRepoList as SelectList">
                            @* <option value="" disabled hidden>Select Color</option> *@
                        </select>
                        @* <button type="button" class="btn btn-light border">
                            <i class="fa fa-plus" style="color: #8d8d8d;"></i>
                        </button> *@

                        <button type="button"
                                class="btn btn-light border js-quick-add"
                                data-url="@Url.Action("Index", "ColorInformation")"
                                data-target="#TempColorSizeBreakupDto_ColorId"
                                data-reload-url="@Url.Action("GetBuyerCompany", "Cascading")"
                                data-title="Color">
                            <i class="fa fa-plus" style="color: #8d8d8d;"></i>
                        </button>
                    </div>
                </div>

                <div class="form-row">
                    <label class="col-form-label">Size</label>
                    <div class="input-group input-group-sm">
                        <select class="form-select form-select-sm searchAbleSelectMulti" asp-for="TempColorSizeBreakupDto.SizeId" multiple="multiple" asp-items=" ViewBag.sizeRepoList as SelectList">
                            @* <option value="" disabled hidden>Select Size</option> *@
                        </select>
                        <button type="button"
                                class="btn btn-light border js-quick-add"
                                data-url="@Url.Action("Index", "SizeInformation")"
                                data-target="#TempColorSizeBreakupDto_SizeId"
                                data-reload-url="@Url.Action("GetBuyerCompany", "Cascading")"
                                data-title="Size">
                            <i class="fa fa-plus" style="color: #8d8d8d;"></i>
                        </button>
                    </div>
                </div>

                <!-- Row 2 -->
                <div class="form-row">
                    <label class="col-form-label">UOM</label>
                    <div class="input-group input-group-sm">
                        <select class="form-select form-control-sm searchAbleSelectMulti" asp-for="TempColorSizeBreakupDto.UnitTypeId" asp-items="ViewBag.unitTypeList as SelectList">
                            <option value="" disabled hidden selected>select Unit Type</option>
                        </select>
                        <button type="button"
                                class="btn btn-light border js-quick-add"
                                data-url="@Url.Action("Index", "RMG_Prod_Def_UnitType")"
                                data-target="#TempColorSizeBreakupDto_UnitTypeId"
                                data-reload-url="@Url.Action("GetBuyerCompany", "Cascading")"
                                data-title="Unit Type">
                            <i class="fa fa-plus" style="color: #8d8d8d;"></i>
                        </button>
                    </div>
                </div>
                <div class="form-row">
                    <label class="col-form-label">Remarks</label>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control form-control-sm" asp-for="TempColorSizeBreakupDto.Remarks"/>
                    </div>
                </div>

                <!-- Row 2 -->
                @* <div class="" style="justify-content: end; gap: 2px; display: flex;">
                    <button class="toolbar-btn btn-sm icon-only" title="Settings">
                        <i class="fas fa-cog"></i>
                    </button>
                    <button class="toolbar-btn btn-sm icon-only" title="Download">
                        <i class="fas fa-download"></i>
                    </button>
                    <button class="toolbar-btn btn-sm icon-only" title="Share">
                        <i class="fas fa-share-alt"></i>
                    </button>
                </div> *@
                <div class="d-flex justify-content-end">
                    <div class="btn-group">
                        <button type="button" class="btn btn-sm btn-default success-btn" id="colorAndBreakupSaveBtn">
                            <i class="fa fa-save"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-default danger-btn">
                            <i class="fa fa-trash"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-default primary-btn">
                            <i class="fa fa-eraser"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="btn-toolbar d-flex justify-content-end my-2">
                <button type="button" class="btn btn-default success-btn border border-success color-breakup-temp-btn">
                    <i class="fa fa-save">&nbsp;</i>Save
                </button>
          </div> 

          <div>
                <div class="table-responsive border">
                    <table id="mainOrderGroupGrid" class="table table-striped text-center table-sm table-common">
                        <thead>
                            <tr>
                                <th class="text-center align-middle">Breck Up</th>
                                <th class="text-center align-middle">Color</th>
                                <th class="text-center align-middle">Size</th>
                                <th class="text-center align-middle">Quantity</th>
                                <th class="text-center align-middle">Unit Type</th>
                                <th class="text-center align-middle">Remarks</th>
                                <th class="text-center align-middle">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                           @*  <tr>
                                <td class="text-center align-middle">0000052001_00125</td>
                                <td class="text-center align-middle">
                                    <select class="form-select form-select-sm">
                                        <option value=""></option>
                                    </select>
                                </td>
                                <td class="text-center align-middle">
                                    <select class="form-select form-select-sm">
                                        <option value=""></option>
                                    </select>
                                </td>
                                <td class="text-center align-middle">
                                    <input type="number" class="form-control form-control-sm" />
                                </td>
                                <td class="text-center align-middle">
                                    <select class="form-select form-select-sm">
                                        <option value=""></option>
                                    </select>
                                </td>
                                <td class="text-center align-middle">
                                    <textarea rows="1" class="form-control form-control-sm" ></textarea>
                                </td>
                                <td class="text-center align-middle">
                                    <button type="button" class="btn btn-sm btn-default danger-btn">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </td>
                            </tr> *@
                        </tbody>
                    </table>
                </div>
          </div>
            <div>
                <div class="d-flex pt-2" style="justify-content: end;">
                    <!-- Row 1 -->

                    <div class="col-5 d-flex justify-end " style="justify-content: end; align-items: center;">
                        <label class="col-3 p-0 text-right">Total Order: </label>
                        <div class="col-6">
                            <input class="form-control form-control-sm" id="Color-Size-Breckup-total" type="text">
                        </div>
                    </div>

                    <!-- Row 2 -->
                    <div class="col-6 d-flex " style="align-items: center;">
                        <label class="col-5 p-0" style="text-align: end;">Color &amp; Size Breckup: </label>
                        <div class="col-5">
                            <input class="form-control form-control-sm" id="Color-Size-Breckup-input" type="number">
                        </div>
                    </div>
                </div>
                <div class="d-flex py-2">
                    <!-- Row 1 -->
                    <div class="d-flex d-flex align-items-center">
                        <label class="col-5 p-0 text-end">Packaging Quantity: </label>
                        <div class="col-6">
                            <input class="form-control form-control-sm" type="text">
                        </div>
                        <label class="col-1 p-0">pcs</label>
                    </div>

                    <div class="" style="display: flex;align-items: center;">

                        <div class="col-8">
                            <input class="form-control form-control-sm" type="text">
                        </div>
                        <label class="col-4 p-0">Multi pack</label>
                    </div>

                    <!-- Row 2 -->
                    <div class="d-flex align-items-center">

                        <div class="col-8">
                            <input class="form-control form-control-sm" type="text">
                        </div>
                        <label class="col-4 p-0">Pre pack</label>
                    </div>
                </div>
            </div>
        </div>

       @*  <div class="card py-2">
           <partial name="_ColorAndBreakupGrid"></partial>
        </div> *@
       

    </div>

    <div class="right-panel">
        <div class="right-panel">
            <div class="card image-card">
                @* <img src="https://dlh.kalteng.go.id/ppid/public/upload/gambar/1688945661_af46a31b900485b21bce.png" class="card-img-top" alt="No Image"> *@
            </div>
        </div>
    </div>
</div>


