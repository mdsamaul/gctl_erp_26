@model GCTL.UI.Core.ViewModels.JobCardReport.JobCardReportViewModel
@{
    Model.Breadcrumb = "JobCardReport";
    Model.PageTitle = "Attendance /Job Card Report";
}

<style>
    .headerToobar {
        background: linear-gradient(to right, #fff, #fff);
        box-shadow: 3px 0 6px rgba(0,0,0,0.2);
        border-radius: 0px 11px 11px 0px;
    }

    #btnPreviewPdf, #downloadReport {
        transition: background-color .3s, color .3s, border-color .3s;
        min-width: 120px;
    }

        #btnPreviewPdf:hover, #downloadReport:hover {
            background-color: rgba(173,255,47,.2) !important;
            color: #1e90ff !important;
            border-color: #1e90ff !important;
            box-shadow: 0 4px 10px rgba(30,144,255,.5) !important;
        }

            #btnPreviewPdf:hover i, #downloadReport:hover i {
                transform: scale(1.3);
            }

        #btnPreviewPdf i, #btnPreviewPdf span,
        #downloadReport i, #downloadReport span {
            transition: transform .3s;
            display: inline-block;
        }

    .dropdown-wrapper .btn-group {
        width: 100% !important;
        display: block !important;
    }

    .dropdown-wrapper .multiselect {
        width: 100% !important;
        border: 1px solid #ced4da !important;
        border-radius: 4px !important;
        background: #fff !important;
        padding: 6px 8px !important;
        font-size: 13px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        cursor: pointer !important;
    }

    .multiselect-container.dropdown-menu {
        border-radius: 4px !important;
        box-shadow: 0 4px 12px rgba(0,0,0,.15);
        font-size: 13px;
        margin-top: 1px !important;
        max-height: 250px !important;
        overflow-y: auto !important;
        width: 100% !important;
    }

    @@media (min-width: 1200px) and (max-width: 1400px) {
        .dropdown-wrapper .multiselect {
            padding: 3px 6px !important;
            font-size: 12px !important;
        }

        .multiselect-container.dropdown-menu {
            font-size: 12px;
        }

        label.col-3.text-right {
            font-size: 13px;
            padding-right: 2px !important;
        }

        .row.align-items-center > label.col-3 {
            flex: 0 0 25%;
            max-width: 25%;
        }

        .row.align-items-center > .col-9.col-md-7 {
            flex: 0 0 70%;
            max-width: 70%;
            padding-left: 4px !important;
        }

        .form-control.form-control-sm {
            font-size: 12px;
            padding: 3px 6px;
            height: calc(1.4em + 0.5rem + 2px);
        }

        #btnPreviewPdf, #downloadReport {
            min-width: 90px;
            min-height: 28px;
            font-size: 11px;
            padding: 2px 6px;
        }

        h6.pt-3.px-3.pb-0 {
            font-size: 14px;
            padding-top: 8px !important;
        }

        .export-text {
            font-size: 12px !important;
        }

        .right-btn-margin {
            margin-right: -6px !important;
        }
    }

    @@media (min-width: 1401px) {
        .right-btn-margin {
            margin-right: 25px !important;
        }
    }
</style>

<!-- Page Header -->
<div class="container-fluid">
    <partial name="_PageHeader" model="Model" />
</div>
<input type="hidden" id="hdnAccessCode" value="@(ViewBag.AccessCode ?? "")" />
<section class="content consistent-look mx-2">
    <div class="card border">

        <!-- Toolbar -->
        <div class="card-header py-1">
            <partial name="_Toolbars"
                     model="new ToobarModel() { Title = Model.Breadcrumb, Code = Model.Code, Name = Model.Setup.CompanyCode }" />
        </div>

        <!-- Filter Panel -->
        <div class="card-body border p-0">
            <div>
                <div class="col-12 col-md-5">
                    <h6 class="pt-3 px-3 pb-0 font-weight-bold fs-6 mb-0">Search By:</h6>
                    <div class="d-flex"><hr class="m-0 p-0 w-100"></div>
                </div>

                <div class="col-12 col-md-11 mx-auto dropdown-wrapper">
                    <div class="row pb-2">

                        <!-- Company -->
                        <div class="col-12 col-md-12 py-1">
                            <div class="row align-items-center">
                                <label class="col-12 col-md-2 text-md-right mb-0" style="padding-right:0;">Company</label>
                                <div class="col-12 col-md-3" style="padding-left:5px;">
                                    <select id="companySelect" class="form-control form-control-sm gc-multiselect-load-data" multiple></select>
                                </div>
                            </div>
                        </div>

                        <!-- Employee -->
                        <div class="col-12 col-md-12 py-1">
                            <div class="row align-items-center">
                                <label class="col-12 col-md-2 text-md-right mb-0" style="padding-right:0;">Employee</label>
                                <div class="col-12 col-md-3" style="padding-left:5px;">
                                    <select id="employeeSelect" class="form-control form-control-sm gc-multiselect-load-data" multiple></select>
                                </div>
                            </div>
                        </div>

                        <!-- Dates (From Date & To Date) -->
                        <div class="col-12 col-md-12 py-1">
                            <div class="row align-items-center">
                                <label class="col-12 col-md-2 text-md-right mb-0" style="padding-right:0;">From Date</label>
                                <div class="col-12 col-md-3" style="padding-left:5px;">
                                    <input type="text" id="fromDateSelect"
                                           class="form-control form-control-sm"
                                           placeholder="dd/MM/yyyy" />
                                </div>

                                <label class="col-12 col-md-1 text-md-right mb-0 px-0">To Date</label>
                                <div class="col-12 col-md-3" style="padding-left:5px;">
                                    <input type="text" id="toDateSelect"
                                           class="form-control form-control-sm"
                                           placeholder="dd/MM/yyyy" />
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-12 col-md-5">
                <h6 class="pt-3 px-3 pb-0 font-weight-bold fs-6 mb-0">Report Option:</h6>
                <div class="d-flex"><hr class="m-0 p-0 w-100"></div>
            </div>

            <div class="col-12 col-md-11 mx-auto dropdown-wrapper">
                <div class="row pb-2">
                    <!-- Export Report Format -->
                    <div class="col-12 col-md-12 py-1">
                        <div class="row align-items-center">
                            <label class="col-12 col-md-2 text-md-right mb-0 export-text" style="padding-right:0;">Export Report Format</label>
                            <div class="col-12 col-md-3" style="padding-left:5px;">
                                <select id="reportFormatSelect" class="form-control form-control-sm">
                                    @* <option value="">-- Select Export Report Format --</option> *@
                                    <option value="downloadPdf">PDF</option>
                                    <option value="downloadExcel">Excel</option>
                                    <option value="downloadCsv">CSV</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="col-12 col-md-9 py-2">
                        <div class="row justify-content-end align-items-center px-0 mx-0 right-btn-margin">
                            <div class="pr-2">
                                <button id="downloadReport"
                                        class="btn btn-sm common-btn btn-outline-secondary">
                                    <i class="fas fa-print"></i>
                                    <span>Report Export</span>
                                </button>
                            </div>
                            <div class="pl-1">
                                <button id="btnPreviewPdf"
                                        class="btn btn-sm btn-outline-secondary common-btn px-4">
                                    <i class="fas fa-print" title="Preview"></i>
                                    <span>Preview</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- PDF Preview Container -->
        <div class="container-fluid mt-3 mb-4">
            <div id="pdf-preview-container"
                 style="width:100%; height:100vh; border:1px solid #ccc;
                display:none; border-radius:5px;
                box-shadow:0 2px 10px rgba(0,0,0,.1);">
            </div>
        </div>

    </div>
</section>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-multiselect/1.1.2/css/bootstrap-multiselect.min.css">
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-multiselect/1.1.2/js/bootstrap-multiselect.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <script src="~/js/pages/JobCardReport.js"></script>

    <script type="text/javascript">
        $(function () {
            $.jobCardReport({
                baseUrl: '@Url.Action("Index", "JobCardReport")',
                load: async function () {
                    bindRemoteMultiselect("#companySelect", "/GcAccessFilter/companies", "Select Company", "company");
                    bindRemoteMultiselect("#employeeSelect", "/GcAccessFilter/employees", "Select Employee", null);

                    var accessCode = $("#hdnAccessCode").val();
                    var isReadonly = accessCode === "0005";

                    ms_BindCascade();

                    if (isReadonly) {
                        ms_InitializeMultiselects(null, null, true);
                        await ms_ApplyAccessCodeToAll(accessCode);
                    } else {
                        ms_InitializeMultiselects();
                        ms_Reset("#companySelect");
                        await ms_LoadNext("#companySelect", "...");
                        await ms_AutoSelectCompany("001");
                    }
                }
            });
        });
    </script>
}
