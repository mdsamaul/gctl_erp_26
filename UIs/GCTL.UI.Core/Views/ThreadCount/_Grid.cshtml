@model List<GCTL.Core.ViewModels.ThreadCount.ThreadCountSetupViewModel>

<table id="ThreadCount-grid" class="table table-striped  table-bordered table-sm table-hover table-common">
    <thead class="row-border">
        <tr class="table row-border">
            <th class="text-center text-middle" style="width: 10%;">
                Select <br /> <input type="checkbox" id="ThreadCount-check-all" />
            </th>
            <th class="text-center text-middle" style="width: 8%;">ID</th>
            <th class="text-center text-middle" style="width: 55%;"> Thread Count Name</th>
            <th class="text-center text-middle" style="width: 27%;">Short Name</th>

        </tr>
    </thead>
    <tbody>

        @if (Model == null || !Model.Any())
        {
            <tr class="text-center text-middle">
            </tr>
        }
        else
        {
            @foreach (var item in Model.OrderByDescending(x => x.ThreadCountId))
            {
                <tr>
                    <td class="text-center">
                        <input type="checkbox" class="text-center text-middle checkBox" data-id="@item.ThreadCountId" value="@item.ThreadCountId" />
                    </td>
                    <td>
                        <a href="#" class='btn js-ThreadCount-edit'
                           style="text-decoration: underline; color: rebeccapurple;"
                           data-id="@item.ThreadCountId" title="Edit">
                            @item.ThreadCountId
                        </a>
                    </td>

                    <td class="text-center text-middle">@item.ThreadCountName</td>
                    <td class="text-center text-middle">@item.ShortName</td>

                </tr>
            }
        }

    </tbody>
</table>