@model List<GCTL.Core.ViewModels.HrmEmployeeEducations.HrmEmployeeEducationsSetupViewModel>

<div class="card">
    <div class="card-body">
        <table id="HrmEmployeeEducations-gridTT" class="table table-striped  table-bordered table-sm table-hover table-common">
            <thead class="row-border">
                <tr class="table row-border">
                    <th class="text-center text-middle">
                        Select <br /> <input type="checkbox" id="HrmEmployeeEducations-check-all" />
                    </th>
                    <th class="text-center text-middle"> Id</th>
                    <th class="text-center text-middle">Degree</th>
                    <th class="text-center text-middle">Title</th>
                    <th class="text-center text-middle">Institute</th>
                    <th class="text-center text-middle">Boad/Country</th>
                    <th class="text-center text-middle">Group</th>
                    <th class="text-center text-middle">Result</th>
                    <th class="text-center text-middle">CGPA</th>
                    <th class="text-center text-middle">Scale of</th>
                    <th class="text-center text-middle">Passing Year</th>
                    <th class="text-center text-middle">Duration</th>
                    <th class="text-center text-middle">Type</th>
                </tr>
            </thead>
            <tbody>

                @if (Model == null || !Model.Any())
                {
                    <tr class="text-center text-middle">
                        <td colspan="13">No Data Available.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.OrderByDescending(x => x.EmpEduCode))
                    {
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" class="text-center text-middle checkBox"  data-id="@item.EmpEduCode" value="@item.EmpEduCode" />
                            </td>
                            <td>
                                <a href="#" class='btn js-HrmEmployeeEducations-edit'
                                   style="text-decoration: underline; color: rebeccapurple;"
                                   data-id="@item.EmpEduCode" data-id2="@item.EmployeeId" title="Edit">
                                    @item.EmpEduCode
                                </a>
                            </td>
                            <td class="text-center text-middle">@item.DegreeName</td>
                            <td class="text-center text-middle">@item.ExamTitleName</td>
                            <td class="text-center text-middle">@item.InstituteName</td>
                            <td class="text-center text-middle">@item.BoardName</td>
                            <td class="text-center text-middle">@item.GroupName</td>
                            <td class="text-center text-middle">@item.ResultDivision</td>
                            <td class="text-center text-middle">@item.CgpaMarks</td>
                            <td class="text-center text-middle">@item.ScaleOf</td>
                            <td class="text-center text-middle">@item.YearofPasssing</td>
                            <td class="text-center text-middle">@item.Dueration</td>
                            <td class="text-center text-middle">@item.DuratioinType</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>