@model List<GCTL.Core.ViewModels.ProbationPeriodExtension.ProbationPeriodExtensionGetAll>
<div class="card">
    <div class="card-body">
        
        <table id="ProbationPeriodExtension-grid" class="table table-striped  table-bordered table-sm table-hover table-common">
            <thead class="row-border">
                <tr class="table row-border">
                    <th class="text-center text-middle" style="width: 4%;">
                        Select <br /> <input type="checkbox" id="ProbationPeriodExtension-check-all" />
                    </th>
                    <th class="text-center text-middle" style="width: 6%;"> ID</th>
                    <th class="text-center text-middle" style="width: 8%;">Employee ID</th>
                    <th class="text-center text-middle" style="width: 20%;">Name</th>
                    <th class="text-center text-middle" style="width: 10%;">Extended period</th>
                    <th class="text-center text-middle" style="width: 12%;">With Effect From</th>
                    <th class="text-center text-middle" style="width: 8%;">Extension Salary</th>
                    <th class="text-center text-middle" style="width: 12%;">Ref.Letter/ Ref.No</th>
                    <th class="text-center text-middle" style="width: 11%;">Ref.Letter Date</th>
                </tr>
            </thead>
            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr class="text-center text-middle">
                        <td colspan="9">No Data Available.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.OrderByDescending(x => x.Ppeid))
                    {
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" class="text-center text-middle checkBox" data-id="@item.Ppeid" value="@item.Ppeid" />
                            </td>
                            <td>
                                <a href="#" class='btn js-ProbationPeriodExtension-edit'
                                   style="text-decoration: underline; color: rebeccapurple;"
                                   data-id="@item.Ppeid" title="Edit">
                                    @item.Ppeid
                                </a>
                            </td>
                            <td class="text-center text-middle">@item.EmployeeId</td>
                            <td class="text-left text-middle">@item.EmployeeName</td>
                            <td class="text-center text-middle">@item.ExtendedPeriod</td>
                            <td class="text-center text-middle">@item.Wef</td>
                            <td class="text-center text-middle">@item.ExtensionSalary?.ToString("0")</td>
                            <td class="text-center text-middle">@item.RefLetterNo</td>
                            <td class="text-center text-middle">@item.RefLetterDate</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
  
</div>
