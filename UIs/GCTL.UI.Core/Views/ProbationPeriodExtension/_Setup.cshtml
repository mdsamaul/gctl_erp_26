@model GCTL.Core.ViewModels.ProbationPeriodExtension.ProbationPeriodExtensionSetupViewModel

<div style="padding-top:1px;">
    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>

    <div style="padding-top: 1px;">
        <div class="row">
            <div class="col-lg-12">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Ldate" />
                <input type="hidden" asp-for="ModifyDate" />
                <input type="hidden" asp-for="AutoId" />

                <div class="card">                    
                    <div class="card-body">
                        <div class="row py-1">
                            <div class="col-12 col-md-6">
                                <div class="row">
                                    <div class="col-12 col-md-4 text-right p-0">
                                        <label asp-for="CompanyCode" class="form-label col-form-label-sm d-flex justify-content-end hannan" style="white-space:nowrap;">Comapny</label>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div class="input-wrapper">
                                            <select asp-for="CompanyCode" tabindex="1" required data-placeholder="Select Company" class="form-control form-control-sm selectpickerrr js-">
                                                <option value="">Select Company</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <hr class="p-0 mt-2 m-0" style="width:35vw;"/>
                            </div>
                            <div class="col-12 col-md-6"> </div>
                        </div>

                        <div class="row py-1">
                            <div class="col-12 col-md-6">
                                <div class="row">
                                    <div class="col-12 col-md-4 text-right p-0">
                                        <label asp-for="EmployeeId" class="form-label col-form-label-sm d-flex justify-content-end hannan" style="white-space:nowrap;">Employee ID</label>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div class="input-wrapper">
                                            <select asp-for="EmployeeId" tabindex="2" title="Select Employee" required data-placeholder="Select Employee" class="form-control form-control-sm selectpickerrr js-">
                                                <option value="">Select Employee</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="d-flex align-items-center">
                                    <div class="col-12 col-md-4 text-right p-0">
                                        <label class="d-flex justify-content-end form-label col-form-label-sm" asp-for="EmployeeName">Employee Name:</label>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        @* <span id="FullName" style="text-align: left; display: block;">@Model.EmployeeName</span> *@
                                        <span id="FullName" style="text-align: left; display: block;"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row py-1">
                            <div class="col-12 col-md-6">
                                <div class="d-flex align-items-center">
                                    <div class="col-12 col-md-4 text-right p-0">
                                        <label class="d-flex justify-content-end form-label col-form-label-sm" asp-for="DepartmentName">Department:</label>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <span id="DepartmentName" style="text-align: left; display: block;"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="d-flex align-items-center">
                                    <div class="col-12 col-md-4 text-right p-0">
                                        <label class="d-flex justify-content-end form-label col-form-label-sm" asp-for="DesignationName">Designation:</label>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <span id="DesignationName" style="text-align: left; display: block;"></span> <!-- Right aligned -->
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row py-1">
                            <div class="col-12 col-md-6">
                                <div class="d-flex align-items-center">
                                    <div class="col-12 col-md-4 text-right p-0">
                                        <label class="d-flex justify-content-end form-label col-form-label-sm" asp-for="GrossSalary">Gross Salary:</label>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <span id="GrossSalary" style="text-align: left; display: block;"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="d-flex align-items-center">
                                    <div class="col-12 col-md-4 text-right p-0">
                                        <label class="d-flex justify-content-end form-label col-form-label-sm" asp-for="JoiningDate">Joining Date:</label>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <span id="JoiningDate" style="text-align: left; display: block;"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row py-1">
                            <div class="col-12 col-md-6">
                                <div class="d-flex align-items-center">
                                    <div class="col-12 col-md-4 text-right p-0">
                                        <label class="d-flex justify-content-end form-label col-form-label-sm" asp-for="ProbationPeriod">Probation Period:</label>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <span id="ProbationPeriod" style="text-align: left; display: block;"></span> <!-- Right aligned -->
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="d-flex align-items-center">
                                    <div class="col-12 col-md-4 text-right p-0">
                                        <label class="d-flex justify-content-end form-label col-form-label-sm" asp-for="ContractEndDate">End On:</label>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <span id="ContractEndDate" style="text-align: left; display: block;"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row py-1">
                            <div class="col-12 col-md-6">
                                <div class="d-flex align-items-center">
                                    <div class="col-12 col-md-4 text-right p-0">
                                        <label class="d-flex justify-content-end form-label col-form-label-sm" asp-for="DurationSinceJoining">Service Length:</label>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <span id="DurationSinceJoining" style="text-align: left; display: block;"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                              
                            </div>
                        </div>

                    </div>
                </div>

                <div class="card">
                    <div class="card-body">

                        <div class="row py-2">
                            <div class="col-12 col-md-6">
                                <div class="row">
                                    <div class="col-12 col-md-4 text-right p-0">
                                        <label asp-for="Ppeid" class="form-label col-form-label-sm d-flex justify-content-end" style="white-space:nowrap;">PPE ID</label>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div class="input-wrapper">
                                            <input asp-for="Ppeid" type="text" class="form-control form-control-sm js-Ppeid-code" readonly />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6"> </div>
                        </div>

                        <div class="row py-2">
                            <div class="col-12 col-md-6">
                                <div class="row">
                                    <div class="col-12 col-md-4 text-right p-0">
                                        <label asp-for="ExtendedPeriod" class="form-label col-form-label-sm d-flex justify-content-end" style="white-space:nowrap;">Extended Period<span class="text-danger">*</span></label>
                                    </div>
                                    <div class="col-12 col-md-6">
                                       <div class="row">
                                            <div class="col-12 col-md-6">
                                                <input asp-for="Extended" class="form-control form-control-sm" type="number" tabindex="3" placeholder="Enter Extended Period" autofocus />
                                            </div>
                                            <div class="col-12 col-md-6">
                                                <select asp-for="Period" class="form-control-sm form-control col-12 selectpickerrr" tabindex="4" title="Select Extended Period Type" required data-placeholder="Select Extended Period Type" asp-items="@ViewBag.ExtendedDD">
                                                    @* <option value="">Select Extended</option> *@
                                                </select>
                                            </div>
                                       </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6"> </div>
                        </div>

                        <div class="row py-2">
                            <div class="col-12 col-md-6">
                                <div class="row">
                                    <div class="col-12 col-md-4 text-right p-0">
                                        <label asp-for="Wef" class="form-label col-form-label-sm d-flex justify-content-end" style="white-space:nowrap;">
                                            With Effect From
                                        </label>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div class="input-wrapper">
                                            <input asp-for="Wef" class="form-control form-control-sm flatpickr" placeholder="Enter With Effect From" tabindex="5" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="row">
                                    <div class="col-12 col-md-4 text-right p-0">
                                        <label asp-for="ExtensionSalary" class="form-label col-form-label-sm d-flex justify-content-end" style="white-space:nowrap;">
                                            Extension Salary
                                        </label>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div class="input-wrapper">
                                            <input asp-for="ExtensionSalary" class="form-control form-control-sm" placeholder="Enter Extension Salary" tabindex="6" />
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <div class="row py-2">
                            <div class="col-12 col-md-6">
                                <div class="row">
                                    <div class="col-12 col-md-4 text-right p-0">
                                        <label asp-for="RefLetterNo" class="form-label col-form-label-sm d-flex justify-content-end" tyle="white-space:nowrap;">
                                            Ref.Letter/Ref.No
                                        </label>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div class="input-wrapper">
                                            <input asp-for="RefLetterNo" class="form-control form-control-sm" placeholder="Enter Ref.Letter/Ref.No" tabindex="7" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="row">
                                    <div class="col-12 col-md-4 text-right p-0">
                                        <label asp-for="RefLetterDate" class="form-label col-form-label-sm d-flex justify-content-end  hannan" tyle="white-space:nowrap;">
                                            Ref.LetterDate
                                        </label>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <div class="input-wrapper">
                                            <input asp-for="RefLetterDate" class="form-control form-control-sm flatpickr" placeholder="Enter Ref.LetterDate" tabindex="8" />
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <div class="row pe-2 mb-2">
                            <div class="col-12">
                                <div class="row">
                                    <div class="col-12 col-md-2 text-right p-0">
                                        <label asp-for="Remarks" class="form-label col-form-label-sm d-flex justify-content-end" style="white-space:nowrap;">
                                            Remarks
                                        </label>
                                    </div>
                                    <div class="col-12 col-md-9">
                                        <div class="input-wrapper">
                                            <textarea asp-for="Remarks" class="form-control form-control-sm" rows="1" placeholder="Enter Remark" tabindex="9"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr id="sectionBreak" />

                        <div class="form-group row" id="LdateModifyHide">

                            <div class="col-6">
                                <div class="form-group d-flex align-items-center">
                                    <label class="form-label col-form-label-sm d-flex justify-content-end">Creation Date:</label>
                                    <div class="input-wrapper p-2">
                                        <span id="creationDateSpan">
                                            @(Model.Ldate.HasValue? Model.Ldate?.ToString("dd/MM/yyyy hh:mm tt") : "")
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="form-group d-flex align-items-center">
                                    <label class="form-label col-form-label-sm d-flex justify-content-end">Last Update Date:</label>
                                    <div class="input-wrapper p-2">
                                        <span id="modifyDateSpan">
                                            @(Model.ModifyDate.HasValue? Model.ModifyDate?.ToString("dd/MM/yyyy hh:mm tt") : "")
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row no-print mt-3">
                            <div class="col-12">
                                <button type="button" class="btn btn-outline-success btn-common btn-circle float-right js-ProbationPeriodExtension-save" data-id="@Model.Ppeid">
                                    <i class="fas fa-save"></i> Save
                                </button>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>

        .form-group label {
            margin-right: .5rem;
            min-width: 150px;
        }

        .form-group input {
            flex: 1;
            max-width: 100%;
        }

        .input-wrapper {
            position: relative;
            width: 100%;
        }

            .input-wrapper span {
                width: 100%;
            }

        .required::after {
            content: '*';
            color: red;
            margin-left: 5px;
        }

    </style>
}