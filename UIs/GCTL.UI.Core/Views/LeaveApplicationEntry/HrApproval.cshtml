@{
    ViewData["Title"] = "Approval";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-lg-8">
        @* <div class="bg-light"> *@
        @* <div class="container mt-4"> *@
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="#">Home</a></li>
                <li class="breadcrumb-item">Human Resource Management</li>
                <li class="breadcrumb-item">Leave Management</li>
                <li class="breadcrumb-item"><a href="index">Operation</a></li>
                <li class="breadcrumb-item active">Leave Approval</li>
            </ol>
        </nav>

        <!-- Main Card -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Leave Approval</h5>
                <div style="display: flex;">
                    <button id="submitSelected" class="btn btn-light" style="border-top-left-radius: 15px; border-bottom-left-radius: 15px; border-right: none; background-color: #7377cd29">
                        <i class="fas fa-thumbs-up"> Approve</i>
                    </button>
                    <button id="clearBtn" class="btn btn-light" style="border-top-left-radius: 0px; border-bottom-left-radius: 0px; border-right: none; background-color: #7377cd29">
                        <i class="fas fa-trash"> Clear</i>
                    </button>
                    <button id="submitRejected" class="btn btn-light" style="border-top-right-radius: 15px; border-bottom-right-radius: 15px; background-color: #7377cd29">
                        <i class="fas fa-thumbs-down"> Reject</i>
                    </button>
                </div>
            </div>



            <div class="card-body">
                <form id="leaveApprovalForm" method="post">


                    <input type="text" id="leaveAppEntryId" class="form-control  form-control-sm">



                    <div class="gradient-bg mb-2 rounded p-3">

                        <!-- Employee Info Section -->
                        <div class="row mb-1">


                            <label class="col-2 col-form-label-sm">Employee Name</label>
                            <div class="col-4">
                                <input id="employeeName" type="text" class="form-control form-control-sm" value="" readonly style="border: none; outline: none; background: transparent;">
                            </div>

                            <label class="col-2 col-form-label-sm">Employee ID</label>
                            <div class="col-4">
                                <select id="employeeDropdown" class=" form-control  form-control-sm">
                                    <option value="">--Select Employee--</option>
                                </select>
                            </div>
                        </div>

                        <!-- isAppraval -->
                        <div class="row mb-1">
                            <label class="col-2 col-form-label-sm required">Immediate Supervisor</label>
                            <div class="col-4">
                                <select id="immediateSupervisor" class="form-control  form-control-sm">
                                    <option selected></option>
                                </select>
                            </div>
                            <label class="col-2 col-form-label-sm">Head of Department</label>
                            <div class="col-4">
                                <select id="headOfDepartment" class="form-control  form-control-sm">
                                    <option selected></option>
                                </select>
                            </div>
                        </div>

                        <!-- Leave type -->

                        <div class="row mb-1">
                            @* <label class="col-2 col-form-label  form-control-sm required">Apply Leave Format</label>
                            <div class="col-4">
                                <select class="form-control  form-control-sm" id="applyLeaveFormat" name="selectedItem">
                                    <option selected>--Select Apply Leave Format--</option>
                                    <option value="halfDayLeave">Half Day Leave</option>
                                    <option value="fullDayLeave">Full Day Leave</option>
                                    <option value="shortLeave">Short Leave</option>
                                </select>
                            </div> *@

                            <label class="col-2 col-form-label  form-control-sm required">Leave Type</label>
                            <div class="col-4">
                                <select class="form-control  form-control-sm" id="leaveType" name="selectedItem">

                                    <option selected></option>
                                </select>
                            </div>


                            <label class="col-2 col-form-label-sm ">Leave Status</label>
                            <div class="col-4">
                                <span id="leaveStatus"></span>

                            </div>
                        </div>

                        <!-- from to -->

                        <div id="fullDayInputs" class="row mb-2" style="display: none;">
                            <label class="col-2 col-form-label  form-control-sm required">From</label>
                            <div class="col-4">
                                <input type="date" id="fromDate" class="form-control  form-control-sm">
                            </div>
                            <label class="col-1 col-form-label">Day(s)</label>
                            <div class="col-1">
                                <input type="number" id="daysBetween" class="form-control  form-control-sm" readonly>
                            </div>
                            <label class="col-1 col-form-label  form-control-sm required">To</label>
                            <div class="col-3">
                                <input type="date" id="toDate" class="form-control  form-control-sm">
                            </div>
                        </div>

                        <div id="halfDayInputs" class="row mb-2" style="display: none;">
                            <label class="col-2 col-form-label  form-control-sm">Half Day</label>
                            <div class="col-6">
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="checkbox" id="halfDayCheckbox">
                                    <label class="form-check-label" for="halfDayCheckbox">Half Day</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="halfDayType" id="firstHalf">
                                    <label class="form-check-label" for="firstHalf">First Half</label>
                                </div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input" type="radio" name="halfDayType" id="secondHalf">
                                    <label class="form-check-label" for="secondHalf">Second Half</label>
                                </div>
                            </div>
                        </div>

                        <div id="oneDayInputs" class="row mb-2" style="display: none;">
                            <label class="col-2 col-form-label  form-control-sm required">From</label>
                            <div class="col-4">
                                <input type="time" id="fromTime" class="form-control  form-control-sm">
                            </div>
                            <label class="col-1 col-form-label">Hour(s)</label>
                            <div class="col-1">
                                <input type="text" id="hoursBetween" class="form-control  form-control-sm" readonly>
                            </div>
                            <label class="col-1 col-form-label-sm  required">To</label>
                            <div class="col-3">
                                <input type="time" id="toTime" class="form-control  form-control-sm">
                            </div>
                        </div>

                        <!-- calender Dates to -->

                        <div class="row mb-1">


                            <label class="col-2 col-form-label-sm">Calender Dates</label>
                            <div class="col-10">
                                <input id="days" type="text" class="form-control form-control-sm" value="">
                            </div>


                        </div>

                        <!-- Reason -->

                        <div class="row mb-2">
                            <label class="col-2 col-form-label-sm">Reason</label>
                            <div class="col-10">
                                <textarea class="form-control  form-control-sm" rows="2"></textarea>
                            </div>

                        </div>

                        <hr />
                        <!-- approval remark -->

                        <div class="row mb-2">
                            <label class="col-2 col-form-label  form-control-sm required">Approval Status</label>
                            <div class="col-4">
                                <select class="form-control  form-control-sm" id="approvalStatus" name="selectedItem">
                                    <option selected>--Select Approval Status--</option>
                                    <option value="approved">Approved</option>
                                    <option value="rejected">Rejected</option>

                                </select>
                            </div>
                            <label class="col-2 col-form-label-sm ">Confirmation Remark</label>
                            <div class="col-4">
                                <textarea id="confirmRemark" class="form-control  form-control-sm" rows="2"></textarea>
                            </div>
                        </div>

                        <!-- button -->

                        <div class="row mb-2">
                            <label class="col-4 col-form-label-sm"></label>
                            <div class="col-4">
                            </div>
                            <div class="col-4 text-end">
                                <button type="submit" class="btn btn-primary">Leave Apply</button>
                            </div>
                        </div>

                        <hr />

                        <!-- create last update -->

                        <div class="row mb-2">
                            <label class="col-2 col-form-label  form-control-sm required">Create At</label>
                            <div class="col-4">
                                <input id="createAt" type="text" class="form-control form-control-sm" value="" readonly style="border: none; outline: none; background: transparent;">
                            </div>
                            <label class="col-2 col-form-label-sm ">Last Update At</label>
                            <div class="col-4">
                                <input id="updateAt" type="text" class="form-control form-control-sm" value="" readonly style="border: none; outline: none; background: transparent;">
                            </div>
                        </div>

                        <hr />

                    </div>













                </form>
            </div>
        </div>





    </div>

    <div class="col-lg-4">
        <!-- First Card: Leave Status Table -->
        <div class="card mt-5">
            <div class="card-header">
                <h5 class="mt-0"><b>Leave Status</b></h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">

                    <table id="leavePendingTable" class="display table table-striped table-bordered dt-custom-padding" style="width:100%">
                        <thead>
                            <tr>
                                <th></th>
                                <th>L.Id</th>
                                <th>L.Fromat</th>
                                <th>Emp.Id</th>
                                <th>Name</th>
                                <th>Designation</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Data rows will go here -->
                        </tbody>
                    </table>

                </div>
            </div>
        </div>

        <!-- Second Card: Approved Leave Table -->

    </div>



</div>

@* <button id="submitSelected" class="btn btn-primary">Submit Selected</button> *@

<div class="row mt-4">
    <div class="col-lg-12">
        <div class=" mt-2 table-responsive">
            <table id="leaveApplicationsTable" class="display table table-striped table-bordered table-sm" style="width:100%; max-height : 495px">
                <thead>
                    <tr>



                        <th style="width:2%">Sel.</th>
                        <th style="width:5%">Leave Id</th>
                        <th style="width:5%">Apply Date</th>
                        <th style="width:5%">Leave Format</th>
                        <th style="width:5%">Approval Status</th>
                        <th style="width:5%">Employee ID</th>
                        <th style="width:5%">Name</th>
                        <th style="width:3%">Leave Type</th>
                        <th style="width:5%">Start Date</th>
                        <th style="width:5%">End Date</th>
                        <th style="width:5%">Calendar Dates</th>
                        <th style="width:5%">No Of Days</th>
                        <th style="width:20%">Reason</th>

                    </tr>
                </thead>
            </table>
        </div>
    </div>
    <div class="col-lg-0"></div>
</div>


<style>
    #leavePendingTable th, #leavePendingTable td {
        white-space: normal;
        word-wrap: break-word;
    }



    /* Custom padding for DataTable cells */
    .dt-custom-padding {
        padding: 0px 0px !important; /* Vertical padding 12px, horizontal padding 8px */
    }


        .dt-custom-padding.sorting,
        #leavePendingTable thead th {
            padding: 12px 2px !important; /* Increased header padding */
            font-weight: bold;
        }
        /* Custom padding for DataTable header cells */
        /*  .dt-custom-padding.sorting {
                    padding: 12px 8px !important;
                } */

        /* Optional: Add hover effect */
        .dt-custom-padding:hover {
            background-color: #f5f5f5;
        }


    /*    .card-body {
            -ms-flex: 1 1 auto;
            flex: 1 1 auto;
            min-height: 550px;
            padding: 1.25rem;
        } */




    /* Custom styles for DataTable */
    #leavePendingTable_wrapper {
        max-width: 100%; /* Adjust the width as needed */
        max-height: 520px; /* Adjust the height as needed */
        overflow: auto; /* Enable scrolling if the content exceeds the max height */
    }

    #leavePendingTable {
        width: 100%; /* Adjust the width as needed */
        height: auto; /* Let the height adjust automatically based on content */
        table-layout: fixed; /* Ensures the table respects the set width */
    }

        /* Example: Adding padding to cells */
        #leavePendingTable td, #leavePendingTable th {
            padding: 0px; /* Adjust padding as needed */
        }


        #leavePendingTable th, #leavePendingTable td {
            text-align: center;
        }

</style>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.4/index.global.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.4/index.global.min.css">




    <script src="~/js/pages/HrApproval.js"></script>

}
