@{
    ViewData["Title"] = "Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="#">Home</a></li>
                <li class="breadcrumb-item">Human Resource Management</li>
                <li class="breadcrumb-item">Leave Management</li>
                <li class="breadcrumb-item">Operation</li>
                <li class="breadcrumb-item active">Leave Application Entry</li>
            </ol>
        </nav>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Leave Application Report</h5>
            </div>

            <form id="leaveApplicationForm" method="post">
                <div class="card-body">

                    <!-- Search By -->
                    <div class="row mb-1">
                        <div class="col-6">
                            <h6 class="font-weight-bold mb-1">Search By:</h6>
                            <hr class="mt-0 mb-3">
                        </div>
                    </div>

                    <div class="row">
                        <!-- Left Column -->
                        <div class="col-md-6">

                            <div class="row align-items-center mb-3">
                                <label class="col-5 text-right mb-0 pr-3 col-form-label-sm">Company</label>
                                <div class="col-6">
                                    <select id="companyDropdown" multiple="multiple" name="company" class="form-control form-control-sm" title="--Select--"></select>
                                </div>
                                <div class="col-1"></div>
                            </div>

                            <div class="row align-items-center mb-3">
                                <label class="col-5 text-right mb-0 pr-3 col-form-label-sm">Department</label>
                                <div class="col-6">
                                    <select id="departmentDropdown" multiple="multiple" name="department" class="form-control form-control-sm" title="--Select--"></select>
                                </div>
                                <div class="col-1"></div>
                            </div>

                            <div class="row align-items-center mb-3">
                                <label class="col-5 text-right mb-0 pr-3 col-form-label-sm">Employee</label>
                                <div class="col-6">
                                    <select id="employeeDropdown" multiple="multiple" name="employee" class="form-control form-control-sm" title="--Select--"></select>
                                </div>
                                <div class="col-1"></div>
                            </div>

                            <div class="row align-items-center mb-3">
                                <label class="col-5 text-right mb-0 pr-3 col-form-label-sm">Date From</label>
                                <div class="col-6">
                                    <input type="text" id="dateFromStr" name="dateFromStr" class="form-control form-control-sm" />
                                </div>
                                <div class="col-1"></div>
                            </div>

                        </div>

                        <!-- Right Column -->
                        <div class="col-md-6">

                            <div class="row align-items-center mb-3">
                                <label class="col-5 text-right mb-0 pr-3 col-form-label-sm">Branch</label>
                                <div class="col-6">
                                    <select id="branchDropdown" multiple="multiple" name="branch" class="form-control form-control-sm" title="--Select--"></select>
                                </div>
                                <div class="col-1"></div>
                            </div>

                            <div class="row align-items-center mb-3">
                                <label class="col-5 text-right mb-0 pr-3 col-form-label-sm">Apply Leave Format</label>
                                <div class="col-6">
                                    <select id="leaveFormatDropdown" multiple="multiple" name="leaveFormat" class="form-control form-control-sm" title="--Select--">
                                        <option value="fullDayLeave">Full Day</option>
                                        <option value="halfDayLeave">Half Day</option>
                                        <option value="shortLeave">Hourly</option>
                                    </select>
                                </div>
                                <div class="col-1"></div>
                            </div>

                            <div class="row align-items-center mb-3">
                                <label class="col-5 text-right mb-0 pr-3 col-form-label-sm">Leave Status</label>
                                <div class="col-6">
                                    <select id="leaveStatusDropdown" multiple="multiple" name="leaveStatus" class="form-control form-control-sm" title="--Select--">
                                        <option value="pending">Pending</option>
                                        <option value="approved">Approved</option>
                                        <option value="rejected">Canceled</option>
                                    </select>
                                </div>
                                <div class="col-1"></div>
                            </div>

                            <div class="row align-items-center mb-3">
                                <label class="col-5 text-right mb-0 pr-3 col-form-label-sm">Date To</label>
                                <div class="col-6">
                                    <input type="text" id="dateToStr" name="dateToStr" class="form-control form-control-sm" />
                                </div>
                                <div class="col-1"></div>
                            </div>

                        </div>
                    </div>

                    <!-- Report Option -->
                    <div class="row mt-2 mb-1">
                        <div class="col-6">
                            <h6 class="font-weight-bold mb-1">Report Option:</h6>
                            <hr class="mt-0 mb-3">
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="row align-items-center mb-3">
                                <label class="col-5 text-right mb-0 pr-3 col-form-label-sm">Report Format</label>
                                <div class="col-6">
                                    <select id="reportFormatDropdown" name="reportFormat" class="form-control form-control-sm selectpickerReport">
                                        <option value="">--Select--</option>
                                        <option value="pdf">PDF</option>
                                        <option value="excel">Excel</option>
                                    </select>
                                </div>
                                <div class="col-1"></div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="row">
                                <div class="col-11 d-flex justify-content-end">
                                    <button id="exportButtonNew" class="btn btn-default success-btn btn-sm mr-2">
                                        <i class="fas fa-file-export"></i> Export
                                    </button>
                                    <button id="previewBtn1" class="btn btn-default success-btn btn-sm">
                                        <i class="fas fa-eye"></i> Preview
                                    </button>
                                </div>
                                <div class="col-1"></div>
                            </div>
                        </div>
                    </div>

                </div>
            </form>
        </div>

        <div id="loadingSpinner1" style="display: none;" class="text-center my-4">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden"></span>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div id="leaveContainer"></div>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <!-- DataTables CSS and JS - Ensure these are loaded first -->
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css">
    <script type="text/javascript" src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.4/index.global.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.4/index.global.min.css">

    <script>
        $(document).ready(function () {
            $('#dateFrom, #dateTo').on('change', function () {
                const dateFrom = new Date($('#dateFrom').val());
                const dateTo = new Date($('#dateTo').val());

                if (dateFrom && dateTo && dateTo < dateFrom) {
                    toastr.warning('End date cannot be earlier than start date');
                    $(this).val('');
                }
            });

            $('#previewBtn1').click(function (e) {
                e.preventDefault();
                generatePreview();
            });

            function generatePreview() {
                $('#loadingSpinner1').show();
                $('#leaveContainer').empty(); // Clear existing data before loading new data

                var formData = new FormData($('#leaveApplicationForm')[0]);

                $.ajax({
                    url: '/LeaveApplicationEntry/PreviewLeaveReportArray',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        console.log('Preview Response:', response);
                        $('#loadingSpinner1').hide();

                        if (response.success) {
                            let container = $("#leaveContainer");

                            // Set styles for report
                            $("body").css({
                                "background-color": "white",
                                "font-family": "Arial, sans-serif",
                                "margin": "0",
                                "padding": "20px"
                            });

                            // Get the data from response
                            const companies = response.data.result;

                            // Loop through companies
                            $.each(companies, function (companyCode, companyData) {
                                container.append(`<h2 style="color: #333; text-align: center; margin-top: 50px; border-bottom: 2px solid #007bff; padding-bottom: 5px;">Company: ${companyCode}</h2>`);

                                // Loop through departments
                                $.each(companyData.departmentData, function (departmentName, departmentInfo) {
                                    // Create a unique ID for this table
                                    let safeCompanyCode = companyCode.replace(/[^a-zA-Z0-9]/g, '_');
                                    let safeDeptName = departmentName.replace(/[^a-zA-Z0-9]/g, '_');
                                    let tableId = `table_${safeCompanyCode}_${safeDeptName}`;

                                    container.append(`
                                            <div class="mt-4">
                                                <h4 style="color: #555;">Department: ${departmentInfo.departmentName}</h4>
                                                <div class="table-responsive mt-3">
                                                    <table id="${tableId}" class="table table-striped table-bordered" width="100%">
                                                        <thead>
                                                            <tr>
                                                                <th>Employee ID</th>
                                                                <th>Employee Name</th>
                                                                <th>Designation</th>
                                                                <th>Leave ID</th>
                                                                <th>Leave Format</th>
                                                                <th>Approval Status</th>
                                                                <th>Leave Type</th>
                                                                <th>From Date</th>
                                                                <th>To Date</th>
                                                                <th>Date(s)</th>
                                                                <th>No. of Days</th>

                                                                <th>Reason</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            ${departmentInfo.leaveDetails.map(leave => `
                                                                <tr>
                                                                    <td>${leave.employeeId}</td>
                                                                    <td>${leave.employeeFirstName}</td>
                                                                    <td>${leave.designationName}</td>
                                                                    <td>${leave.leaveAppEntryId}</td>
                                                                    <td>${leave.applyLeaveFormat}</td>
                                                                    <td>${leave.hrApprovalStatus}</td>
                                                                    <td>${leave.leaveTypeId}</td>
                                                                    <td>${new Date(leave.startDate).toLocaleDateString('en-GB')}</td>
                                                                    <td>${new Date(leave.endDate).toLocaleDateString('en-GB')}</td>
                                                                    <td>${leave.daysStr ? leave.daysStr.map(date => `<span>${date}</span><br/>`) : 'N/A'}</td>
                                                                    <td>${leave.noOfDay}</td>

                                                                    <td>${leave.reason}</td>
                                                                </tr>
                                                            `).join('')}
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        `);

                                    // Initialize DataTable - Make sure to wait until DOM is ready
                                    setTimeout(function () {
                                        var table = $(`#${tableId}`).DataTable({
                                            destroy: true, // Important: destroy any existing table
                                            paging: true,
                                            lengthChange: true,
                                            searching: true,
                                            ordering: true,
                                            info: true,
                                            autoWidth: false,
                                            responsive: true,
                                            dom: '<"top"lf>rt<"bottom"ip><"clear">', // Add search and pagination controls
                                            pageLength: 10,
                                            lengthMenu: [10, 25, 50, 100]
                                        });

                                        console.log(`DataTable initialized for #${tableId}`);
                                    }, 200);
                                });
                            });
                        } else {
                            toastr.warning('Failed to generate preview: ' + (response.message || 'Unknown error'));
                        }
                    },
                    error: function (xhr, status, error) {
                        $('#loadingSpinner1').hide();
                        toastr.warning('Failed to generate preview');
                        console.error('AJAX error:', error);
                    }
                });
            }
        });
    </script>

    <script src="~/js/pages/LeaveApplicationReport.js"></script>
}