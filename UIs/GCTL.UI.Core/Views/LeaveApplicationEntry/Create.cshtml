@model GCTL.Core.ViewModels.HrmLeaveApplicationEntry.LeaveApplicationViewModel


<link rel="stylesheet" type="text/css" href="https://npmcdn.com/flatpickr/dist/themes/airbnb.css">

@{
    ViewData["Title"] = "Manual Leave";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<style>

    /* Ensuring Select2 is responsive */
    .select2-container {
        width: 100% !important; /* Makes the Select2 input take up full width */
    }

    /* Optional: Adding responsiveness to select inputs directly */
    .selectpickerLeave {
        width: 100% !important; /* Ensures the select box fills available space */
    }

    .select2-results__option {
        user-select: text; /* Allow text selection */
        -webkit-user-select: text;
        -moz-user-select: text;
    }

    .select2-selection__rendered {
        user-select: text;
        -webkit-user-select: text;
        -moz-user-select: text;
    }

    /* Flatpickr inline calendar */
    .flatpickr-calendar.inline {
        position: relative;
        display: block;
        margin: 0px 0;
        width: 100% !important;
        max-width: 390px !important;
        border-radius: 6px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        background-color: #fff !important;
    }

    .flatpickr-time input:hover {
        background-color: #fff !important;
    }
    /* Time picker styling */
    .flatpickr-time {
        height: auto !important;
        /* padding: 15px 10px !important; */
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
    }

        .flatpickr-time .numInputWrapper {
            height: 50px;
            display: inline-flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin: 0 4px;
        }

        .flatpickr-time input.numInput {
            font-size: 15px !important;
            height: 50px !important;
            line-height: 50px !important;
            padding: 0 5px !important;
            text-align: center !important;
        }

    .flatpickr-time-separator {
        font-size: 15px !important;
        line-height: 50px !important;
        height: 50px !important;
        display: inline-flex;
        align-items: center;
    }

    .flatpickr-time .flatpickr-am-pm {
        height: 50px !important;
        line-height: 50px !important;
        font-size: 13px !important;
        background-color: #fff !important;
        color: #000 !important;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        padding: 0 10px !important;
    }

    .numInputWrapper .arrowUp,
    .numInputWrapper .arrowDown {
        height: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

    .numInputWrapper .arrowUp {
        padding-bottom: 0;
    }

    .numInputWrapper .arrowDown {
        padding-top: 0;
    }

    /* Hide the input field */
    .timepicker {
        display: none !important;
    }

    .fp-ui-disabled {
        pointer-events: none;
        opacity: 0.5;
    }

    .row {
        display: -ms-flexbox;
        display: flex;
        -ms-flex-wrap: wrap;
        flex-wrap: wrap;
        margin-right: -7.5px;
        margin-left: -7.5px;
        align-content: center;
        align-items: center;
    }

    .flatpickr-time .flatpickr-am-pm {
        padding: 0px !important;
    }

    .fp-ui-disabled {
        opacity: 0.4;
        pointer-events: none;
        user-select: none;
    }


    .comma-list {
        list-style-type: none;
        margin: 0;
        padding: 0;
    }

        .comma-list li {
            display: inline;
        }

            .comma-list li::after {
                content: ", ";
            }

            .comma-list li:last-child::after {
                content: "";
            }


    /* Target the bottom row that holds info + pagination */
    .dataTables_wrapper .row:last-child {
        display: flex !important;
        justify-content: space-between;
        align-items: center;
        flex-wrap: nowrap;
    }

        /* Remove Bootstrap column widths so they sit inline */
        .dataTables_wrapper .row:last-child > div {
            flex: 0 0 auto !important;
            max-width: none !important;
            width: auto !important;
            padding: 0 !important;
        }

    /* Ensure info text and pagination align neatly */
 




    .dt-look thead th {
        position: sticky;
        top: 0;
        background: #f8f9fa;
        z-index: 1;
        text-align: center;
        vertical-align: middle;
        font-weight: 600;
    }

    .dt-look td {
        text-align: center;
        vertical-align: middle;
        padding: 6px 8px;
        font-size: 0.85rem;
    }

        .dt-look td.resn-cell {
            text-align: start;
        }

    .dt-look tbody tr:nth-child(odd) {
        background-color: #f9f9f9;
    }

    .dt-look tbody tr:nth-child(even) {
        background-color: #ffffff;
    }


    .dt-look thead th.sort-asc .fas.fa-sort:before {
        content: "\f0de";
    }

    .dt-look thead th.sort-desc .fas.fa-sort:before {
        content: "\f0dd";
    }

    .dt-look thead th[data-col]:hover {
        background-color: #e9ecef;
    }

   




</style>



