@using GCTL.Data.Models
@model GCTL.Core.ViewModels.HrmLeaveApplicationEntry.EmpInfoViewModel




@{
    ViewData["Title"] = "Leave";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<link rel="stylesheet" type="text/css" href="https://npmcdn.com/flatpickr/dist/themes/airbnb.css">

<style>
    .flatpickr-calendar.inline {
        position: relative;
        display: block;
        margin: 0px 0;
        width: 100% !important;
        max-width: 390px !important;
        border-radius: 6px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        background-color: #fff !important;
    }

    .flatpickr-time input:hover {
        background-color: #fff !important;
    }

    .flatpickr-time {
        height: auto !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
    }

        .flatpickr-time .numInputWrapper {
            height: 50px;
            display: inline-flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            margin: 0 4px;
        }

        .flatpickr-time input.numInput {
            font-size: 15px !important;
            height: 50px !important;
            line-height: 50px !important;
            padding: 0 5px !important;
            text-align: center !important;
        }

    .flatpickr-time-separator {
        font-size: 15px !important;
        line-height: 50px !important;
        height: 50px !important;
        display: inline-flex;
        align-items: center;
    }

    .flatpickr-time .flatpickr-am-pm {
        height: 50px !important;
        line-height: 50px !important;
        font-size: 13px !important;
        background-color: #fff !important;
        color: #000 !important;
        border-radius: 6px;
        font-weight: 600;
        cursor: pointer;
        padding: 0 10px !important;
    }

    .timepicker {
        display: none !important;
    }

    .fp-ui-disabled {
        pointer-events: none;
        opacity: 0.5;
    }




    .dt-look thead th {
        position: sticky;
        top: 0;
        background: #f8f9fa;
        z-index: 1;
        text-align: center;
        vertical-align: middle;
        font-weight: 600;
    }

    .dt-look td {
        text-align: center;
        vertical-align: middle;
        padding: 6px 8px;
        font-size: 0.85rem;
    }

        .dt-look td.resn-cell {
            text-align: start;
        }

    .dt-look thead th.sort-asc .fas.fa-sort:before {
        content: "\f0de";
    }

    .dt-look thead th.sort-desc .fas.fa-sort:before {
        content: "\f0dd";
    }

    .dt-look thead th[data-col]:hover {
        background-color: #e9ecef;
    }


</style>




        <partial name="_PageHeader" model="@Model" />
<div class="row">
    <div class="col-lg-8">

        <!-- Breadcrumb -->


        <!-- Main Card -->
        <div class="card ml-2" style="height: 1010px">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Leave Application Entry</h5>
                <div>
                    @*  <button class="btn btn-light"><i class="fas fa-trash"></i></button>
                        <button class="btn btn-light"><i class="fas fa-print"></i></button>
                        <button class="btn btn-light"><i class="fas fa-star"></i></button> *@
                </div>
            </div>

            <div class="card-body">
                <form id="leaveApplicationForm" method="post">


                    <!-- Employee Info Section -->
                    <style>
                        .gradient-bg {
                            background: linear-gradient(to right, rgb(244 246 249), rgb(216 228 241));
                            padding: 10px;
                            border-radius: 8px;
                            color: black;
                        }

                        fieldset {
                            border: 0px solid rgba(0, 0, 0, 0.2); /* Light border for the fieldset */
                        }

                        legend {
                            font-weight: bold;
                            font-size: 1.2em;
                            color: black; /* Legend text color */
                        }
                    </style>

                    <div class="gradient-bg mb-2 rounded p-3">
                        @*  <fieldset>
            <legend class="fs-5 mb-3">Employee Information</legend> *@

                        <!-- Company Dropdown -->
                        <div class="row mb-1">
                            <label class="col-2 text-right pr-0 col-form-label-sm required">Company</label>
                            <div class="col-4">
                                <select id="companyDropdown" name="selectedItem" class=" form-control  form-control-sm">
                                    <option selected value="@Model.CompanyCode">@Model.CompanyName</option>

                                </select>
                            </div>
                        </div>

                        <!-- Employee ID and Name -->
                        <div class="row mb-1">
                            <label class="col-2 text-right pr-0 col-form-label-sm">Employee ID</label>
                            <div class="col-4">
                                <select id="employeeDropdown" class=" form-control  form-control-sm">
                                    <option selected value="@Model.EmployeeId">@Model.EmployeeId</option>
                                </select>
                            </div>

                            <label class="col-2 text-right pr-0 col-form-label-sm">Employee Name</label>
                            <div class="col-4">
                                <input id="employeeName" type="text" class="form-control form-control-sm" value="@($"{Model.EmployeeFirstName} {Model.EmployeeLastName}".Trim())" readonly style="border: none; outline: none; background: transparent;">
                            </div>
                        </div>

                        <!-- Designation and Department -->
                        <div class="row mb-1">
                            <label class="col-2 text-right pr-0 col-form-label-sm">Designation</label>
                            <div class="col-4">
                                <input id="designation" type="text" class="form-control form-control-sm" value="@Model.DesignationName" readonly style="border: none; outline: none; background: transparent;">
                            </div>

                            <label class="col-2 text-right pr-0 col-form-label-sm">Department</label>
                            <div class="col-4">
                                <input id="department" type="text" class="form-control form-control-sm" value="@Model.DepartmentName" readonly style="border: none; outline: none; background: transparent;">
                            </div>
                        </div>
                        @* </fieldset> *@
                    </div>






                    <div class="row mb-2">


                        <label class="col-2 text-right pr-0 col-form-label-sm">Entry ID</label>
                        <div class="col-4">
                            @* <input id="entryId" type="text" class="form-control" value="@ViewBag.entryId" readonly> *@

                            <input id="entryId" type="text" class="form-control" value="@(ViewData["entryId"]?.ToString() ?? "")" readonly>
                        </div>
                    </div>

                    <!-- Leave Application Section -->
                    <div class="row mb-2">
                        <label class="col-2 text-right pr-0 col-form-label-sm required">Immediate Supervisor</label>
                        <div class="col-4">
                            <select id="immediateSupervisor" class="form-control  form-control-sm">
                                <option value="@Model.ReportingTo" selected>@($"{Model.ReportingFirstName} {Model.ReportingLastName}".Trim())</option>
                            </select>
                        </div>
                        <label class="col-2 text-right pr-0 col-form-label-sm">Head of Department</label>
                        <div class="col-4">
                            <select id="headOfDepartment" class="form-control  form-control-sm">
                                <option value="@Model.HOD" selected>@($"{Model.HODFirstName} {Model.HODLastName}".Trim())</option>
                            </select>
                        </div>
                    </div>






                    <div class="row mb-2">
                        <label class="col-2 text-right pr-0 col-form-label  form-control-sm required">Apply Leave Format</label>
                        <div class="col-4">
                            <select class="form-control  form-control-sm" id="applyLeaveFormat" name="selectedItem">
                                <option value="" selected>--Select Apply Leave Format--</option>
                                <option value="halfDayLeave">Half Leave</option>
                                <option value="fullDayLeave">Full Leave</option>
                                <option value="shortLeave">Short Leave</option>
                            </select>
                        </div>
                        <label class="col-2 text-right pr-0 col-form-label-sm ">Leave Type</label>
                        <div class="col-4">
                          

                            <select id="leaveTypeDropdown" name="selectedItem" class="form-control form-control-sm">
                                <option value="">--Select--</option>
                            </select>

                        </div>
                    </div>

                 

                    <div id="fullDayInputs" class="row mb-2" style="display: none;">
                        <label class="col-2 text-right pr-0 col-form-label form-control-sm required">From</label>
                        <div class="col-4">
                            <input type="text" id="fromDate" class="form-control form-control-sm" placeholder="Select date" readonly>
                        </div>
                        <label class="col pr-1 col-form-label">Day(s)</label>
                        <div class="col px-0">
                            <input type="text" id="daysBetween" class="form-control text-center px-0 form-control-sm" readonly>
                        </div>
                        <label class="col text-right px-0 col-form-label form-control-sm required">To</label>
                        <div class="col-4">
                            <input type="text" id="toDate" class="form-control form-control-sm" placeholder="Select date" readonly>
                        </div>
                    </div>

                 

                    <div id="halfDayInputs" class="row mb-2" style="display: none;">
                        <label class="col-2 text-right pr-0 col-form-label form-control-sm">Date</label>
                        <div class="col-4">
                            <input type="text" id="halfDate" class="form-control form-control-sm" placeholder="Select date" readonly>
                        </div>
                        <label class="col-2 text-right pr-0 col-form-label form-control-sm">Half Day</label>
                        <div class="col-4">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" id="halfDayCheckbox">
                                <label class="form-check-label" for="halfDayCheckbox">Half Day</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="halfDayType" id="firstHalf">
                                <label class="form-check-label" for="firstHalf">First Half</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="halfDayType" id="secondHalf">
                                <label class="form-check-label" for="secondHalf">Second Half</label>
                            </div>
                        </div>
                    </div>

                   


                    <div id="oneDayInputs" class="row mb-2" style="display: none;">
                        <label class="col-2 text-right pr-0 col-form-label form-control-sm required">From</label>
                        <div class="col-4">
                            <input type="text" id="fromTime" class="timepicker" style="display:none;" readonly />
                            <input type="hidden" id="fromTimeHidden" />
                        </div>
                        <label class="col pr-1 col-form-label">Hour</label>
                        <div class="col px-1">
                            <input type="text" id="hoursBetween" class="form-control px-0 text-center form-control-sm" readonly>
                        </div>
                        <label class="col pl-0 text-right pr-0 col-form-label-sm required">To</label>
                        <div class="col-4">
                            <input type="text" id="toTime" class="timepicker" style="display:none;" readonly />
                            <input type="hidden" id="toTimeHidden" />
                        </div>
                        <label class="col-2 text-right mt-2 pr-0 col-form-label form-control-sm required">Date</label>
                        <div class="col-4">
                            <input type="text" id="shortDate" class="form-control mt-2 form-control-sm">
                        </div>
                    </div>






                    <div class="row mb-2">
                        <label class="col-2 text-right pr-0 col-form-label-sm">File Attachment</label>
                        <div class="col-4">
                            <input type="file" class="form-control  form-control-sm" id="leaveFile">
                        </div>
                    </div>

                    <div class="row mb-2">
                        <label class="col-2 text-right pr-0 col-form-label-sm">Reason</label>
                        <div class="col-4">
                            <textarea class="form-control  form-control-sm " name="Reason" rows="3"></textarea>
                        </div>
                        @*<div class="col-6 text-end">
            <button type="submit" class="btn btn-primary">Leave Apply</button>
        </div>*@


                        <div class="col-4 text-end">
                            <button type="submit" id="leaveSubmitBtn" class="btn btn-primary">
                                <span class="btn-text">Leave Apply</span>
                                <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                            </button>
                        </div>




                    </div>






                    <div id="calendarContainer" class="row mb-2">
                        @* style="display: none; " *@
                        <div class="col-12">
                            <div id="calendar"></div>
                        </div>
                    </div>













                </form>
            </div>
        </div>






    </div>

    <div class="col-lg-4 pr-3 pl-1">
        <!-- First Card: Leave Status Table -->
        <div class="card ">
            <div class="card-header">
                <h5 class="mt-0"><b>Leave Status</b></h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="leaveAvailableTable" class="display table table-striped table-bordered table-common table-hover" style="width:100%">
                        <thead style="text-align : center">
                            <tr>
                                <th>LN</th>
                                <th>YLE</th>
                                <th>TAK</th>
                                <th>BAL</th>
                                <th>Sh.L</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Data rows will go here -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Second Card: Approved Leave Table -->
        <div class="card " style="height: 654px;">
            <div class="card-header">
                <h5 class="mt-0"><b>Pending Leave</b></h5>
            </div>


            

            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">

                    <select id="leaveTakenPageSize" class="form-control form-control-sm d-inline-block" style="width:auto; margin-left:8px;">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>

                    <input type="text" id="leaveTakenSearch" class="form-control form-control-sm"
                           placeholder="Search..." style="width:160px !important;">
                </div>

                <div class="table-responsive" style="max-height:340px; overflow-y:auto;">
                    <table id="leaveTakenTable" class="table table-sm table-common table-hover table-striped table-bordered dt-look mb-0">
                        <thead>
                            <tr>
                                <th data-col="leaveAppEntryId" style="cursor:pointer">Leave Id <i class="fas fa-sort"></i></th>
                                <th data-col="startDate" style="cursor:pointer">Start Date <i class="fas fa-sort"></i></th>
                                <th data-col="endDate" style="cursor:pointer">End Date <i class="fas fa-sort"></i></th>
                                <th>Applied Days</th>
                                <th data-col="noOfDay" style="cursor:pointer">No of Days <i class="fas fa-sort"></i></th>
                                <th>Reason</th>
                            </tr>
                        </thead>
                        <tbody id="leaveTakenTbody">
                        </tbody>
                        <tfoot class="bg-light">
                            <tr>
                                <th colspan="4" class="text-right">Total:</th>
                                <th id="leaveTakenTotalFooter">0</th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <div class="d-flex justify-content-between ">
                    <div id="leaveTakenInfo" class="small text-muted"></div>
                    <div id="leaveTakenPaginationWrap" class="d-flex justify-content-between align-items-center mt-2"></div>
                </div>

               
            </div>
       
        
        
        </div>
    </div>



</div>




<div class="row card mx-2">
    <div class="col-lg-12">

        @* Search bar *@
        <div class="d-flex justify-content-between align-items-center mx-3 mb-2">
            <div id="showres" class="d-flex align-items-center flex-wrap gap-2 mt-2"></div>
            <div class="d-flex align-items-center gap-2">
                <input type="text" id="gridSearchInput" class="form-control form-control-sm"
                       placeholder="Search employee, leave type, reason..." style="width:280px;" />
            </div>
        </div>

        <div class="mt-2 table-responsive">
            <table id="leaveApplicationsTable" class="table table-striped table-bordered table-common table-hover" style="width:100%">
                <thead>
                    <tr>
                        <th class="text-center">Action</th>
                        <th class="text-center" data-col="leaveappentryid" style="cursor:pointer">Leave Id <i class="fas fa-sort"></i></th>
                        <th class="text-center" data-col="applyleaveformat" style="cursor:pointer">Leave Format <i class="fas fa-sort"></i></th>
                        <th class="text-center" data-col="approvalstatus" style="cursor:pointer">Approval Status <i class="fas fa-sort"></i></th>
                        <th class="text-center" data-col="employeeid" style="cursor:pointer">Employee ID <i class="fas fa-sort"></i></th>
                        <th class="text-center" data-col="employeename" style="cursor:pointer">Name <i class="fas fa-sort"></i></th>
                        <th class="text-center" data-col="leavetype" style="cursor:pointer">Leave Type <i class="fas fa-sort"></i></th>
                        <th class="text-center">Attested File</th>
                        <th class="text-center" data-col="startdate" style="cursor:pointer">Start Date <i class="fas fa-sort"></i></th>
                        <th class="text-center" data-col="enddate" style="cursor:pointer">End Date <i class="fas fa-sort"></i></th>
                        <th class="text-center">Calendar Dates</th>
                        <th class="text-center" data-col="noofday" style="cursor:pointer">No Of Days <i class="fas fa-sort"></i></th>
                        <th class="text-center">Reason</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td colspan="13" class="text-center">Loading...</td></tr>
                </tbody>
            </table>
        </div>

        @* Pagination controls *@
        <div id="gridPaginationWrap" class="d-flex align-items-center justify-content-between flex-wrap gap-2 m-3">
        </div>

    </div>
</div>






<style>
    #leaveApplicationsTable th, #leaveApplicationsTable td {
        white-space: normal;
        word-wrap: break-word;
        padding: 4px 6px;
    }

    #leaveApplicationsTable thead th[data-col]:hover {
        background-color: #e9ecef;
    }

    #leaveApplicationsTable thead th.sort-asc .fas.fa-sort:before {
        content: "\f0de";
    }

    #leaveApplicationsTable thead th.sort-desc .fas.fa-sort:before {
        content: "\f0dd";
    }



    /* Custom padding for DataTable cells */
    .dt-custom-padding {
        padding: 3px 3px !important; /* Vertical padding 12px, horizontal padding 8px */
    }


        .dt-custom-padding.sorting,
        #leaveAvailableTable thead th {
            /*  padding: 12px 2px !important;  */ /* Increased header padding */
            font-weight: bold;
        }


        /* Optional: Add hover effect */
        .dt-custom-padding:hover {
            background-color: #f5f5f5;
        }

    /* Optional: Align text in cells */
    #leaveAvailableTable td {
        text-align: center;
    }

    #leaveAvailableTable th {
        text-align: center;
    }


    .dataTable tbody tr:nth-child(odd) {
        background-color: #f9f9f9; /* Light gray for odd rows */
    }

    .dataTable tbody tr:nth-child(even) {
        background-color: #d9b7b71c; /* White for even rows */
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.4/index.global.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.4/index.global.min.css">



    <script src="~/js/pages/LeaveApply.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

}
