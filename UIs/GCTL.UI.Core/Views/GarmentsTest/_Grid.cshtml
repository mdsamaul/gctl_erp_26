@model List<GCTL.Core.ViewModels.GarmentsTest.GarmentsTestSetupViewModel>

<table id="GarmentsTest-grid" class="table table-striped  table-bordered table-sm table-hover table-common">
    <thead class="row-border">
        <tr class="table row-border">
            <th class="text-center text-middle" style="width: 10%;">
                Select <br /> <input type="checkbox" id="GarmentsTest-check-all" />
            </th>
            <th class="text-center text-middle" style="width: 10%;">ID</th>
            <th class="text-center text-middle" style="width: 40%;"> Garments Test Name</th>
            <th class="text-center text-middle" style="width: 40%;">Details</th>

        </tr>
    </thead>
    <tbody>

        @if (Model == null || !Model.Any())
        {
            <tr class="text-center text-middle">
                <td colspan="8">No Data Available.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model.OrderByDescending(x => x.GarmentsTestD))
            {
                <tr>
                    <td class="text-center">
                        <input type="checkbox" class="text-center text-middle checkBox" data-id="@item.GarmentsTestD" value="@item.GarmentsTestD" />
                    </td>
                    <td>
                        <a href="#" class='btn js-GarmentsTest-edit'
                           style="text-decoration: underline; color: rebeccapurple;"
                           data-id="@item.GarmentsTestD" title="Edit">
                            @item.GarmentsTestD
                        </a>
                    </td>

                    <td class="text-center text-middle">@item.GarmentsTestName</td>
                    <td class="text-center text-middle">@item.Details</td>

                </tr>
            }
        }

    </tbody>
</table>