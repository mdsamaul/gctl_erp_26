@model List<GCTL.Core.ViewModels.DeliveryMethodInfo.DeliveryMethodInfoSetupViewModel>

<table id="DeliveryMethodInfo-grid" class="table table-striped  table-bordered table-sm table-hover table-common">
    <thead class="row-border">
        <tr class="table row-border">
            <th class="text-center text-middle" style="width: 10%;">
                Select <br /> <input type="checkbox" id="DeliveryMethodInfo-check-all" />
            </th>
            <th class="text-center text-middle" style="width: 10%;">ID</th>
            <th class="text-center text-middle" style="width: 45%;"> Delivery Method</th>
            <th class="text-center text-middle" style="width: 35%;"> Detail</th>

        </tr>
    </thead>
    <tbody>

        @if (Model == null || !Model.Any())
        {
            <tr class="text-center text-middle">
                <td colspan="8">No Data Available.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model.OrderByDescending(x => x.DeliveryMethodId))
            {
                <tr>
                    <td class="text-center">
                        <input type="checkbox" class="text-center text-middle checkBox" data-id="@item.DeliveryMethodId" value="@item.DeliveryMethodId" />
                    </td>
                    <td>
                        <a href="#" class='btn js-DeliveryMethodInfo-edit'
                           style="text-decoration: underline; color: rebeccapurple;"
                           data-id="@item.DeliveryMethodId" title="Edit">
                            @item.DeliveryMethodId
                        </a>
                    </td>

                    <td class="text-center text-middle">@item.DeliveryMethod</td>
                    <td class="text-center text-middle">@item.Detail</td>

                </tr>
            }
        }

    </tbody>
</table>