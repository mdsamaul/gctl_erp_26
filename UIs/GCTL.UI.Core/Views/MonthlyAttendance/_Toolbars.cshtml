@model ToobarModel
<div class="row align-items-center">
	<div class="col-md-5">
		<h6 class="page-title px-3 text-black font-weight-bold">Monthly Attendance Details Report</h6>
	</div>
	<div class="col-md-7">
		<div class="btn-toolbar d-flex justify-content-end">
			<div class="btn-group">
				<button type="button" class="btn btn-default primary-btn js-jobcard-bulk-report-clear js-monthly-attendance-clear" id="js-jobcard-bulk-report-clear" data-toggle="tooltip" data-placement="bottom" title="Clear">
					<i class="fa fa-eraser">&nbsp;</i> Clear
				</button>
				<button type="button" class="btn btn-default info-btn js-jobcard-bulk-report-print js-monthly-attendance-print" id="js-jobcard-bulk-report-print" data-toggle="tooltip" data-placement="bottom" title="Print">
					<i class="fa fa-print">&nbsp;</i> Print
				</button>
				<button type="button" class="btn btn-default warning-btn js-jobcard-bulk-report-favorite js-monthly-attendance-favorite" id="js-jobcard-bulk-report-favorite" data-toggle="tooltip" data-placement="bottom" title="Favorite">
					<i class="fa fa-star">&nbsp;</i> Favorite
				</button>
			</div>
		</div>
	</div>
</div>
