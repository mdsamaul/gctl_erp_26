@model GCTL.UI.Core.ViewModels.HrmLeaveSummaryReports.LeaveSummaryPageViewModel


@{
    ViewData["Title"] = Model.PageTitle;
}


<style>
    #downloadBtn:hover,
    #previewBtn:hover {
        background-color: #ffffe6 !important;
        border-color: #28a745 !important;
        color: green !important;
    }

    .multiselect-container.dropdown-menu {
        min-width: 100% !important;
        width: auto;
    }

    .btn-group.single-select .multiselect-container input[type="radio"] {
        display: none !important;
    }

    .btn-group.single-select .multiselect-container label {
        padding-left: 0px;
    }

    .btn-toolbar .btn {
        -webkit-border-radius: 0px !important;
    }

    .btn-toolbar .btn-group {
        min-width: 0px !important;
    }

</style>

<section>
    <div class="container-fluid">
        <div class="row px-2 pr-3">

            <div class="col-12">
                <partial name="_PageHeader" model="@Model" />

            </div>

            
        </div>
        <div class="card  mx-2   border" style="border-radius: 7px;">
            <div class="card-body rounded-md" style="padding: 1rem;">
                <!-- Search By Section -->
                <div class="row">

                    <div class="col-md-12 pr-0">
                        <div class="w-100 headerToobar">
                            <partial name="_Toolbar" model="new ToobarModel() { Title = @Model.Breadcrumb, Code = @Model.Code }" />
                        </div>
                    </div>

                    <div class="col-6">
                        <h6 class="font-weight-bold fs-6 mb-2">Search By:</h6>
                        <hr class="mt-0 mb-3">
                    </div>
                </div>

                <div class="row">
                    <!-- Left Column -->
                    <div class="col-md-6 dropdown-wrapper">
                        <!-- Company -->
                        <div class="row align-items-center mb-3">
                            <label class="col-5 text-right mb-0 pr-3">Company</label>
                            <div class="col-6 ">
                                <select id="companySelect" class="form-control form-control-sm" autofocus>
                                </select>
                            </div><div class="col-1"></div>
                        </div>

                        <!-- Department -->
                        <div class="row align-items-center mb-3">
                            <label class="col-5 text-right mb-0 pr-3">Department</label>
                            <div class="col-6 ">
                                <select id="departmentSelect" class="form-control form-control-sm" multiple>
                                </select>
                            </div><div class="col-1"></div>
                        </div>

                        <!-- Employee -->
                        <div class="row align-items-center mb-3">
                            <label class="col-5 text-right mb-0 pr-3">Employee</label>
                            <div class="col-6">
                                <select id="employeeSelect" class="form-control form-control-sm gc-multiselect-load-data" multiple="multiple" data-placeholder="Select Employee">
                                </select>
                            </div><div class="col-1"></div>
                        </div>
                    </div>

                    <!-- Right Column -->
                    <div class="col-md-6  dropdown-wrapper">
                        <!-- Branch -->
                        <div class="row align-items-center mb-3">
                            <label class="col-5 text-right mb-0 pr-3">Branch</label>
                            <div class="col-6 ">
                                <select id="branchSelect" class="form-control form-control-sm" multiple>
                                </select>
                            </div>
                            <div class="col-1"></div>
                        </div>

                        <!-- Designation -->
                        <div class="row align-items-center mb-3">
                            <label class="col-5 text-right mb-0 pr-3">Designation</label>
                            <div class="col-6 ">
                                <select id="designationSelect" class="form-control form-control-sm" multiple>
                                </select>
                            </div>
                            <div class="col-1"></div>
                        </div>
                    </div>
                </div>

                <!-- Report Option Section -->
                <div class="row mt-4">
                    <div class="col-6">
                        <h6 class="font-weight-bold fs-6 mb-2">Report Option:</h6>
                        <hr class="mt-0 mb-3">
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <!-- Export Report Format -->
                        <div class="row align-items-center mb-3">
                            <label class="col-5 text-right mb-0 pr-3">Export Report Format</label>
                            <div class="col-6">
                                <select id="exportFormatSelect" class="form-control form-control-sm">
                                    <option value="pdf">PDF</option>
                                    <option value="word">Word Document</option>
                                    <option value="excel">Excel Spreadsheet</option>
                                    <option value="download">Direct Download</option>
                                </select>
                            </div><div class="col-1"></div>
                        </div>
                    </div>

                    <div class="col-md-6"></div>
                    <div class="col-md-6"></div>
                        <div class="col-md-6">
                            <!-- Action Buttons -->
                            <div class="row">
                                <div class="col-11 d-flex justify-content-end">
                                    <button type="button" class="col-md-3 btn btn-default success-btn btn-sm mr-2" id="downloadBtn">
                                        <i class="fas fa-file-export"></i> Export
                                    </button>
                                    <button type="button" class="col-md-3 btn btn-default success-btn btn-sm" id="previewBtn">
                                        <i class="fas fa-eye"></i> Preview
                                    </button>
                                </div><div class="col-1"></div>
                            </div>
                        </div>
                    </div>
                </div>
        </div>
    </div>

    <div class="mt-4">
        <partial name="_LeaveSummaryPreview" />
    </div>
        <partial name="_BottomNavigation" />

</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/customMultiSelect/each-gc-multiselect.js"></script>
    <script src="~/js/pages/leaveSummaryReport.js"></script>
    <link href="~/lib/bootstrap-multiselect-master/dist/css/bootstrap-multiselect.min.css" rel="stylesheet" />
    <script src="~/lib/bootstrap-multiselect-master/dist/js/bootstrap-multiselect.min.js"></script>

    <script type="text/javascript">
        $(function () {
            $.leaveSummaryReport({
                baseUrl: '@Url.Action("Index", "HrmLeaveSummaryReport")',
                load: function () {
                    console.log("Custom load logic called from Razor view");
                }
            });
        });
    </script>
}
