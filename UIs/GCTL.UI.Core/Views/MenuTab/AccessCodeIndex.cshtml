@model GCTL.UI.Core.ViewModels.AccessCodes.AccessCodePageViewModel
@{
    ViewBag.Title = "Access Code";
    Model.Breadcrumb = "AccessCode";
    Model.PageTitle = ViewBag.Title;
}

<partial name="_PageHeader" model="Model" />
<div class="container-fluid">
    <div class="row">
        <div class="col-md-6 pr-0">
            <div class="card">
                <div class="card-header px-2">
                    <div class="row">
                        <div class="col-md-5">
                            <h6 class="page-title">@Model.PageTitle</h6>
                        </div>
                        <div class="col-md-7">
                            <div class="btn-toolbar d-flex justify-content-end">
                                <div class="btn-group">
                                    <button type="button" class="btn btn-default success-btn js-access-code-save">
                                        <i class="fa fa-save">&nbsp;</i> Save
                                    </button>
                                    <button type="button" class="btn btn-default danger-btn js-access-code-delete-confirm">
                                        <i class="fa fa-trash">&nbsp;</i>
                                        Delete
                                    </button>
                                    <button type="button" class="btn btn-default primary-btn js-access-code-clear">
                                        <i class="fas fa-sync">&nbsp;</i>
                                        Clear
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body p-2">
                    <form id="access-code-form">
                        <div class="js-access-code-form-container">
                            <partial name="AccessCodeSetup" model="Model.Setup" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-body p-2 pt-3">
                    <div class="js-access-code-grid-container">
                        <div class="table-responsive">
                            <table id="access-code-grid" class="table table-striped table-bordered table-sm table-common">
                                <thead>
                                    <tr>
                                        <th class="text-center text-middle" width="5%">
                                            Select <br /> <input type="checkbox" id="access-code-check-all" />
                                        </th>
                                        <th class="text-center text-middle">ID</th>
                                        <th class="text-center text-middle">Name</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <partial name="_BottomNavigation" />
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/pages/accessCodesEntry.js"></script>
    <script type="text/javascript">
        var options = {
            isModal: false
        };
        options.load = () => {

        };
        $.accessCodeEntries(options);
    </script>
}