<div class="container-fluid py-3">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="#">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Navigation</li>
        </ol>
    </nav>

    <!-- Main Card -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center bg-white py-3">
            <h5 class="mb-0">Navigation</h5>
            <div class="d-flex header-buttons">
                <button id="submitCoreMenuTabBtn" class="btn btn-outline-primary btn-sm">
                    <i class="fas fa-save me-1"></i> Save
                </button>
                <button id="deleteSelectedBtn" class="btn btn-outline-danger btn-sm">
                    <i class="fas fa-trash me-1"></i> Delete
                </button>
                <button id="resetButton" class="btn btn-outline-secondary btn-sm">
                    <i class="fas fa-broom me-1"></i> Clear
                </button>
                <button id="saveOrderBtn" class="btn btn-outline-dark btn-sm">
                    <i class="fas fa-sort me-1"></i> Save Sort Order
                </button>
            </div>
        </div>
        <div class="card-body">
            <form id="navigationForm">
                <div class="row g-3">
                    <!-- Menu ID -->
                    <div class="col-md-6">
                        <label for="MenuCode" class="form-label">Menu Id</label>
                        <input type="text" class="form-control" id="MenuCode" value="" readonly>
                    </div>
                    <div class="col-md-6">
                        <label for="OrderBy" class="form-label">Order</label>
                        <input type="number" class="form-control" id="OrderBy" readonly>
                    </div>

                </div>

                <input type="hidden" id="AutoId" value="0">

                <div class="row mt-2 g-3">

                    <!-- Title -->
                    <div class="col-md-3">
                        <label for="Title" class="form-label">Title <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="Title" required>
                    </div>

                      

                    <!-- Controller -->
                    <div class="col-md-3">
                        <label for="ControllerName" class="form-label">Controller <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="ControllerName" required>
                    </div>

                    <!-- Action -->
                    <div class="col-md-3">
                        <label for="ViewName" class="form-label">Action</label>
                        <input type="text" class="form-control" id="ViewName">
                    </div>

                    <!-- Table -->
                    <div class="col-md-3">
                        <label for="TableName" class="form-label">Table</label>
                        <input type="text" class="form-control" id="TableName">
                    </div>

                   

                    <!-- Icon -->
                    <div class="col-md-3">
                        <label for="Icon" class="form-label marTop">Icon</label>
                        <input type="text" class="form-control" id="Icon" placeholder="fa fa-home">
                    </div>


                    <style>
                        /* Custom Smaller Toggle Switch */
                        .switch {
                            position: relative;
                            display: inline-block;
                            width: 40px; /* reduced width */
                            height: 20px; /* reduced height */
                        }

                            .switch input {
                                opacity: 0;
                                width: 0;
                                height: 0;
                            }

                        .slider {
                            position: absolute;
                            cursor: pointer;
                            top: 0;
                            left: 0;
                            right: 0;
                            bottom: 0;
                            background-color: #ccc;
                            transition: 0.4s;
                            border-radius: 34px;
                        }

                            .slider:before {
                                position: absolute;
                                content: "";
                                height: 14px; /* smaller knob */
                                width: 14px;
                                left: 3px;
                                bottom: 3px;
                                background-color: white;
                                transition: 0.4s;
                                border-radius: 50%;
                            }

                        input:checked + .slider {
                            background-color: #1b1464; /* dark blue */
                        }

                            input:checked + .slider:before {
                                transform: translateX(20px); /* smaller move */
                            }
                    </style>






                    <div class="col-md-3">
                        <div class="form-group mt-1">
                            <div class="d-flex justify-content-between align-items-center">
                                <label for="ParentToggle" class="form-label mb-0">Parent Node</label>
                                <label class="switch">
                                    <input type="checkbox" id="ParentToggle" checked>
                                    <span class="slider"></span>
                                </label>
                            </div>
                            <select id="ParentId" class="form-control fff mt-2">
                                <option value="">Select Parent Node</option>
                                
                            </select>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group mt-1">
                            <div class="d-flex justify-content-between align-items-center">
                                <label for="ChildToggle" class="form-label mb-0">Child Node</label>
                                <label class="switch">
                                    <input type="checkbox" id="ChildToggle" checked>
                                    <span class="slider"></span>
                                </label>
                            </div>
                            <select id="ChildId" class="form-control fff mt-2">
                                <option value="">Select Child Node</option>
                               
                            </select>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group mt-1">
                            <div class="d-flex justify-content-between align-items-center">
                                <label for="GrandChildToggle" class="form-label mb-0">Grand Child Node</label>
                                <label class="switch">
                                    <input type="checkbox" id="GrandChildToggle" checked>
                                    <span class="slider"></span>
                                </label>
                            </div>
                            <select id="GChildId" class="form-control fff mt-2">
                                <option value="">Select Grand Child Node</option>
                                
                            </select>
                        </div>
                    </div>








                    <!-- Parent Node -->
                   

                    <!-- Is Active -->
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="IsActive" checked>
                            <label class="form-check-label" for="IsActive">
                                Is Active?
                            </label>
                        </div>
                    </div>

                    <!-- 
                    <div class="col-12 text-end mt-1">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save me-1"></i> Save
                        </button>
                    </div>-->
                </div>
            </form>
        </div>
    </div>


    <style>
        .level-1 td {
            padding-left: 2rem;
            background: #f9f9f9;
        }

        .level-2 td {
            padding-left: 3rem;
            background: #f0f0f0;
        }

        .level-3 td {
            padding-left: 4rem;
            background: #e9e9e9;
        }

        .toggle-icon {
            cursor: pointer;
            color: blue;
            margin-right: 5px;
        }

    </style>


    <div class="table-responsive">
        <table class="table table-bordered" id="menuTable">
            <thead>
                <tr>
                    <th>Menu</th>
                    <th>Order</th>
                    <th>Title</th>
                    <th>ControllerName</th>
                    <th>Action</th>
                    <th>Active</th>
                </tr>
            </thead>
            <tbody id="menuTableBody" class="sortable-table">
                <!-- Filled by JS -->
            </tbody>
        </table>
    </div>



    



