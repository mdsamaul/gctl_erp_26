@{
    ViewData["Title"] = "Index";
}

<style>
    /* Hierarchy level styles */
    .menu-item {
        position: relative;
        transition: background-color 0.2s;
    }

        .menu-item:hover {
            background-color: #f8f9fa;
        }

    /* Level indicators - subtle background colors */
    .level-0 {
        font-weight: 500;
    }

    .level-1 {
        border-left: 3px solid #e6f2ff;
    }

    .level-2 {
        border-left: 3px solid #ccebff;
    }

    .level-3 {
        border-left: 3px solid #b3e0ff;
    }

    /* Drag handle styling */
    .drag-handle {
        cursor: move;
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #aaa;
        opacity: 0.5;
        transition: opacity 0.2s;
    }

    .menu-item:hover .drag-handle {
        opacity: 1;
    }

    /* Visual indicator for dragging */
    .ui-sortable-helper {
        background-color: #e9f5ff !important;
        border: 1px dashed #007bff;
        box-shadow: 0 2px 5px rgba(0,0,0,0.15);
    }

    .ui-sortable-placeholder {
        visibility: visible !important;
        background-color: #f0f8ff;
        border: 1px dashed #ccc;
        height: 50px;
    }

    /* Table toggle styles */
    .toggle-table {
        user-select: none;
    }

        .toggle-table span {
            display: inline-block;
            width: 16px;
            transition: transform 0.2s;
        }

    .marTop{
		margin-top: 3%
    }
</style>


