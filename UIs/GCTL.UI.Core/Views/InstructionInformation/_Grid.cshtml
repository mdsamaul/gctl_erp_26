@model List<GCTL.Core.ViewModels.InstructionInformation.InstructionInformationSetupViewModel>

<table id="InstructionInformation-grid" class="table table-striped  table-bordered table-sm table-hover table-common">
    <thead class="row-border">
        <tr class="table row-border">
            <th class="text-center text-middle" style="width: 10%;">
                Select <br /> <input type="checkbox" id="InstructionInformation-check-all" />
            </th>
            <th class="text-center text-middle" style="width: 10%;">ID</th>
            <th class="text-center text-middle" style="width: 80%;"> Instruction</th>

        </tr>
    </thead>
    <tbody>

        @if (Model == null || !Model.Any())
        {
            <tr class="text-center text-middle">
                <td colspan="8">No Data Available.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model.OrderByDescending(x => x.InstructionId))
            {
                <tr>
                    <td class="text-center">
                        <input type="checkbox" class="text-center text-middle checkBox" data-id="@item.InstructionId" value="@item.InstructionId" />
                    </td>
                    <td>
                        <a href="#" class='btn js-InstructionInformation-edit'
                           style="text-decoration: underline; color: rebeccapurple;"
                           data-id="@item.InstructionId" title="Edit">
                            @item.InstructionId
                        </a>
                    </td>

                    <td class="text-center text-middle">@item.Instruction</td>

                </tr>
            }
        }

    </tbody>
</table>