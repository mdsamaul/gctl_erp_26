@model ToobarModel
<div class="row">
	<div class="col-md-5">
		<h6 class="page-title">@Model.Title</h6>
	</div>
	<div class="col-md-7">
		<div class="btn-toolbar d-flex justify-content-end">
			<div class="btn-group">
				<button type="button" class="btn btn-default success-btn js-buyer-dep-save" id="submitButton">
					<i class="fa fa-save">&nbsp;</i> Save
				</button>
				<button type="button" class="btn btn-default danger-btn" id="js-buyer-dep-delete-confirm">
					<i class="fa fa-trash">&nbsp;</i> Delete
				</button>
				<button type="button" class="btn btn-default primary-btn " id="js-buyer-dep-clear">
					<i class="fa fa-eraser">&nbsp;</i> Clear
				</button>
			</div>
		</div>
	</div>
</div>