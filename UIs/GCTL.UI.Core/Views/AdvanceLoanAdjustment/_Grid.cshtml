<style>
    /* Main table styling */
    #advancePayTable {
        width: 100% !important;
        table-layout: fixed;
    }

    /* Make sure header takes full width */
    .dataTables_scrollHeadInner,
    .dataTables_scrollHeadInner table {
        width: 100% !important;
    }

    /* Common cell styling */
    #advancePayTable thead th,
    #advancePayTable tbody td {
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        text-align: center;
    }

    /* Individual column widths */
    #advancePayTable th:nth-child(1),
    #advancePayTable td:nth-child(1) {
        width: 60px !important;
        min-width: 60px;
    }

    #advancePayTable th:nth-child(2),
    #advancePayTable td:nth-child(2) {
        width: 100px !important;
        min-width: 100px;
    }

    #advancePayTable th:nth-child(3),
    #advancePayTable td:nth-child(3) {
        width: 100px !important;
        min-width: 100px;
    }

    #advancePayTable th:nth-child(4),
    #advancePayTable td:nth-child(4) {
        width: 150px !important;
        min-width: 150px;
    }

    #advancePayTable th:nth-child(5),
    #advancePayTable td:nth-child(5) {
        width: 120px !important;
        min-width: 120px;
    }

    /* Left align text in name and designation columns */
    #advancePayTable td:nth-child(4),
    #advancePayTable td:nth-child(5) {
        text-align: left;
    }

    #advancePayTable th:nth-child(6),
    #advancePayTable td:nth-child(6) {
        width: 100px !important;
        min-width: 100px;
    }

    #advancePayTable th:nth-child(7),
    #advancePayTable td:nth-child(7) {
        width: 80px !important;
        min-width: 80px;
    }

    #advancePayTable th:nth-child(8),
    #advancePayTable td:nth-child(8) {
        width: 100px !important;
        min-width: 100px;
    }

    #advancePayTable th:nth-child(9),
    #advancePayTable td:nth-child(9) {
        width: 120px !important;
        min-width: 120px;
    }
    
    #advancePayTable th:nth-child(10),
    #advancePayTable td:nth-child(10) {
        width: 80px !important;
        min-width: 80px;
    }

    #advancePayTable th:nth-child(11),
    #advancePayTable td:nth-child(11) {
        width: 80px !important;
        min-width: 80px;
    }

    /* Style for clickable IDs */
    #advancePayTable tbody a {
        color: blue;
        text-decoration: underline;
        cursor: pointer;
    }

        #advancePayTable tbody a:hover {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

    /* Responsive styling */
    @@media screen and (max-width: 767px) {
        .table-responsive {
            border: 0;
            overflow-x: auto;
        }

        #advancePayTable {
            width: 100% !important;
            margin-bottom: 15px;
            overflow-y: hidden;
        }
    }
</style>

<!-- DataTable -->
<div class="table-responsive">
    <div class="py-2">
        <h5>Advance/Loan List:</h5>
    </div>
    <table id="advancePayTable" class="table table-striped table-bordered table-sm table-common" style="width:100%">
        <thead>
            <tr>
                <th class="text-center text-middle">Select
                    <br /><input type="checkbox" id="selectAllCheckbox" />
                </th>
                <th class="text-center text-middle">Adjustment ID</th>
                <th class="text-center text-middle">Employee ID</th>
                <th class="text-center text-middle">Name</th>
                <th class="text-center text-middle">Designation</th>
                <th class="text-center text-middle">Loan ID</th>
                <th class="text-center text-middle">No. Of Inst(s)</th>
                <th class="text-center text-middle">Loan Amount</th>
                <th class="text-center text-middle">Monthly Deduction</th>
                <th class="text-center text-middle">Salary Month</th>
                <th class="text-center text-middle">Salary Year</th>   
            </tr>
        </thead>
        <tbody id="advancePayTable-body" class="w-100">
            <!-- Data will be loaded here -->
        </tbody>
    </table>
</div>