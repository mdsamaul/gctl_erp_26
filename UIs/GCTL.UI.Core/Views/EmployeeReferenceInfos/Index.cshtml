@model GCTL.UI.Core.ViewModels.HrmEmployeeEducations.HrmEmployeeEducationsPageViewModel


@{

    Model.PageTitle = ViewBag.Title;
    ViewBag.Title = "Educational Info Entry";
    Model.Breadcrumb = "Educational Info Entry";
}

<!-- Content Header (Page header) -->
<partial name="_PageHeader" model="Model" />

<section class="content consistent-look">
    <div class="container-fluid">
        <div class="row">


            <div class="col-md-6 pr-0">
                <div class="card">
                    <div class="card-header px-2">
                        <partial name="_Toolbars" model="new ToobarModel() { Title = Model.Breadcrumb, Code = Model.Code, Name = Model.Setup.EmpEduCode }" />
                    </div>
                    <div class="card-body px-2">

                        <form asp-action="Setup" method="post" id="HrmEmployeeEducations-form" asp-controller="HrmEmployeeEducations">

                            <div class="js-HrmEmployeeEducations-form-container">

                                @await Html.PartialAsync("_Setup", Model.Setup)
                            </div>



                        </form>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card">
                    <div class="card-body p-2 pt-3">
                        <div class="js-HrmEmployeeEducations-grid-container">
                            @await Html.PartialAsync("_Grid", Model.TableListData)
                        </div>
                    </div>
                </div>
            </div>


        </div>


        <partial name="_BottomNavigation" />
    </div>
</section>
<partial name="DeleteModal" />
<partial name="QuickAddModal" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/pages/hrmEmployeeEducations.js"></script>
    <script type="text/javascript">
        var options = {
            baseUrl: '@Url.Action("", "HrmEmployeeEducations")'
        };
        options.load = () => {
        };

        $.hrmEmployeeEducations(options);
    </script>
} *@

