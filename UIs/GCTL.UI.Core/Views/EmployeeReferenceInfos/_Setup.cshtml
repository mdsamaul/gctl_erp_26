@using GCTL.Core.ViewModels.EmployeeReferenceInfos

@model GCTL.Core.ViewModels.EmployeeReferenceInfos.EmployeeReferenceInfosSetupViewModel
@{

    var list = ViewData["List"] as List<EmployeeReferenceInfosSetupViewModel>;

}


<div id="customLoadingOverlay" style="
        display: flex;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 9999;
        justify-content: center;
        align-items: center;">
    <div style="
            background-color: white;
            padding: 20px;
            border-radius: 5px;
            box-shadow: 0 0 10px rgba(0,0,0,0.3);
            text-align: center;">
        <div class="spinner-border text-primary" role="status">
            <span class="sr-only"></span>
        </div>
        <p style="margin-top: 10px; margin-bottom: 0;"></p>
    </div>
</div>

<div style="padding-top:1px;">

    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>

    @*    <div class="card">
        <div class="card-body"> *@

    <div style="padding-top: 1px;">
        <div class="row">
            <div class="col-lg-12">
                @* <input type="hidden" id="lastCode" /> *@
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Ldate" />
                <input type="hidden" asp-for="ModifyDate" />
                <input type="hidden" asp-for="AutoId" />
                <input type="hidden" asp-for="EmpReferenceId" />
                
                <div class="card">
                    <div class="card-header px-2">
                        @await Html.PartialAsync("_TabButton")
                    </div>
                    <div class="card-body">
                        <div class="row">

                            <div class="col-lg-6">
                                <div class="form-group d-flex align-items-center justify-content-between">
                                    <label class="d-flex justify-content-end form-label col-form-label-sm" asp-for="CompanyCode">Comapny<span style="color:red">*</span></label>
                                    @* <span class="text-danger">*</span> *@
                                    <div class="input-wrapper">
                                        <select asp-for="CompanyCode" tabindex="1" required data-placeholder="Select Company" class="form-control form-control-sm selectpickerrr js-" asp-items="@ViewBag.CoreCompanyDD as SelectList">
                                            <option value=""></option>
                                        </select>

                                    </div>
                                </div>

                            </div>

                            <div class="col-lg-6">
                                <div class="form-group d-flex align-items-center justify-content-between">
                                    <label class="d-flex justify-content-end form-label col-form-label-sm" asp-for="BranchCode">Branch</label>
                                    <div class="input-wrapper">
                                        <select asp-for="BranchCode" tabindex="1" data-placeholder="Select Branch" class="form-control form-control-sm selectpickerrr js-" asp-items="@ViewBag.CoreBranchDD as SelectList">
                                            <option value=""></option>
                                        </select>

                                    </div>
                                </div>

                            </div>


                        </div>
                        <div class="row">
                            <div class="col-6">
                                <div class="form-group d-flex align-items-center justify-content-between">
                                    <label class="d-flex justify-content-end form-label col-form-label-sm" asp-for="EmployeeId">Employee Id<span style="color:red">*</span> </label>
                                    @* <span class="text-danger">*</span> *@
                                    <div class="input-wrapper">
                                        <select asp-for="EmployeeId" tabindex="2" required data-placeholder="Select Employee" class="form-control form-control-sm selectpickerrr" asp-items="@ViewBag.EmployeeDD as SelectList">
                                            <option value=""></option>
                                        </select>

                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-group d-flex align-items-center justify-content-between">
                                    <label class="d-flex justify-content-end form-label col-form-label-sm" asp-for="EmployeeName">Employee Name:</label>
                                    <div class="input-wrapper">
                                        <span id="FullName" style="text-align: left; display: block;">@Model.EmployeeName</span>

                                    </div>
                                </div>
                            </div>


                        </div>
                        <div class="row">
                            <div class="col-6">
                                <div class="form-group d-flex align-items-center justify-content-between">
                                    <label class="d-flex justify-content-end form-label col-form-label-sm" asp-for="DesignationName">Designation:</label>
                                    <div class="input-wrapper">

                                        <span id="DesignationName" style="text-align: left; display: block;">@Model.DesignationName</span> <!-- Right aligned -->
                                    </div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="form-group d-flex align-items-center justify-content-between">
                                    <label class="d-flex justify-content-end form-label col-form-label-sm" asp-for="DepartmentName">Department:</label>
                                    <div class="input-wrapper">
                                        <span id="DepartmentName" style="text-align: left; display: block;">@Model.DepartmentName</span>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                <div style="display:none">Table List</div>
                <div class="js-EmployeeReferenceInfos-grid-container">
                     @* <partial name="_Grid" /> *@
                    @await Html.PartialAsync("_Grid", list)
                </div>



                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-4 ">
                                <label asp-for="ReferenceName" class="required">ReferenceName<span style="color:red">*</span></label>
                               @*  <span class="text-danger"></span> *@
                                <input asp-for="ReferenceName" class="form-control form-control-sm required" required placeholder="Enter ReferenceName" tabindex="9" />
                            </div>
                            <div class="col-lg-4">
                                <label asp-for="OrganizationName" class="required">Organization</label>
                                <input asp-for="OrganizationName" class="form-control form-control-sm required" placeholder="Enter OrganizationName" tabindex="10" />
                            </div>
                            <div class="col-lg-4">
                                <label asp-for="RefAddress" class="required">Address</label>
                                @* <span class="text-danger"></span> *@
                                <input asp-for="RefAddress" class="form-control form-control-sm  required" placeholder="Enter Address" tabindex="11" />
                            </div>
                        </div>
                        <div class="row">

                            <div class="col-lg-4 ">
                                <label asp-for="NationalityCode">Nationality</label>
                                <div class="input-group">
                                    <select asp-for="NationalityCode" tabindex="3" data-placeholder="Select Nationality" class="form-control form-control-sm selectpickerrr  " asp-items="@ViewBag.NationalityDD as SelectList">
                                        <option value=""></option>
                                    </select>

                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-sm btn-default js-quick-add input-group-textc"
                                                data-url="@Url.Action("Index", "Nationalitys")"
                                                data-target="#NationalityCode"
                                                data-reload-url="@Url.Action("GetNationalitys", "Cascading")"
                                                data-title="Nationalitys">
                                            +
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-4">
                                <label asp-for="Designation">Designation</label>
                                <div class="input-group">
                                    <select asp-for="Designation" tabindex="4" data-placeholder="Select Designation" class="form-control form-control-sm selectpickerrr " asp-items="@ViewBag.DesigDD as SelectList">
                                        <option value=""></option>
                                    </select>
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-sm btn-default js-quick-add input-group-textc"
                                                data-url="@Url.Action("Index", "Designations")"
                                                data-target="#Designation"
                                                data-reload-url="@Url.Action("GetDesignations", "Cascading")"
                                                data-title="Designation">
                                            +
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="col-lg-4">
                                <label asp-for="RelationId">Relationship</label>
                                <div class="input-group">
                                    <select asp-for="RelationId" tabindex="4" data-placeholder="Select Relationship" class="form-control form-control-sm selectpickerrr " asp-items="@ViewBag.RelationshipDD as SelectList">
                                        <option value=""></option>
                                    </select>
                                    <div class="input-group-append">
                                        <button type="button" class="btn btn-sm btn-default js-quick-add input-group-textc"
                                                data-url="@Url.Action("Index", "RelationShips")"
                                                data-target="#RelationId"
                                                data-reload-url="@Url.Action("GetRelationShip", "Cascading")"
                                                data-title="RelationShips">
                                            +
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>


                        <div class="row">
                            <div class="col-lg-4">
                                <label asp-for="MobileNumber">Mobile </label>
                                <span class="text-danger"></span>
                                <input asp-for="MobileNumber" class="form-control form-control-sm phone-validationx" placeholder="Enter Mobile " />
                                <span asp-validation-for="MobileNumber" class="text-danger" />
                            </div>
                            <div class="col-lg-4">
                                <label asp-for="PhoneNumber ">Phone </label>
                                <span class="text-danger"></span>
                                <input asp-for="PhoneNumber" class="form-control form-control-sm phone-validationx" placeholder="Enter Phone " />
                                <span asp-validation-for="PhoneNumber" class="text-danger" />
                            </div>
                            <div class="col-lg-4">
                                <label asp-for="Fax ">Fax</label>
                                <span class="text-danger"></span>
                                <input asp-for="Fax " class="form-control form-control-sm" placeholder="Enter Fax" />

                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-4">
                                <label asp-for="Email ">Email</label>
                                <span class="text-danger"></span>
                                <input asp-for="Email " class="form-control form-control-sm" placeholder="Enter Email" />
                                <span asp-validation-for="Email" class="text-danger" />
                            </div>
                        </div>

                        @if (Model.AutoId > 0)
                        {
                            <hr />
                            <div class="form-group row" id="LdateModifyHide">


                                <div class="col-6">
                                    <div class="form-group d-flex align-items-center justify-content-between">
                                        @if (Model.Ldate.HasValue)
                                        {
                                            <label class="d-flex justify-content-end form-label col-form-label-sm" asp-for="Ldate">Creation Date:</label>
                                            <div class="input-wrapper">
                                                <span style="text-align: left; display: block;">@Model.Ldate?.ToString("dd/MM/yyyy hh:mm tt")</span>
                                            </div>
                                        }

                                    </div>
                                </div>


                                <div class="col-6">
                                    <div class="form-group d-flex align-items-center justify-content-between">
                                        @if (Model.ModifyDate.HasValue)
                                        {
                                            <label class="d-flex justify-content-end form-label col-form-label-sm" asp-for="ModifyDate">Last Update Date:</label>
                                            <div class="input-wrapper">
                                                <span style="text-align: left; display: block;">@Model.ModifyDate?.ToString("dd/MM/yyyy hh:mm tt")</span>
                                            </div>
                                        }

                                    </div>
                                </div>

                            </div>
                        }



                        <div class="row no-print" style="margin-top: 9px;">

                            <div class="col-12">
                                <button type="button" class="btn btn-default success-btn btn btn-outline-success btn-common btn-circle float-right js-EmployeeReferenceInfos-save" data-id="@Model.EmpReferenceId">
                                    <i class="fas fa-save"></i> Save
                                </button>
                            </div>
                        </div>

                    </div>
                </div>


            </div>

        </div>
    </div>
    <partial name="_BottomNavigation" />
</div>


<style>

    /*  .required::after {
                    content: '*';
                    color: red;
                    margin-left: 5px;
                } */



    .form-group label {
        margin-right: .5rem;
        min-width: 150px;
    }

    .form-group input {
        flex: 1;
        max-width: 100%; /*150px*/
    }

    .input-wrapper {
        position: relative;
        width: 100%; /* Set wrapper width to 100% */
    }

        .input-wrapper span {
            width: 100%; /* Set input width to 100% */
        }

</style>