@model List<GCTL.Core.ViewModels.EmployeeReferenceInfos.EmployeeReferenceInfosSetupViewModel>

<div class="card">
    <div class="card-body">
        <div class="table-responsive display table table-striped table-bordered">
            <table id="EmployeeReferenceInfos-gridTT" class="table table-striped  table-bordered table-sm table-hover table-common">
                <thead class="row-border">
                    <tr class="table row-border">
                        <th class="text-center text-middle" style="width: 5%;">
                            Select <br /> <input type="checkbox" id="EmployeeReferenceInfos-check-all" />
                        </th>
                        <th class="text-center text-middle" style="width: 6%;">Id</th>
                        <th class="text-center text-middle" style="width: 20%;">Name</th>
                        <th class="text-center text-middle" style="width: 13%;">Organization</th>
                        <th class="text-center text-middle" style="width: 15%;">Address</th>
                        <th class="text-center text-middle" style="width: 10%;">Nationality</th>
                        <th class="text-center text-middle" style="width: 10%;">Designation</th>
                        <th class="text-center text-middle" style="width: 10%;">Relationship</th>
                        <th class="text-center text-middle" style="width: 10%;">Mobile</th>
                    </tr>
                </thead>
                <tbody>

                    @if (Model == null || !Model.Any())
                    {
                        <tr class="text-center text-middle">
                            <td colspan="13">No Data Available.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.OrderByDescending(x => x.EmpReferenceId))
                        {
                            <tr>
                                <td class="text-center">
                                    <input type="checkbox" class="text-center text-middle checkBox" data-id="@item.EmpReferenceId" value="@item.EmpReferenceId" />
                                </td>
                                <td>
                                    <a href="#" class='btn js-EmployeeReferenceInfos-edit'
                                       style="text-decoration: underline; color: rebeccapurple;"
                                       data-id="@item.EmpReferenceId" data-id2="@item.EmployeeId" title="Edit">
                                        @item.EmpReferenceId
                                    </a>
                                </td>
                                <td class="text-left">@item.ReferenceName</td>
                                <td class="text-left">@item.OrganizationName</td>
                                <td class="text-left">@item.RefAddress</td>
                                <td class="text-center text-middle">@item.Nationality</td>
                                <td class="text-center text-middle">@item.DesignationName</td>
                                <td class="text-center text-middle">@item.RelationName</td>
                                <td class="text-center text-middle">@item.MobileNumber</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>