@model GCTL.Core.ViewModels.PaymentTerms.PaymentTermsSetupViewModel


<div style="padding-top: 10px;">
    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>
    <div class="form-group row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" id="lastCode" />
        <input type="hidden" asp-for="Tc" />
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Ldate" />
        <input type="hidden" asp-for="ModifyDate" />
        <div class="col-lg-6">
            <label asp-for="PaymentTermsId">ID </label>
            <div class="input-group input-group-sm">
                <input asp-for="PaymentTermsId" type="text" class="form-control form-control-sm js-PaymentTermsId-code" readonly="readonly" />
            </div>
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="Type">Type<span style="color:red">*</span></label>
            <div class="input-group">
                <select asp-for="Type" class="form-control form-control-sm selectpickers js-Type" tabindex="1" data-placeholder="-- Select Type --" asp-items="@ViewBag.TypeDD as SelectList">
                    <option></option>
                </select>
            </div>
        </div>
        <div class="col-lg-6">
            <label asp-for="Percentise">Percentise<span style="color:red">*</span> </label>
            <input type="number" asp-for="Percentise" class="form-control form-control-sm" autofocus required placeholder="Enter Percentise" tabindex="2" />
        </div>
    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="CreditDays">Credit Days</label>
            <input type="number" asp-for="CreditDays" class="form-control form-control-sm" placeholder="Enter Credit Days" tabindex="3" />
        </div>
        <div class="col-lg-6">
            <label asp-for="PaymentTermsName">Payment Terms Name</label>
            <textarea asp-for="PaymentTermsName" class="form-control form-control-sm" rows="1" readonly placeholder="Enter Paymen Terms Name" tabindex="4"></textarea>
        </div>

    </div>

    @if (Model.Tc > 0)
    {

        <hr />
        <div class="form-group row" id="LdateModifyHide">
            <div class="col-lg-6">
                @if (Model.Ldate.HasValue)
                {
                    <label>Creation Date: </label>

                    <label>@Model.Ldate?.ToString("dd/MM/yyyy")</label>
                }
            </div>
            <div class="col-lg-6">
                @if (Model.ModifyDate.HasValue)
                {
                    <label>Last Update Date: </label>

                    <label>@Model.ModifyDate?.ToString("dd/MM/yyyy")</label>
                }
            </div>
        </div>

    }

</div>
<div class="row no-print" style="margin-top: 9px;">
    <div class="col-12">
        <button type="button" class="btn btn-default success-btn btn btn-outline-success btn-common btn-circle float-right js-PaymentTerms-save" data-id="@Model.PaymentTermsId">
            <i class="fas fa-save"></i> Save
        </button>
    </div>
</div>