@model List<GCTL.Core.ViewModels.PaymentTerms.PaymentTermsSetupViewModel>

<table id="PaymentTerms-grid" class="table table-striped  table-bordered table-sm table-hover table-common">
    <thead class="row-border">
        <tr class="table row-border">
            <th class="text-center text-middle" style="width: 10%;">
                Select <br /> <input type="checkbox" id="PaymentTerms-check-all" />
            </th>
            <th class="text-center text-middle" style="width: 10%;">ID</th>
            <th class="text-center text-middle" style="width: 35%;"> Payment Terms Name</th>
            <th class="text-center text-middle" style="width: 18%;"> Type</th>
            <th class="text-center text-middle" style="width: 13%;"> Percentise</th>
            <th class="text-center text-middle" style="width: 14%;"> Credit Days</th>

        </tr>
    </thead>
    <tbody>

        @if (Model == null || !Model.Any())
        {
            <tr class="text-center text-middle">
                <td colspan="8">No Data Available.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model.OrderByDescending(x => x.Tc))
            {
                <tr>
                    <td class="text-center">
                        <input type="checkbox" class="text-center text-middle checkBox" data-id="@item.Tc" value="@item.PaymentTermsId" />
                    </td>
                    <td>
                        <a href="#" class='btn js-PaymentTerms-edit'
                           style="text-decoration: underline; color: rebeccapurple;"
                           data-id="@item.Tc" title="Edit">
                            @item.PaymentTermsId
                        </a>
                    </td>

                    <td class="text-center text-middle">@item.PaymentTermsName</td>
                    <td class="text-center text-middle">@item.PaymentType</td>
                    <td class="text-center text-middle">@item.Percentise</td>
                    <td class="text-center text-middle">@item.CreditDays</td>

                </tr>
            }
        }

    </tbody>
</table>