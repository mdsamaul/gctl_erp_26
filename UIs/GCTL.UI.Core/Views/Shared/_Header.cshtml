    .site-header-clock-center {
        background-color: #01467c;
        color: white;
        text-align: center;
        padding: 4px 10px;
        border-radius: 6px;
        font-size: 15px;
        font-weight: 500;
        letter-spacing: 0.3px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-left: auto;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
       
        width: fit-content;
        max-width: 100%;
        white-space: nowrap;
        box-sizing: border-box;
        justify-content: center;
        overflow: hidden;
        opacity: 0;
        transform: translateX(60px) scale(0.5);
    }

    @@keyframes clockFadeIn {
        0% {
            opacity: 0;
            transform: translateX(60px) scale(0.5);
        }

        100% {
            opacity: 1;
            transform: translateX(0) scale(1);
        }
    }

    .site-header-clock-center.show {
        animation: clockFadeIn 0.6s ease forwards;
    }

  

        .site-header-clock-center .header-date {
            font-size: 15px;
            font-weight: 500;
            color: white;
            white-space: nowrap;
            font-family: inherit;
            letter-spacing: 0.3px;
        }

        .site-header-clock-center .header-time {
            font-size: 15px;
            font-weight: 500;
            color: white;
            white-space: nowrap;
            display: inline;
            margin-top: 0;
            font-family: inherit;
            letter-spacing: 0.3px;
            font-variant-numeric: tabular-nums;
        }


    /* Loading pulse animation for placeholder state */
    @@keyframes clockPulse {
        0%, 100% {
            opacity: 0.4;
        }

        50% {
            opacity: 0.9;
        }
    }

    .site-header-clock-center.loading .header-date,
    .site-header-clock-center.loading .header-time {
        animation: clockPulse 1s ease-in-out infinite;
    }

    /* Smooth fade-in when value updates */
    .site-header-clock-center .header-date,
    .site-header-clock-center .header-time {
        transition: opacity 0.3s ease;
    }
    /* When on dashboard page (we add .dashboard-page to body), hide the center clock */
    body.dashboard-page .site-header-clock-center {
        display: none !important;
    }

    /* Ensure center clock doesn't grow header height too much */
    .main-header.navbar { align-items: center; }

    /* Fixed top header navbar */
    .main-header {
        position: fixed !important;
        top: 0;
        right: 0;
        left: 0;
        z-index: 1035 !important;
    }
</style>

