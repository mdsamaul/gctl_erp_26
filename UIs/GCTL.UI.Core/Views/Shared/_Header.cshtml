<style>
    .navbar-dark .navbar-nav .nav-link {
        color: #fff !important;
    }

    /* Search Input */
    .form-control-navbar {
        background: #ffffff !important;
        border: 1.5px solid #ced4da !important;
        border-right: none !important;
        color: #fff !important;
        border-radius: 8px 0 0 8px !important;
        height: 34px !important;
        box-shadow: none !important;
        outline: none !important;
    }

        .form-control-navbar::placeholder {
            color: #fff !important;
            font-size: 13px;
        }

        .form-control-navbar:focus {
            background: #FFFFFF !important;
            color: #212529 !important;
            border: 1.5px solid #adb5bd !important;
            border-right: none !important;
            box-shadow: none !important;
            outline: none !important;
        }

    /* Search Button - focus sync */
    .btn-navbar {
        background: #EAF2FF !important;
        border: 1.5px solid #ced4da !important;
        border-left: none !important;
        color: #212529 !important;
        border-radius: 0 8px 8px 0 !important;
        width: 40px !important;
        height: 34px !important;
        padding: 0 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        transition: border-color 0.3s ease;
        box-shadow: none !important;
    }

        .btn-navbar:hover {
            transform: scale(1.05);
            background: #EAF2FF !important;
        }
    /* Logout Button */
    .logout-btn {
        background: #ffffff !important;
        color: #212529 !important;
        border: 1.5px solid #ced4da !important;
        border-radius: 8px !important;
        padding: 3px 11px !important;
        margin-top: 2px;
        display: inline-block;
        transition: all 0.3s ease;
        animation: grayBorder 4s linear infinite;
    }

        .logout-btn i {
            color: #212529 !important;
        }

        .logout-btn:hover {
            background: #ffffff !important;
            transform: scale(1.05);
        }

    /* Gray Border Animation - logout only */
    @@keyframes grayBorder {
        0% {
            border-color: #ced4da;
            box-shadow: 0 0 4px #ced4da;
        }

        25% {
            border-color: #adb5bd;
            box-shadow: 0 0 4px #adb5bd;
        }

        50% {
            border-color: #dee2e6;
            box-shadow: 0 0 4px #dee2e6;
        }

        75% {
            border-color: #b8bfc7;
            box-shadow: 0 0 4px #b8bfc7;
        }

        100% {
            border-color: #ced4da;
            box-shadow: 0 0 4px #ced4da;
        }
    }

