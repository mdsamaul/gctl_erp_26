    <script>
        // Global header clock - works on all pages
        (function () {
        function pad(n) { return n < 10 ? '0' + n : n; }
      

        var days = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
        var months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

        function formatDate(d) {
        return days[d.getDay()] + ', ' + months[d.getMonth()] + ' ' + d.getDate() + ', ' + d.getFullYear() + ',';
        }

        function formatTime(d) {
        var h = d.getHours();
        var ampm = h >= 12 ? 'PM' : 'AM';
        var hh = h % 12;
        hh = hh ? hh : 12;
        return pad(hh) + ':' + pad(d.getMinutes()) + ':' + pad(d.getSeconds()) + ' ' + ampm;
        }


        function updateHeaderClock() {
        var now = new Date();
        var dEl = document.getElementById('headerDate');
        var tEl = document.getElementById('headerTime');
        if (dEl) dEl.textContent = formatDate(now);
        if (tEl) tEl.textContent = formatTime(now);

        var container = document.querySelector('.site-header-clock-center');
        if (container) container.classList.remove('loading');
        }

        


        updateHeaderClock();
        setInterval(updateHeaderClock, 500);

        setTimeout(function () {
        var container = document.getElementById('headerClockBox');
        if (container) container.classList.add('show');
        }, 100);
        })();

    </script>
