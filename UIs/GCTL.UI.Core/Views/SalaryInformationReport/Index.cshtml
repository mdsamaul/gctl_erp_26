@model GCTL.UI.Core.ViewModels.SalaryInformationReport.SalaryInformationReportViewModel
@{
    Model.Breadcrumb = "SalaryInformationReport";
    Model.PageTitle = "Salary Information Report";
}
<style>
    .headerToobar {
        background: linear-gradient(to right, #fff, #fff);
        box-shadow: 3px 0 6px rgba(0,0,0,0.2);
        border-radius: 0px 11px 11px 0px;
    }

    #btnPreviewPdf, #btnExportReport {
        transition: background-color .3s, color .3s, border-color .3s;
        min-width: 120px;
    }

        #btnPreviewPdf:hover, #btnExportReport:hover {
            background-color: rgba(173,255,47,.2) !important;
            color: #1e90ff !important;
            border-color: #1e90ff !important;
            box-shadow: 0 4px 10px rgba(30,144,255,.5) !important;
        }

            #btnPreviewPdf:hover i, #btnExportReport:hover i {
                transform: scale(1.3);
            }

        #btnPreviewPdf i, #btnPreviewPdf span,
        #btnExportReport i, #btnExportReport span {
            transition: transform .3s;
            display: inline-block;
        }

    .dropdown-wrapper .btn-group {
        width: 100% !important;
        display: block !important;
    }

    .dropdown-wrapper .multiselect {
        width: 100% !important;
        border: 1px solid #ced4da !important;
        border-radius: 4px !important;
        background: #fff !important;
        padding: 6px 8px !important;
        font-size: 13px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        cursor: pointer !important;
    }

    .multiselect-container.dropdown-menu {
        border-radius: 4px !important;
        box-shadow: 0 4px 12px rgba(0,0,0,.15);
        font-size: 13px;
        margin-top: 1px !important;
        max-height: 250px !important;
        overflow-y: auto !important;
        width: 100% !important;
    }

    .form-check-inline {
        margin-right: 15px;
    }

    
    #pdf-preview-container {
        border: 1px solid #ccc;
        padding: 5px;
        background: #fff;
    }
</style>

<!-- Page Header -->
<div class="container-fluid">
    <partial name="_PageHeader" model="Model" />
</div>

<input type="hidden" id="hdnAccessCode" value="@(ViewBag.AccessCode ?? "")" />

<section class="">
    <div class="card border mx-2">
        <!-- Toolbar -->
        <div class="card-header">
            <partial name="_Toolbars"
                     model="new ToobarModel() { Title = Model.Breadcrumb, Code = Model.Code, Name = Model.Filter.CompanyCode }" />
        </div>

        <!-- Filter Panel -->
        <div class="card-body border">
            <div class="">
                <!-- Search By Section -->
                <div class="col-12 col-md-5">
                    <h6 class="pt-3 px-3 pb-0 font-weight-bold fs-6 mb-0">Search By:</h6>
                    <div class="d-flex"><hr class="m-0 p-0 w-100"></div>
                </div>

                <div class="col-12 col-md-11 mx-auto dropdown-wrapper">
                    <div class="row pb-2">

                        <!-- Company -->
                        <div class="col-12 col-md-6 py-1">
                            <div class="row align-items-center">
                                <label class="col-3 text-right mb-0" style="padding-right:0;">Company</label>
                                <div class="col-9 col-md-7" style="padding-left:5px;">
                                    <select id="companySelect" class="form-control form-control-sm gc-multiselect-load-data">
                                        @* <option value="">--Select Company--</option> *@
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Branch -->
                        <div class="col-12 col-md-6 py-1">
                            <div class="row align-items-center">
                                <label class="col-3 text-right mb-0" style="padding-right:0;">Branch</label>
                                <div class="col-9 col-md-7" style="padding-left:5px;">
                                    <select id="branchSelect" class="form-control form-control-sm gc-multiselect-load-data" multiple>
                                        @* <option value="">--Select Branch--</option> *@
                                    </select>
                                </div>
                                <div class="col-md-2 col-0"></div>
                            </div>
                        </div>

                        <!-- Department -->
                        <div class="col-12 col-md-6 py-1">
                            <div class="row align-items-center">
                                <label class="col-3 text-right mb-0" style="padding-right:0;">Department</label>
                                <div class="col-9 col-md-7" style="padding-left:5px;">
                                    <select id="departmentSelect" class="form-control form-control-sm gc-multiselect-load-data" multiple>
                                        @* <option value="">--Select Department--</option> *@
                                    </select>
                                </div>
                                <div class="col-md-2 col-0"></div>
                            </div>
                        </div>

                        <!-- Employee ID -->
                        <div class="col-12 col-md-6 py-1">
                            <div class="row align-items-center">
                                <label class="col-3 text-right mb-0" style="padding-right:0;">Employee ID</label>
                                <div class="col-9 col-md-7" style="padding-left:5px;">
                                    <select id="employeeSelect" class="form-control form-control-sm gc-multiselect-load-data" multiple>
                                        @* <option value="">--Select Employee --</option> *@
                                    </select>
                                </div>
                                <div class="col-md-2 col-0"></div>
                            </div>
                        </div>

                        <!-- Employment Nature -->
                        <div class="col-12 col-md-6 py-1">
                            <div class="row align-items-center">
                                <label class="col-3 text-right mb-0" style="padding-right:0;">Employment Nature</label>
                                <div class="col-9 col-md-7 dropdown-wrapper" style="padding-left:5px;">
                                    <select id="employmentNatureSelect" class="form-control form-control-sm gc-multiselect" multiple data-placeholder="Select Employment Nature" asp-items="ViewBag.EmploymentNatureList as SelectList">
                                        @* <option value=""></option> *@
                                    </select>
                                </div>
                                <div class="col-md-2 col-0"></div>
                            </div>
                        </div>

                        <!-- Empty for alignment -->
                        <div class="col-12 col-md-6 py-1"></div>

                        <!-- Duration Selected -->
                        <div class="col-12 col-md-6 py-1">
                            <div class="row align-items-center">
                                <label class="col-3 text-right mb-0" style="padding-right:0;">Duration Selected</label>
                                <div class="col-9 col-md-7" style="padding-left:5px;">
                                    <div class="d-flex align-items-center">
                                        <div class="form-check form-check-inline mb-0">
                                            <input class="form-check-input" type="radio" name="salaryGenerate" id="byDate" value="ByDate" checked>
                                            <label class="form-check-label" for="byDate">By Date</label>
                                        </div>
                                        <div class="form-check form-check-inline mb-0">
                                            <input class="form-check-input" type="radio" name="salaryGenerate" id="byMonth" value="ByMonth">
                                            <label class="form-check-label" for="byMonth">By Month</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-2 col-0"></div>
                            </div>
                        </div>

                        <!-- Empty for alignment -->
                        <div class="col-12 col-md-6 py-1"></div>

                        <!-- Date From -->
                        <div class="col-12 col-md-6 py-1">
                            <div class="row align-items-center">
                                <label class="col-3 text-right mb-0" style="padding-right:0;">Date From</label>
                                <div class="col-9 col-md-7" style="padding-left:5px;">
                                    <input type="text" id="dateFrom" class="form-control form-control-sm" value="27/07/2026" />
                                </div>
                                <div class="col-md-2 col-0"></div>
                            </div>
                        </div>

                        <!-- To -->
                        <div class="col-12 col-md-6 py-1">
                            <div class="row align-items-center">
                                <label class="col-3 text-right mb-0" style="padding-right:0;">To</label>
                                <div class="col-9 col-md-7" style="padding-left:5px;">
                                    <input type="text" id="dateTo" class="form-control form-control-sm" value="27/07/2026" />
                                </div>
                                <div class="col-md-2 col-0"></div>
                            </div>
                        </div>

                        <!-- Month -->
                        <div class="col-12 col-md-6 py-1">
                            <div class="row align-items-center">
                                <label class="col-3 text-right mb-0" style="padding-right:0;">Month</label>
                                <div class="col-9 col-md-7" style="padding-left:5px;">
                                    <select id="monthSelect" class="form-control form-control-sm" data-placeholder="Select Month" asp-items="ViewBag.MonthList as SelectList">
                                        <option value="">Select Month</option>
                                    </select>
                                </div>
                                <div class="col-md-2 col-0"></div>
                            </div>
                        </div>

                        <!-- Year -->
                        <div class="col-12 col-md-6 py-1">
                            <div class="row align-items-center">
                                <label class="col-3 text-right mb-0" style="padding-right:0;">Year</label>
                                <div class="col-9 col-md-7" style="padding-left:5px;">
                                    <input type="text" id="yearSelect" class="form-control form-control-sm" value="2026" style="background-color:#e9ecef;" />
                                </div>
                                <div class="col-md-2 col-0"></div>
                            </div>
                        </div>

                        <!-- Mode of Payment -->
                        <div class="col-12 col-md-6 py-1">
                            <div class="row align-items-center">
                                <label class="col-3 text-right mb-0" style="padding-right:0;">Mode of Payment</label>
                                <div class="col-9 col-md-7 dropdown-wrapper" style="padding-left:5px;">
                                    <select id="modeOfPaymentSelect" multiple class="form-control form-control-sm gc-multiselect" asp-items="ViewBag.mopRepoList as SelectList">
                                        @* <option value="">--Select Mode of Payment--</option> *@
                                    </select>
                                </div>
                                <div class="col-md-2 col-0"></div>
                            </div>
                        </div>

                        <!-- Master File Type -->
                        <div class="col-12 col-md-6 py-1">
                            <div class="row align-items-center">
                                <label class="col-3 text-right mb-0" style="padding-right:0;">Master File Type</label>
                                <div class="col-9 col-md-7 gc-inline-select2"  style="padding-left:5px;">
                                    <select id="masterFileTypeSelect" class="form-control form-control-sm gc-select2" asp-items="ViewBag.masterRepoList as SelectList">
                                        <option value="">--Select Master File Type--</option>
                                    </select>
                                </div>
                                <div class="col-md-2 col-0"></div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- Report Option Section -->
                <div class="col-12 col-md-5">
                    <h6 class="pt-3 px-3 pb-0 font-weight-bold fs-6 mb-0">Report Option:</h6>
                    <div class="d-flex"><hr class="m-0 p-0 w-100"></div>
                </div>

                <div class="col-12 col-md-11 mx-auto dropdown-wrapper">
                    <div class="row pb-2">
                        <!-- Export Format Type -->
                        <div class="col-12 col-md-6 py-1">
                            <div class="row align-items-center">
                                <label class="col-3 text-right mb-0" style="padding-right:0;">Export Format Type</label>
                                <div class="col-9 col-md-7" style="padding-left:5px;">
                                    <select id="exportFormatSelect" class="form-control form-control-sm">
                                        <option value="Excel" selected>Excel</option>
                                        <option value="PDF">PDF</option>
                                        @* <option value="CSV">CSV</option> *@
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Export Button -->
                        
                        <div class="col-12 col-md-6 py-1">
                            <div class="row justify-content-end align-items-center px-0 mx-0">
                                <div class="pr-1">
                                    <button id="btnExportReport"
                                            class="btn btn-sm common-btn btn-outline-secondary">
                                        <i class="fas fa-file-export"></i>
                                        <span>Export Report</span>
                                    </button>
                                </div>
                                <div class="pl-1">
                                    <button id="btnPreviewPdf"
                                            class="btn btn-sm btn-outline-secondary common-btn px-4">
                                        <i class="fas fa-eye" title="Preview"></i>
                                        <span>Preview</span>
                                    </button>
                                </div>
                                <div class="col-md-2"></div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- PDF Preview Container -->
        <div class="container-fluid mt-3">
            <div id="pdf-preview-container"
                 style="width:100%; height:100vh; border:1px solid #ccc;
                display:none; border-radius:5px;
                box-shadow:0 2px 10px rgba(0,0,0,.1);">
            </div>
        </div>
    </div>
</section>


<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-multiselect/1.1.2/css/bootstrap-multiselect.min.css">
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-multiselect/1.1.2/js/bootstrap-multiselect.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <script src="~/js/pages/salaryinformationreport.js"></script>
    <script type="text/javascript">
        $(function () {
        $.salaryInformationReport({
        baseUrl: '@Url.Action("Index", "SalaryInformationReport")',
        load: async function () {

        bindRemoteMultiselect("#companySelect", "/GcAccessFilter/companies", "Select Company", "company");
        bindRemoteMultiselect("#branchSelect", "/GcAccessFilter/branches", "Select Branch", "branch");
        bindRemoteMultiselect("#departmentSelect", "/GcAccessFilter/departments", "Select Department", "department");
        bindRemoteMultiselect("#employeeSelect", "/GcAccessFilter/employees", "Select Employee", null);

        var accessCode = $("#hdnAccessCode").val();
        var isReadonly = accessCode === "0005";

        ms_BindCascade();

        if (isReadonly) {
        ms_InitializeMultiselects(null, null, true);
        await ms_ApplyAccessCodeToAll(accessCode);
        } else {
        ms_InitializeMultiselects();
        ms_Reset("#companySelect");
        await ms_LoadNext("#companySelect", "...");
        await ms_AutoSelectCompany("001");
        }
        }
        });
        });
    </script>
}

