@model ToobarModel
<div class="row">
    <div class="col-md-10">
        <h6 class="page-title">@Model.Title</h6>
    </div>
    <div class="col-md-2 d-flex justify-content-end">
        <div class="btn-group" role="group" aria-label="Toolbar Actions">
            <button type="button" class="btn btn-default btn-common js-EmployeeContactInfos-save btn-circle">
                <i class="fas fa-save"></i> Save
            </button>
            <button type="button" class="btn btn-default primary-btn js-EmployeeContactInfos-clear btn-circle btn-sm">
                <i class="fas fa-sync"></i> Clear
            </button>
        </div>
    </div>
</div>