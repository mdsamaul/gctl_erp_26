<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header border-transparent">
                        <h3 class="card-title">@ViewBag.Title</h3>
                    </div>
                    <!-- /.card-header -->
                    <div class="card-body p-2 pt-3">

                        <div class="js-EmployeeContactInfos-grid-container">

                            @await Html.PartialAsync("_Grid", Model.ListTableData)

                        </div>

                    </div>
                </div>
            </div>
        </div>
        <partial name="_BottomNavigation" />
    </div>
</section>
<partial name="DeleteModal" />

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/pages/employeeContactInfos.js"></script>
    <script type="text/javascript">
        var options = {
            baseUrl: '@Url.Action("", "EmployeeContactInfos")'
        };
        options.load = () => {
        };

        $.employeeContactInfos(options);
    </script>
}