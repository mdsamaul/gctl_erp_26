@using System.Globalization
@model List<GCTL.Core.ViewModels.ExcessTDSForLastIncomeYear.ExcessTDSForLastIncomeYearSetupViewModel>

<div class="card">
    <div class="card-body">
        <table id="ExcessTDSForLastIncomeYear-grid" class="table table-striped  table-bordered table-sm table-hover table-common">
            <thead class="row-border">
                <tr class="table row-border">
                    <th class="text-center text-middle" style="width: 4%;">
                        Select <br /> <input type="checkbox" id="ExcessTDSForLastIncomeYear-check-all" />
                    </th>
                    <th class="text-center text-middle" style="width: 7%;"> ID</th>
                    <th class="text-center text-middle" style="width: 8%;"> Employee Id</th>
                    <th class="text-center text-middle" style="width: 19%;"> Name</th>
                    <th class="text-center text-middle" style="width: 17%;">Designation</th>
                    <th class="text-center text-middle" style="width: 10%;">Financial Year</th>
                    <th class="text-center text-middle" style="width: 9%;">TDS Amount</th>
                    <th class="text-center text-middle" style="width: 7%;">Effective Date</th>
                    <th class="text-center text-middle" style="width: 7%;">Is Full Adj. In Effective Month</th>
                    <th class="text-center text-middle" style="width: 12%;">Remarks</th>
                </tr>
            </thead>
            <tbody id="ExcessTDSForLastIncomeYearGridBody">
                @if (Model == null || !Model.Any())
                {
                    <tr class="text-center text-middle"> <td colspan="10">No Data Available.</td></tr>
                }
                else
                {
                    @foreach (var item in Model.OrderByDescending(x => x.Etdsliyid))
                    {
                        <tr>
                            <td class="text-center">
                                <input type="checkbox" class="text-center text-middle checkBox" data-id="@item.Etdsliyid" value="@item.Etdsliyid" />
                            </td>
                            <td>
                                <a href="#" class='btn js-ExcessTDSForLastIncomeYear-edit'
                                   style="text-decoration: underline; color: rebeccapurple;"
                                   data-id="@item.Etdsliyid" title="Edit">
                                    @item.Etdsliyid
                                </a>
                            </td>
                            <td class="text-center text-middle">@item.EmployeeId</td>
                            <td class="text-left text-middle">@item.EmployeeName</td>
                            <td class="text-left text-middle">@item.DesignationName</td>
                            <td class="text-center text-middle">@item.Name</td>
                            <td class="text-center align-middle">@(item.Tdsamount != 0m ? item.Tdsamount.ToString("0.##") : "")</td>
                            <td class="text-center align-middle">@(item.EffectiveDate?.ToString("dd/MM/yyyy") ?? "")</td>
                            <td class="text-center align-middle">@(item.IsfullAmountAdjust)</td>
                            <td class="text-center align-middle">@(item.Remark)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>