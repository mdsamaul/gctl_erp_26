@model ToobarModel
<div class="row">
    <div class="col-md-5">
        <h6 class="page-title">@Model.Title</h6>
    </div>
    <div class="col-md-7">
        <div class="btn-toolbar d-flex justify-content-end">
            <div class="btn-group">
                <button type="button" class="btn btn-default success-btn js-officialInfo-save btn-circle float-right" data-toggle="tooltip" data-placement="bottom" title="Save">
                    <i class="fas fa-save"></i>
                    @if (ViewBag.IsEditMode != null && (bool)ViewBag.IsEditMode)
                    {
                        <text>Update</text>
                    }
                    else
                    {
                        <text>Save</text>
                    }
                </button>

                <button type="button" class="btn btn-default primary-btn js-officialInfo-clear" data-toggle="tooltip" data-placement="bottom" title="Clear">
                    <i class="fas fa-sync">&nbsp;</i>
                    Clear
                </button>
            </div>
        </div>
    </div>
</div>