@model List<GCTL.Core.ViewModels.SalesDefBankBranchInfos.SalesDefBankBranchInfoSetupViewModel>

<table id="BankBranchInformations-grid" class="table table-striped  table-bordered table-sm table-hover table-common">

        <thead class="row-border">
            <tr class="table row-border">
                <th class="text-center text-middle">
                    Select <br /> <input type="checkbox" id="BankBranchInformations-check-all" />
                </th>
                <th class="text-center text-middle">Id</th>
                <th class="text-center text-middle">Bank Name</th>
                <th class="text-center text-middle"> Branch</th>
                <th class="text-center text-middle">Short Name</th>
                <th class="text-center text-middle">Swift Code</th>
                <th class="text-center text-middle">Address</th>
                <th class="text-center text-middle">Phone</th>
            </tr>
        </thead>
        <tbody>

            @if (Model == null || !Model.Any())
            {
                <tr class="text-center text-middle">
                    <td colspan="8">No   Bnak Branch Information Available.</td>
                </tr>
            }
            else
            {
                @foreach (var item in Model.OrderByDescending(x => x.BankBranchId))
                {
                    <tr>
                        <td class="text-center">
                            <input type="checkbox" class="text-center text-middle checkBox" data-id="@item.BankBranchId" value="@item.BankBranchId" />
                        </td>
                        <td>
                            <a href="#" class='btn js-BankBranchInformations-edit'
                               style="text-decoration: underline; color: rebeccapurple;"
                               data-id="@item.BankBranchId" title="Edit">
                                @item.BankBranchId
                            </a>
                        </td>
                        <td class="text-center text-middle">@item.BankName</td>
                        <td class="text-center text-middle">@item.BankBranchName</td>
                        <td class="text-center text-middle">@item.ShortName</td>
                        <td class="text-center text-middle">@item.Swiftcode</td>
                        <td class="text-center text-middle">@item.Address</td>
                        <td class="text-center text-middle">@item.Phone</td>

                    </tr>
                }
            }


        </tbody>
    </table>