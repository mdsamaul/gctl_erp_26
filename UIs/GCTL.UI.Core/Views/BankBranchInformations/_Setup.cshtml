@model GCTL.Core.ViewModels.SalesDefBankBranchInfos.SalesDefBankBranchInfoSetupViewModel

<div style="padding-top: 10px;padding-left:15px;">
    <div class="row">
        <div class="col-lg-6">
            <span id="message"></span>
        </div>
        <div class="col-lg-6">
        </div>
    </div>
    <div class="form-group row">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" id="lastCode" />
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Ldate" />
        <input type="hidden" asp-for="ModifyDate" />
        <input type="hidden" id="BankBranchAutoId" asp-for="AutoId" />

    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="BankBranchId">Branch ID </label>
            <input asp-for="BankBranchId" id="BankBranchMasterId" type="text" class="form-control form-control-sm js-BankBranchId-code" readonly="readonly" />
        </div>
        <div class="col-lg-6">
        
            <label asp-for="BankId">Bank Name<span style="color:red">*</span></label>
            <div class="input-group">
                <select asp-for="BankId " class="form-control form-control-sm selectpickerBankDD js-" id="BankIdDropDown" data-placeholder="--Select Bank--" required asp-items="@ViewBag.BankDD as SelectList">
                    <option></option>
                </select>
                
            </div>

        </div>
    </div>
 

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="BankBranchName"> Branch Name  <span style="color:red;">*</span></label>

            <input type="text" placeholder="Enter Branch Name " required asp-for="BankBranchName"  class="form-control form-control-sm "  tabindex="2" />

        </div>

        <div class="col-lg-6">
            <label asp-for="ShortName">Short Name </label>

            <input type="text" class="form-control form-control-sm" placeholder="Enter  Short Name" asp-for="ShortName" tabindex="3" />

            <span asp-validation-for="ShortName" class="text-danger"></span>

        </div>

    </div>


    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="Address"> Branch Address </label>

            <input type="text" placeholder="Enter Branch Address " asp-for="Address"  class="form-control form-control-sm "   tabindex="4" />

        </div>

        <div class="col-lg-6">
            <label asp-for="Swiftcode">Swift Code </label>

            <input type="text" class="form-control form-control-sm" placeholder="Enter  SWIFT Code" asp-for="Swiftcode" tabindex="5" />

            <span asp-validation-for="Swiftcode" class="text-danger"></span>

        </div>

    </div>

    <div class="form-group row">
        <div class="col-lg-6">
            <label asp-for="Phone"> Phone </label>

            <input type="text" placeholder="Enter Phone Number " asp-for="Phone"  class="form-control form-control-sm " tabindex="6" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <div class="col-lg-6">
            
        </div>

    </div>

    @if (Model.AutoId > 0)
    {
        <hr />

        <div class="form-group row" id="LdateModifyHide">

            <div class="col-lg-6">
                @if (Model.Ldate.HasValue)
                {
                    <label>Creation Date: </label>

                    <label>@Model.Ldate?.ToString("dd/MM/yyyy")</label>
                }
            </div>
            <div class="col-lg-6">
                @if (Model.ModifyDate.HasValue)
                {
                    <label>Last Update Date: </label>

                    <label>@Model.ModifyDate?.ToString("dd/MM/yyyy")</label>
                }
            </div>
        </div>
    }

</div>
<div class="row no-print" style="margin-top: 9px;">
    <div class="col-12">
        <button type="button" class="btn btn-default success-btn btn btn-outline-success btn-common btn-circle float-right js-BankBranchInformations-save" data-id="@Model.BankBranchId">
            <i class="fas fa-save"></i> Save
        </button>
    </div>
</div>

