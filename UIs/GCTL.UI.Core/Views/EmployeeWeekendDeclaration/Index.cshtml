@model GCTL.UI.Core.ViewModels.HRM_EmployeeWeekendDeclaration.HRM_EmployeeWeekendDeclarationViewModel
@{
    Model.Breadcrumb = "EmployeeWeekendDeclaration";
    Model.PageTitle = "Employee Weekend Declaration";
}
<style>
    .card-header {
        min-height: 50px; 
    }

    .sticky-scrolled {
        
        transition: background-color 0.3s ease-in-out;
        opacity: 95%;
    }

  
    .page-item.active .page-link {
        z-index: 3 !important;
        color: #000000 !important;
        background-color: #ffffff !important;
        border-color: #007bff !important;
    }

    #employee-weekend-grid_filter, #employee-weekend-grid-show_filter {
        margin:0px !important;
    }

    .dropdown-wrapper .col-auto{
        margin-bottom:0px!important;
    }
</style>
<!-- Content Header (Page header) -->
<div class="container-fluid">
    <partial name="_PageHeader" model="Model"></partial>
</div>
<section class="content consistent-look">
    <div class="container-fluid">
        <div class="row px-2 pr-3">
            <!-- Left Side: Form -->
            <div class="col-md-12 pr-0">
                <div class="card">
                  @*   <div class="card-header px-2" style="min-height: 50px;">
                        <partial name="_Toolbars" model="new ToobarModel() { Title = Model.Breadcrumb, Code = Model.Code, Name = Model.Setup.EWDId }"></partial>
                    </div> *@
                    <div id="stickyHeader" class="card-header px-4 sticky-top" style="min-height: 50px; z-index: 1020;">
                        <partial name="_Toolbars" model="new ToobarModel() { Title = Model.Breadcrumb, Code = Model.Code, Name = Model.Setup.EWDId }"></partial>
                    </div>
                   <div id="massageSeccess" class="alert-default-light " style="display: none; color: green; font-weight: bold; padding-left:20px; display: inline-block;">                       
                    </div>
                    <div id="massageError" class="alert-default-light " style="display: none; color: red; font-weight: bold; padding-left:20px; display: inline-block;">                       
                    </div>
                    <div id="massageUpdate" class="alert-default-light  " style="display: none; color: blue; font-weight: bold; padding-left:20px; display: inline-block;">                       
                    </div>

                    <div class="card-body px-2" style="padding-top:0px;">
                        <div class="container-fluid py-2" style="padding-top:0px;">
                            <div>
                                <h5 class ="px-3">Filter By:</h5>
                            </div>   
                                <div class="main-container">
                                    @* <div class="row dropdown-wrapper d-flex justify-content-start align-items-end"> *@
                                    <div class="dropdown-wrapper d-flex justify-content-start align-items-end">
                                        <div class="col-auto">
                                            <div class="form-group">
                                                <label for="companySelect">Company</label>
                                                <select id="companySelect"   class="form-control form-control-sm gc-multiselect" multiple="multiple">   
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-auto">
                                            <div class="form-group">
                                                <label for="branchSelect">Branch</label>
                                                <select id="branchSelect" class="form-control form-control-sm gc-multiselect" data-placeholder="Select Branch" multiple="multiple">
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-auto">
                                            <div class="form-group">
                                                <label for="divisionSelect">Division</label>
                                            <select id="divisionSelect" class="form-control form-control-sm gc-multiselect" multiple="multiple" data-placeholder="Select Division">
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-auto">
                                            <div class="form-group">
                                                <label for="departmentSelect">Department</label>
                                            <select id="departmentSelect" class="form-control form-control-sm gc-multiselect" multiple="multiple" data-placeholder="Select Department">
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-auto">
                                            <div class="form-group">
                                                <label for="designationSelect">Designation</label>
                                            <select id="designationSelect" class="form-control form-control-sm gc-multiselect" multiple="multiple" data-placeholder="Select Designation">
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-auto">
                                            <div class="form-group">
                                                <label for="employeeSelect">Employee</label>
                                            <select id="employeeSelect" class="form-control form-control-sm gc-multiselect" multiple="multiple" data-placeholder="Select Employee">
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-auto">
                                            <div class="form-group">
                                                <label for="activityStatusSelect">Activity Status</label>
                                                <select id="activityStatusSelect" class="regular-select">
                                                    <option value="02">Inactive</option>
                                                    <option value="01">Active</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                



                            <!-- table: Grid -->
                            <div class="col-md-12 mt-2 px-0">
                                <partial name="_Grid" />
                            </div>
                            <div>
                                <partial name="_DatePeaker"></partial>
                            </div>
                            <div>
                                <partial name="_ExcelFileUploaded"></partial>
                            </div>
                            <div>
                                <partial name="_EmployeeWeekendDeclaration"></partial>
                            </div>
                        </div>
                    </div>
                   
                </div>
            </div>          
           
        </div>
    </div>
</section>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">


<!-- Optional: Theme -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/material_blue.css">

<!-- Bootstrap (Optional, for layout) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">

@section Scripts {
    <!-- Bootstrap JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/4.6.2/js/bootstrap.bundle.min.js"></script>
    <!-- Bootstrap Multiselect CSS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-multiselect/1.1.2/css/bootstrap-multiselect.min.css">
    <!-- Bootstrap Multiselect JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-multiselect/1.1.2/js/bootstrap-multiselect.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="~/js/pages/hrm_employeeweekenddeclaration.js"></script>
   
}


